
# compatibility with browsers not supporting turbolinks:load
if not Turbolinks.supported
  $(document).ready ->
    ready()

$(document).on 'turbolinks:load', ->
  ready()

ready = () ->
  if $('.algolia_students').length      
    $('.students_toolbar').on 'click', '.sendcodetoall', (e) ->
      if $('input.scb:checked').size() == 0
        alert 'Selectionnez au moins un élève'
        e.preventDefault()
        return
      else
        $.ajax('/messages/sendcode',
          {
            type: 'post',
            data: decodeURI($('input.scb:checked').serialize()),
            success: () ->
              console.log 'request sent'
          })
        e.preventDefault()
        return
      return
    $('.algolia_students').on 'click', '#all_students', (e) ->
      $('.algolia_students #toggle_all, .hits .scb').prop('checked', false)
      $('.div-row').removeClass('active')
      $('#selected').text('0')

    $('.hits').on 'click', '.div-row', (e) ->
      if $(e.target).is('.sendcode')
        e.preventDefault()
        $.ajax('/messages/sendcode',
          {
            type: 'post',
            data: {'student[id][]': $(this).data('student-id')},
            success: () ->
              console.log 'request sent'
          })
        return
      if $(e.target).is('.toggle-row')
        $('#all_students').prop('checked', false)
        divRow = $(e.target).closest('.div-row')
        toggleSelectedRow(divRow)
        updateSelectedRowsCounter()
        return
      if $(e.target).is('div.div-column')
        e.preventDefault()
        Turbolinks.visit('/students/' + $(this).data('student-id') + '/edit')
        return
      if $(e.target).is('.dd-toggle')
        e.preventDefault()
        ul = $(this).find('.dropdown-menu')
        if $(ul).find('li').length == 0
          student_id = $(this).data('student-id')
          ul.append('<li>' + linkAction('edit', student_id) + '</li>')
          ul.append('<li>' + linkAction('code', student_id) + '</li>')
          ul.append('<li role="separator" class="divider"></li>')
          ul.append('<li>' + linkAction('delete', student_id) + '</li>')
          return
      return true

    $('#delete_all').click (e) ->
      e.preventDefault()
      if $('input.scb:checked').size() == 0
        alert 'Selectionnez au moins un élève'
      else
        if confirm 'Etes vous sûr?'
          $.ajax('/students/destroy_all',
            {
              type: 'delete',
              data: decodeURI($('input.scb:checked').serialize()),
              success: () ->
                console.log 'request sent'
            })

    linkAction = (action, student_id) ->
      switch action
        when 'edit'
          return '<a data-disable-with="Edition..." href="/students/' + student_id + '/edit"><i class="glyphicon glyphicon-pencil"></i>Editer</a>'
        when 'code'
          return '<a data-student_id="' + student_id + '" data-disable-with="Création du message..." href="/messages/sendcode" class="sendcode"><i class="fa fa-id-badge" aria-hidden="true"></i>Envoyer le code</a>'
        when 'delete'
          return '<a data-confirmbootbox="Etes vous sûr?"  data-disable-with="Suppression..." href="/students/' + student_id + '" data-method="delete"><i class="glyphicon glyphicon-trash"></i>Supprimer</a>'


    if $('.algolia_students').length
      $('.algolia').on 'keydown', 'input.ais-search-box--input', (event) ->
        $('#hits').show()
        $('#first_students').hide()

      $('.algolia').on 'click', '.ais-pagination--item', (event) ->
        $('#hits').show()
        $('#first_students').hide()

      $('.algolia').on 'click', '.ais-RefinementList--checkbox', (event) ->
        $('#hits').show()
        $('#first_students').hide()

      if window.location.search != ''
        $('#hits').show()
        $('#first_students').hide()

      search = instantsearch(
        appId: '<%= Rails.application.secrets.algolia_app_id %>'
        apiKey: $('#algolia_search_api_key').val() #'<%= Rails.application.secrets.algolia_search_api_key %>'#
        indexName: 'Student'
        searchParameters:
          hitsPerPage: 100
          numericRefinements :
            school_id:
              '=': [$('#current_school_id').val()]
        urlSync: {
          getHistoryState: ->
            { turbolinks: true }
        }
        poweredBy: true)
      search.addWidget instantsearch.widgets.searchBox(
        container: '#search-input'
        placeholder: "Rechercher"
        magnifier: false
        autofocus: true
        reset: true
      )
      search.addWidget instantsearch.widgets.hits(
        container: '#hits'
        templates:
          item: getTemplate('hit')
          empty: getTemplate('no-results'))
      search.addWidget instantsearch.widgets.pagination(
        container: '#pagination'
        cssClasses: {
          root: 'pagination'
          active: 'active'
          })
      search.addWidget instantsearch.widgets.stats({
        container: '#stats',
        templates: {
          body: "Total: {{nbHits}}<span id='nbhits' style='display:none;'>{{nbHits}}</span>"
        }
      })

      search.addWidget instantsearch.widgets.refinementList(
        container: '#classroom'
        attributeName: 'classroom'
        limit: 10
        showMore:  {
          templates: {
            active: '<a class="ais-show-more ais-show-more__inactive">Moins</a>',
            inactive: '<a class="ais-show-more ais-show-more__inactive">Plus</a>',
          }
        }
        cssClasses:
          root: ''
          count: ''
        sortBy: [
          'isRefined'
          'name:asc'
          'count:desc'
        ]
        operator: 'or'
      )
      # search.addWidget instantsearch.widgets.hitsPerPageSelector(
      #   container: '#hitperpage'
      #   items: [
      #     {value: 100, label: '100'},
      #     {value: 500, label: '500'},
      #   ]
      #   autoHideContainer: false
      # )


      search.addWidget instantsearch.widgets.refinementList(
        container: '#level'
        attributeName: 'level'
        limit: 10
        showMore: {
          templates: {
            active: '<a class="ais-show-more ais-show-more__inactive">Moins</a>',
            inactive: '<a class="ais-show-more ais-show-more__inactive">Plus</a>',
          }
        }
        cssClasses:
          root: ''
        sortBy: [
          'isRefined'
          'name:asc'
          'count:desc'
        ]
        operator: 'or'
      )
      search.start()
      search.on('render', onRenderHandler);

      $('.algolia_students').on 'click', '#toggle_all', (e) ->
        $('#all_students').prop('checked', false)
        rows = $('div.div-row:visible')
        setSelectedRow($(row), this.checked) for row in rows
        updateSelectedRowsCounter()


      # $('.algolia_students').on 'click', '.checkbox-column', (e) ->
      #   divRow = $(e.target).closest('.div-row')
      #   toggleSelectedRow(divRow)
      #
      #   updateSelectedRowsCounter()
      #   true
      # false




getTemplate = (templateName) ->
  document.getElementById(templateName + '-template').innerHTML

toggleSelectedRows = (rows = []) ->
  toogleSelectedRow row for row in rows

toggleSelectedRow = (row) ->
  rowEl = $(row)
  if rowEl.hasClass("active")
    setSelectedRow(row, false);
  else
    setSelectedRow(row, true);


setSelectedRow = (row, value) ->
  rowEl = $(row)
  inputCheckbox = rowEl.find('input')
  inputCheckbox.prop('checked', value);
  if value
    rowEl.addClass('active')
  else
    rowEl.removeClass('active')

onRenderHandler = () ->
  # reset selected row counter
  $('#selected').text('0')
  $('#toggle_all, .scb').prop('checked', false)
  $('.div-row').removeClass('active')

updateSelectedRowsCounter = () ->
  counter = $('.algolia_students').find('input.scb:checked').length
  $('#selected').text(counter)
  $('#selected').css('background', '#FFFF00')
