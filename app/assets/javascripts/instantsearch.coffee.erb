
# compatibility with browsers not supporting turbolinks:load
if not Turbolinks.supported
  $(document).ready ->
    ready()

$(document).on 'turbolinks:load', ->
  ready()
ready = () ->
  if $('.algolia_messages').length

    $('.hits').on 'click', '.title-and-content', (event) ->
      Turbolinks.visit('/messages/' + $(this).data('message-id') + '/edit')
      event.preventDefault()

    $('.hits').on 'click', '.dropdown-menu a', (event) ->
      console.log "start progress now"

    # $('.algolia').on 'keydown', 'input.ais-search-box--input', (event) ->
    #   $('#hits').show()
    #   $('#latest_messages').hide()
    #
    # $('.algolia').on 'click', '.ais-pagination--item', (event) ->
    #   $('#hits').show()
    #   $('#latest_messages').hide()
    #
    # if window.location.search != ''
    #   $('#hits').show()
    #   $('#latest_messages').hide()

    linkAction = (action, message_id) ->
      switch action
        when 'edit'
          return '<a data-disable-with="Edition..." href="/messages/' + message_id + '/edit"><i class="glyphicon glyphicon-pencil"></i>Editer</a>'
        when 'publish'
          return '<a data-disable-with="Publication..." href="/messages/publish/' + message_id + '" data-method="patch"><i class="glyphicon glyphicon-send"></i>Publier</a>'
        when 'unpublish'
          return '<a data-disable-with="Dépublication..." href="/messages/unpublish/' + message_id + '" data-method="patch"><i class="glyphicon glyphicon-remove"></i>Dépublier</a>'
        when 'republished'
          return '<a data-disable-with="Réenvoie..." href="/messages/republish/' + message_id + '" data-method="patch"><i class="glyphicon glyphicon-send"></i>Réenvoyer</a>'
        when 'approbation'
          return '<a data-disable-with="Envoi pour approbation..." href="/messages/send_for_approval/' + message_id + '" data-method="patch"><i class="glyphicon glyphicon-ok"></i>Demander l\'approbation</a>'
        when 'accept'
          return '<a data-disable-with="Approbation..." href="/messages/accept/' + message_id + '" data-method="patch"><i class="glyphicon glyphicon-thumbs-up"></i>Accepter</a>'
        when 'reject'
          return '<a data-disable-with="Rejet..." href="/messages/reject/' + message_id + '" data-method="patch"><i class="glyphicon glyphicon-thumbs-down"></i>Rejeter</a>'
        when 'delete'
          return '<a data-confirmbootbox="Etes vous sûr?" data-disable-with="Suppression..." href="/messages/' + message_id + '" data-method="delete"><i class="glyphicon glyphicon-trash"></i>Supprimer</a>'


    $('.hits').on 'click', '.dropdown-toggle', (event) ->
      ul = $(this).next('.dropdown-menu')
      if $(ul).find('li').length == 0
        workflowActive = $('#worflow_active').val()
        role = $('#role').val()
        message_id = $(this).data('message-id')
        ul.append('<li>' + linkAction('edit', message_id) + '</li>')
        ul.append('<li role="separator" class="divider"></li>')
        if workflowActive == "true"
          switch $(this).data('status')
            when 'draft'
              if role == 'admin'
                ul.append('<li>' + linkAction('publish', message_id) + '</li>')
              else
                if role == 'user'
                  ul.append('<li>' + linkAction('approbation', message_id) + '</li>')
            when 'waiting_for_approval'
              if role == 'admin'
                ul.append('<li>' + linkAction('accept', message_id) + '</li>')
                ul.append('<li>' + linkAction('reject', message_id) + '</li>')
            when 'approval_accepted'
              ul.append('<li>' + linkAction('publish', message_id) + '</li>')
            when 'approval_refused'
              if role == 'admin'
                ul.append('<li>' + linkAction('publish', message_id) + '</li>')
              else
                if role == 'user'
                  ul.append('<li>' + linkAction('approbation', message_id) + '</li>')
            when 'published'
              ul.append('<li>' + linkAction('republished', message_id) + '</li>')
              # ul.append('<li>' + linkAction('unpublish', message_id) + '</li>')
          ul.append('<li>' + linkAction('delete', message_id) + '</li>')
        else
          switch $(this).data('status')
            when 'draft'
              ul.append('<li>' + linkAction('publish', message_id) + '</li>')
            when 'published'
              ul.append('<li><a href="#"><i class="glyphicon glyphicon-send"></i>Dépublier</li>')
          ul.append('<li><a href="#"><i class="glyphicon glyphicon-trash"></i>InaSupprimer</li>')
      event.preventDefault()

    isDraft = (status) ->
      console.log status
      status == 'draft'

    search = instantsearch(
      appId: '<%= Rails.application.secrets.algolia_app_id %>'
      apiKey: $('#algolia_search_api_key').val() #'<%= Rails.application.secrets.algolia_search_api_key %>'#
      indexName: 'Message'
      searchFunction: (helper)->
        if helper.state.query == '' and helper.state.page == 0
          $('#hits').hide()
          $('#latest_messages').show()
          helper.search();
        else
          $('#hits').show()
          $('#latest_messages').hide()
          helper.search();
        return
      searchParameters:
        hitsPerPage: 12
        numericRefinements :
          school_id:
            '=': [$('#current_school_id').val()]
      urlSync: {
        getHistoryState: ->
          { turbolinks: true }
      }
      poweredBy: true)
    search.addWidget instantsearch.widgets.searchBox(
      container: '#search-input'
      placeholder: "Rechercher sur le titre, le contenu, l'auteur"
      autofocus: true
      magnifier: false
    )
    search.addWidget instantsearch.widgets.hits(
      container: '#hits'
      templates:
        item: getTemplate('hit')
        empty: getTemplate('no-results'))
    # search.addWidget instantsearch.widgets.stats({
    #   container: '#stats',
    #   templates: {
    #     body: getTemplate('stats')
    #   }
    # })
    search.addWidget instantsearch.widgets.pagination(
      container: '#pagination'
      maxPages: 10
      cssClasses: {
        root: 'pagination'
        active: 'active'
        })

    # search.addWidget instantsearch.widgets.refinementList(
    #   container: '#authors'
    #   attributeName: 'author_fullname'
    #   limit: 10
    #   cssClasses:
    #     root: 'well'
    #   sortBy: [
    #     'isRefined'
    #     'count:desc'
    #     'name:asc'
    #   ]
    #   operator: 'or'
    #   templates: header: '<h5>Auteurs</h5>'
    #   searchForFacetValues: {
    #     placeholder: 'Auteur',
    #     templates: {
    #       noResults: '<div class="sffv_no-results">Aucun auteur correspondant</div>'
    #     }
    #   })
    search.start()
    search.on('render', onRenderHandler);


getTemplate = (templateName) ->
  document.getElementById(templateName + '-template').innerHTML

onRenderHandler = () ->
  # reset selected row counter
  $('#selected').text('0')
  $('#toggle_all, .scb').prop('checked', false)
  $('.div-row').removeClass('active')
  if search?
    search.clearCache()
