add = (group) ->
  group_id = $(group).find( "input:checkbox").val()
  group_name = $(group).find("label").text()
  $('#in_groups').prepend(build_group_row(group_id, group_name))

remove = (group) ->
  console.log('group to be removed')
  group.remove()

build_group_row = (group_id, group_name) ->
  tr    = $("<tr/>")
  $("<input/>", {
      multiple: 'multiple',
      type: 'hidden',
      value: group_id,
      name: 'group[id][]'
    }).appendTo(tr)
  td1   = $("<td/>").appendTo(tr)
  $("<input/>", {
      type:"checkbox",
      id:"group[" + group_id + "]"
    }).appendTo(td1)
  td2   = $("<td/>").appendTo(tr)
  label = $("<label/>", {
              for: "group[" + group_id + "]",
              text: group_name
            }).appendTo(td2)
  console.log 'adding group' + tr
  return tr

addLine = (data, key, errors, created_at) ->
  line = '<tr class="err" id="' + key + '">'
  line += '<td>' + data + '</td>'
  line += '<td>' + errors + '</td>'
  line += '<td>' + created_at + '</td>'
  line += '</tr>'
  $('#errors_list').prepend $(line)
  return

setErrorCounterValue = () ->
  $('#error_counter').text($('.err').length)


removeLine = (key) ->
  console.log 'removing line ' + key
  $('#' + key).remove()

