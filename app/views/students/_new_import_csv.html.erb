 <div class="row">
   <div class="col-xs-12 col-sm-6 col-md-5 col-lg-5">
     <% unless error_message.nil? %>
       <div class="alert alert-danger" role="alert">
         <a class="close" data-dismiss="alert">&#215;</a>
         <ul>
             <%= content_tag :li, error_message %>
         </ul>
       </div>
     <% end %>
     <%= form_tag({action: :csv_upload}, multipart: true) do %>
       <div class="form-group">
         <%= file_field_tag 'csv' %>
      </div>
      <% if current_school.delete_students_on_csv_import %>
      <div class="form-group">
        <%= check_box_tag 'delete_students', nil, true %>
        <label for="delete_students">Supprimer les élèves ne faisant pas partie de l'import</label>
      </div>
      <% end %>

       <%= submit_tag 'Envoyer', class: 'btn btn-primary' %>
     <% end %>
   </div>
   <div class="col-xs-12 col-sm-6 col-md-7 col-lg-7">
     <%= render '/faq/create_students_import_csv' %>
   </div>
 </div>
