
<% @students&.each do |student| %>
    <div class="student nobreak">
        <table cellpadding="0" cellspacing="0" width="100%">
          
          <tr>
            <td class="title">
                <%= student.firstname %> <%= student.lastname %>
                </br>
                <%= "#{student.level} #{student.classroom}" %>
            </td>

            <td class="code">
                Code Konecto App: <b><%= student.code %></b>            
            </td>
               
          </tr>
        </table>
    </div>
<% end %>