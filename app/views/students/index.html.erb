<h1>Elèves
  <% if policy(:student).new? %>
    <div class="pull-right">
      <%= link_to 'Nouvel élève', new_student_path, class: 'btn btn-primary btn-block' %>
    </div>
  <% end %>
</h1>
<hr />
<div class="row" id="students">
    <div class="col-xs-12 col-sm-12 col-md-9 col-lg-9" >
      <% if @students.any? %>
        <table class="table table-striped table-hover">
          <thead>
            <tr>
              <th><input type="checkbox" id="toggle_all"/></th>
              <th class="sort" data-sort="lastname"><%= t('activerecord.attributes.student.lastname') %></th>
              <th class="sort" data-sort="firstname"><%= t('activerecord.attributes.student.firstname') %></th>
              <% if current_user.superadmin? %>
                <th><%= t('activerecord.attributes.student.school') %></th>
              <% end %>
              <th class="sort" data-sort="level"><%= t('activerecord.attributes.student.level') %></th>
              <th class="sort" data-sort="classroom"><%= t('activerecord.attributes.student.classroom') %></th>
              <th class="sort" data-sort="code"><%= t('activerecord.attributes.student.code') %></th>
              <th></th>
            </tr>
          </thead>
          <tbody class="list">
            <% @students.each do |student| %>
              <tr>
                <td><%= check_box_tag 's[]', student.id, false, class: 'scb' %> </td>
                <% if policy(student).edit? %>
                  <td><%= link_to student.lastname, edit_student_path(student), class: "lastname" %></td>
                <% else %>
                  <td class="lastname"><%= student.lastname %></td>
                <% end %>
                <% if policy(student).edit? %>
                  <td><%= link_to student.firstname, edit_student_path(student), class: "firstname" %></td>
                <% else %>
                  <td class="firstname"><%= student.firstname %></td>
                <% end %>
                <% if current_user.superadmin? %>
                  <td><% if student.school.present? %><%= student.school.name %><% end %></td>
                <% end %>
                <td class="level"><%= student.level %></td>
                <td class="classroom"><%= student.classroom %></td>
                <td class="code"><%= student.code %></td>
                <td>
                  <% if student.followers > 0 %><span class="glyphicon glyphicon-phone aria-hidden="true"></span> <%= student.followers %><% end %>
                  <% if student.sent_message_by_email %><i class="fa fa-envelope"></i><% end %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      <% else %>
        <% if current_user.admin? %>
        <p>Aucun élève
          <% if policy(:student).new? %>
            , <%= link_to 'créer un élève maintenant', new_student_path %> ou <%= link_to 'importer un fichier CSV', new_import_csv_path %></p>
          <% end %>
        </p>
        <% else %>
          <%= I18n.t('views.messages.students_no_rights', admins: current_school.admins.map {|u| u.fullname}.join(', ')) %>
        <% end %>
      <% end %>
    </div>
    <% if @students.any? %>
      <div class="col-xs-12 col-sm-12 col-md-3 col-lg-3">
        <div class="row">
          <div class="col-xs-12 col-sm-12 col-md-12 col-lg-12">
            <div class="form-group">
              <label for="search">Filtre</label>
                <input id="search" class="form-control search" autofocus="" >
            </div>
          </div>
        </div>
        <% if policy(:student).new? %>
          <div class="row">
            <hr />
            <div class="col-xs-12 col-sm-12 col-md-12 col-lg-12">
              <%= link_to 'Import CSV', new_import_csv_path, class: 'btn btn-primary btn-block' %>
            </div>
          </div>
          <div class="row" style="margin-top: 30px">
            <div class="col-xs-12 col-sm-12 col-md-12 col-lg-12">
              <%= form_for @message, as: :post, url: students_export_csv_path, method: :post, html: { id: "export_csv" } do |f| %>
                <%= f.submit 'Export CSV', class: 'btn btn-primary btn-block', id: 'export_csv_submit', :data => { disable_with: false } %>
              <% end %>
            </div>
          </div>
          <div class="row" style="margin-top: 30px">
            <div class="col-xs-12 col-sm-12 col-md-12 col-lg-12">
              <%= link_to 'Effacer', '#' , class: 'btn btn-primary btn-block', id: 'destroy_all' %>
            </div>
          </div>
          <div class="row" style="margin-top: 30px">
            <div class="col-xs-12 col-sm-12 col-md-12 col-lg-12">
              <%= form_for(@message) do |f| %>
                <%= f.hidden_field :title, value: t('views.students.sendcode.title') %>
                <%= f.hidden_field :content, value: "#{t('views.students.sendcode.content')}<br/>#{t('views.students.sendcode.app_download_links')}" %>
                <%= f.hidden_field :send_by_email, value: true %>
                <%= f.hidden_field :send_to_app, value: false %>
                <%= f.hidden_field :skip_send_by_email, value: true %>
              <% end %>
              <%= link_to 'Envoyer code', '#' , class: 'btn btn-primary btn-block', id: 'send_code'%>
            </div>
          </div>
        <% end %>
        <div class="row" style="margin-top: 30px">
          <div class="col-xs-12 col-sm-12 col-md-12 col-lg-12">
            <%= "Nombre d'élèves: #{@students.size}" %>
          </div>
        </div>
      </div>
    <% end %>
</div>
