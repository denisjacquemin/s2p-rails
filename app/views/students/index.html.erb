<h1>Elèves
  <% if policy(:student).new? %>
    <div class="pull-right">
      <%= link_to 'Nouvel élève', new_student_path, class: 'btn btn-primary' %>
    </div>
  <% end %>
</h1>
<hr />
<div class="row">
    <div class="col-xs-12 col-sm-12 col-md-12 col-lg-12">
      <table class="table table-striped table-hover">
        <thead>
          <tr>
            <th><%= t('activerecord.attributes.student.firstname') %></th>
            <th><%= t('activerecord.attributes.student.lastname') %></th>
            <% if current_user.superadmin? %>
              <th><%= t('activerecord.attributes.student.school') %></th>
            <% end %>
            <th><%= t('activerecord.attributes.student.level') %></th>
            <th><%= t('activerecord.attributes.student.classroom') %></th>
            <th><%= t('activerecord.attributes.student.code') %></th>
          </tr>
        </thead>
        <tbody>
          <% @students.each do |student| %>
            <tr>
              <% if policy(student).edit? %>
                <td><%= link_to student.firstname, edit_student_path(student) %></td>
              <% else %>
                <td><%= student.firstname %></td>
              <% end %>
              <% if policy(student).edit? %>
                <td><%= link_to student.lastname, edit_student_path(student) %></td>
              <% else %>
                <td><%= student.lastname %></td>
              <% end %>
              <% if current_user.superadmin? %>
                <td><% if student.school.present? %><%= student.school.name %><% end %></td>
              <% end %>
              <td><%= student.level %></td>
              <td><%= student.classroom %></td>
              <td><%= student.code %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
</div>
