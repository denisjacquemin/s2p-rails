<%= hidden_field_tag 'algolia_search_api_key', current_user.algolia_search_api_key %>
<%= hidden_field_tag 'current_school_id', @current_school.id %>

<div class="row">
    <div class="col-xs-5">
        <h1 style="margin:0;"><%= current_school.iscity ? 'Citoyens' : 'Elèves' %>
            <% if policy(:student).new? %>
            <%= link_to 'Nouvel élève', new_student_path, class: 'btn btn-primary fab visible-xs' %>
            <% end %>
        </h1>
    </div>
    <div class="col-xs-7">
        <div class="hidden-xs btn-toolbar pull-right students_toolbar" role="toolbar" aria-label="...">
            <div class="btn-group" role="group" aria-label="...">
                <% if @current_school&.bulletin_enable %>
                <%= link_to ratings_choose_report_period_path, id: 'choose_report_period', class: 'btn btn-default', remote: true, rel: "tooltip", 'data-toggle': "tooltip", 'data-placement':"bottom", title: "Génération des bulletins" do %>
                <i class="fa fa-book-open" aria-hidden="true"></i>
                <% end %>
                <% end %>
                <%= link_to new_import_csv_path, class: 'btn btn-default', rel: "tooltip", 'data-toggle': "tooltip", 'data-placement':"bottom", title: "Import Excel" do %>
                <i class="fa fa-upload" aria-hidden="true"></i>
                <% end %>
                <%= form_for @message, as: :post, url: students_export_csv_path, method: :post, html: { id: "export_csv" } do |f| %>
                <button type="submit" class='btn btn-default' id='export_csv_submit' rel="tooltip" data-toggle="tooltip" data-placement="bottom" title="Export Excel">
                    <i class="fa fa-file-excel" aria-hidden="true"></i>
                </button>
                <% end %>
                <%= form_for @message, as: :post, url: students_codes_to_pdf_path(format: :pdf), method: :post, html: { id: "codes_to_pdf", target: '_blank' } do |f| %>
                <button type="submit" class='btn btn-default' id='codes_to_pdf_submit' rel="tooltip" data-toggle="tooltip" data-placement="bottom" title="Export Codes PDF">
                    <i class="fa fa-file-pdf" aria-hidden="true"></i>
                </button>
                <% end %>
                <span>
                    <button type="button" id="delete_all" class="btn btn-default" rel="tooltip" data-toggle="tooltip" data-placement="bottom" title="Supprimer des élèves">
                        <i class="fa fa-trash" aria-hidden="true"></i>
                    </button>
                </span>
                <span>

                    <% unless current_school.iscity %>
                    <% if policy(Group).index? %>
                    <a type="button" href="<%= groups_path %>" class="btn btn-default" rel="tooltip" data-toggle="tooltip" data-placement="bottom" title="Liste des groupes d'élèves">
                        <i class="fa fa-users" aria-hidden="true"></i>
                    </a>
                    <% end %>
                    <% end %>

                    <button type="button" class="btn btn-default sendcodetoall" rel="tooltip" data-toggle="tooltip" data-placement="bottom" title="Envoyer code">
                        <i class="fa fa-id-badge" aria-hidden="true"></i>
                    </button>
                </span>


            </div>
            <div class="btn-group" role="group" aria-label="...">
                <%= link_to current_school.iscity ? 'Nouveau citoyen' : 'Nouvel élève', new_student_path, class: 'btn btn-primary' %>
            </div>
        </div>
    </div>
    <div class="col-xs-12">
        <hr />
    </div>
</div>


<div class="modal fade" id="modal" tabindex="-1" role="dialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title">Modal title</h4>
            </div>
            <div class="modal-body">
                <p>One fine body&hellip;</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-default" data-dismiss="modal">Close</button>
                <button type="button" class="btn btn-primary submit">Save changes</button>
            </div>
            <div id="modal-form"></div>
        </div>
    </div>
</div>

<% if @total_of_students == 0 %>
<div style="width:100%;height:100%;text-align:center;font-size:35px;color:#bbb;padding: 0 50px;">
    <br><br>Aucun élève pour l'instant.<br><br>
    <i class="fa fa-user-slash" style="font-size:80px;" aria_hidden="true"></i>
</div>

<% else %>

<% if ! current_school.iscity and ! current_school.is_ifapme %>
<blockquote>🚸 <a href="/help/update_students">Guide de mise à jour des élèves.</a></blockquote>
<% end %>

<div class="row algolia algolia_students">
    <div class="col-xs-12 col-sm-12 col-md-9 col-lg-9" id="results">
        <div class="clearfix div-row div-row-header">
            <div class="selectall-checkbox-column hidden-xs"><input type="checkbox" id="toggle_all" /></div>
            <div class="div-column">Nom</div>
            <div class="div-column">Prénom</div>
            <div class="div-column">
                <%= current_school.iscity ? "Entité": "Classe" %></div>
            <div class="div-column hidden-xs">
                <%= current_school.iscity ? "Rue": "Titulaire" %>
            </div>
            <div class="div-column">Code</div>
            <div class="div-column-action hidden-xs hidden-sm"></div>
        </div>
        <div id="hits" class="div-table hits">
            <div>
                <% @first_500_students.each do |student| %>
                <div class="ais-hits--item">
                    <div class="clearfix div-row hit-content" data-student-id="<%= student.id %>">
                        <div class="checkbox-column row-checkbox toggle-row hidden-xs"><input type="checkbox" name="student[id][]" id="s_" value="<%= student.id %>" class="scb toggle-row"></div>
                        <div class="div-column"><%= student.lastname %></div>
                        <div class="div-column"><%= student.firstname %></div>
                        <div class="div-column"><%= student.level %></div>
                        <div class="div-column hidden-xs"><%= student.classroom %></div>
                        <div class="div-column"><%= student.code %></div>
                        <div class="div-column-action hidden-xs hidden-sm">
                            <table class="flags">
                                <tr>
                                    <td class="flag" <% if student.followers > 0 %>style="visibility:visible" <% end %>><span class="glyphicon glyphicon-phone" aria-hidden="true"></span><sup><%= student.followers %></sup></td>
                                    <td class="flag" <% if student.student_emails.size > 0 %> style="visibility:visible" <% end %>><i class="fa fa-envelope"></i></td>
                                    <td class="flag" <% if student.phones.size > 0 %> style="visibility:visible" <% end %>><span class="fa fa-phone" aria-hidden="true"></span><sup><%= student.phones.size %></sup></td>
                                </tr>
                            </table>
                            <div class="btn-group action-menu" rel="tooltip" data-toggle="tooltip" data-placement="top" title="Actions">
                                <a href="#" class="btn btn-sm dropdown-toggle dd-toggle" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false" data-student-id="<%= student.id %>">
                                    <i class="dd-toggle material-icons">more_vert</i>
                                </a>
                                <ul class="dropdown-menu pull-right">
                                </ul>
                            </div>
                        </div>
                    </div>
                </div>
                <% end %>
            </div>
        </div>
        <div id="pagination"></div>
    </div>

    <div class="col-xs-12 col-sm-12 col-md-3 col-lg-3">
        <div>
            <div class="pull-left"><span id="selected">0</span> élève(s) sélectionné(s)</div>
            <div id="stats" class="pull-right"></div>
        </div>
        <div id="search-input"></div>
        <div>
            <label class="ais-RefinementList-label">
                <input type="checkbox" class="scb" name="all_students" id="all_students" value="true">
                Tous les <%= current_school.iscity ? 'citoyens' : 'élèves' %>
                <span class="ais-RefinementList-count" id="TotalStd"><%= @total_of_students %></span>
            </label>
            <br />
            <div id="level"></div>
            <div id="classroom"></div>
            <h5 class="<%= current_school.is_ifapme ? '' : 'displaynone' %>">Filtrer par date de création</h5>
            <div id="calendar" class="<%= current_school.is_ifapme ? '' : 'displaynone' %> daterange daterange--double one"></div>
        </div>
        <!--
    <div class="pull-right" id="results_by_page"><span id="hitperpage"></span> Résultats par page</div>
    -->
    </div>
</div>

<% end %>

<script type="text/html" id="hit-template">
    <div class="clearfix div-row hit-content" data-student-id="{{{objectID}}}">
        <div class="checkbox-column row-checkbox toggle-row hidden-xs"><input type="checkbox" name="student[id][]" id="s_" value="{{{objectID}}}" class="scb toggle-row"></div>
        <div class="div-column">{{{_highlightResult.lastname.value}}}</div>
        <div class="div-column">{{{_highlightResult.firstname.value}}}</div>
        <div class="div-column">{{{_highlightResult.level.value}}}</div>
        <div class="div-column hidden-xs">{{{_highlightResult.classroom.value}}}</div>
        <div class="div-column">{{{_highlightResult.code.value}}}</div>
        <div class="div-column-action hidden-xs hidden-sm">
            <table class="flags">
                <tr>
                    <td class="flag" {{#followers}}style="visibility:visible" {{/followers}}><span class="glyphicon glyphicon-phone" aria-hidden="true"></span><sup>{{followers}}</sup></td>
                    <td class="flag" {{#message_sent_by_email}}style="visibility:visible" {{/message_sent_by_email}}><i class="fa fa-envelope"></i></td>
                    <td class="flag" {{#phones_count}}style="visibility:visible" {{/phones_count}}><span class="fa fa-phone" aria-hidden="true"></span><sup>{{phones_count}}</sup></td>
                </tr>
            </table>
            <!-- {{#followers}}
        <span class="glyphicon glyphicon-phone" aria-hidden="true"></span><sup>{{followers}}</sup>
      {{/followers}}
      {{#message_sent_by_email}}
        <i class="fa fa-envelope"></i>
      {{/message_sent_by_email}}
      {{#phones_count}}
        <span class="fa fa-phone" aria-hidden="true"></span><sup>{{phones_count}}</sup>
      {{/phones_count}} -->
            <div class="btn-group action-menu" rel="tooltip" data-toggle="tooltip" data-placement="top" title="Actions">
                <a href="#" class="btn btn-sm dropdown-toggle dd-toggle" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false" data-student-id="{{{objectID}}}">
                    <i class="dd-toggle material-icons">more_vert</i>
                </a>
                <ul class="dropdown-menu pull-right">
                </ul>
            </div>
        </div>
    </div>
</script>

<script type="text/html" id="show-more-template">
{{#isShowingMore}}
    Moins
{{/isShowingMore}}
{{^isShowingMore}}
    Plus
{{/isShowingMore}}
</script>

<script type="text/html" id="no-results-template">
    <div id="no-results-message">
        <p>Aucun élève correspondant <em>"{{query}}"</em>.</p>
    </div>
</script>

<script type="text/template" id="facet-item-template">
    <div>
        <input type="checkbox" class="ais-RefinementList--checkbox" value="{{ name }}">
        <a href="" class="facet-link toggle-refine {{#disjunctive}}facet-disjunctive{{/disjunctive}} {{#isRefined}}facet-refined{{/isRefined}}" data-facet="{{ facet }}" data-value="{{ name }}">
          {{ name }}<span class="facet-count">#{{ count }}</span>
        </a>
      </div>
    </script>