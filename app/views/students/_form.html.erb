<%= form_for(student) do |f| %>
  <%= render 'layouts/errors', object: student %>

  <%
    submit_label = t('views.students.new.submit')
    submit_label = t('views.students.edit.submit') unless @student.new_record?
  %>
  <%= hidden_field_tag 'school_id', current_school.id %>
  <div class="row">
    <div class="col-xs-12 col-sm-12 col-md-12 col-lg-12 ">
      <%= f.submit submit_label, class: 'btn btn-primary fab visible-xs' %>
      <div class="pull-right hidden-xs">
        <%= f.submit submit_label, class: 'btn btn-primary' %>
        <% if policy(student).destroy? and not student.new_record? %>
          <%= link_to t('views.global.destroy'), student, method: :delete, data: { confirm: t('views.global.areyousure') }, class: 'btn btn-danger' %>
        <% end %>
      </div>
    </div>
  </div>

  <div class="row">
    <div class="col-xs-12 col-sm-12 col-md-4 col-lg-4">
      <div class="form-group">
        <%= f.label :lastname %>
        <%= f.text_field :lastname, class: 'form-control' %>
      </div>
    </div>
    <div class="col-xs-12 col-sm-12 col-md-4 col-lg-4">
      <div class="form-group">
        <%= f.label :firstname %>
        <%= f.text_field :firstname, class: 'form-control' %>
      </div>
    </div>
    <% unless @student.new_record? %>
    <div class="col-xs-12 col-sm-12 col-md-4 col-lg-4">
      <div class="form-group">
        <%= f.label :code %>
        <%= f.text_field :code, class: 'form-control' %>
      </div>
    </div>
    <% end %>
  </div>

  <div class="row">
    <div class="col-xs-12 col-sm-12 col-md-6 col-lg-6">
      <div class="form-group">
        <%= f.label :level %>
        <%= f.text_field :level, class: 'form-control ac' %>
      </div>
    </div>
    <div class="col-xs-12 col-sm-12 col-md-6 col-lg-6">
      <div class="form-group">
        <%= f.label :classroom %>
        <%= f.text_field :classroom, class: 'form-control ac' %>
      </div>
    </div>
  </div>
  <div class="row">
    <div class="col-xs-12 col-sm-12 col-md-6 col-lg-6" id="email-list">
      <div class="panel panel-default">
        <div class="panel-heading">Emails</div>
        <div class="panel-body">
          <%= f.fields_for :student_emails do |email_fields| %>
            <%= render 'student_email_fields', f: email_fields %>
          <% end %>
          <div class="row">
            <div class="col-xs-12">
              <%= link_to_add_fields "Ajouter un Email", f, :student_emails %>
            </div>
          </div>
        </div>
      </div>
    </div>
    <div class="col-xs-12 col-sm-12 col-md-6 col-lg-6" id="phone-list">
      <div class="panel panel-default">
        <div class="panel-heading">Téléphones</div>
        <div class="panel-body">
          <%= f.fields_for :phones do |phone_fields| %>
            <%= render 'phone_fields', f: phone_fields %>
          <% end %>
          <div class="row">
            <div class="col-xs-12">
              <%= link_to_add_fields "Ajouter un Numéro de téléphone", f, :phones %>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>


  <% if current_user.superadmin? %>
    <div class="row">
      <div class="col-xs-12 col-sm-12 col-md-12 col-lg-12">
        <div class="form-group">
          <%= f.label :school %>
          <%= f.select(:school_id, School.all.map {|s| [s.name,s.id]}, {}, {class: "form-control"})  %>
        </div>
      </div>
    </div>
  <% end %>
  <% unless student.new_record? %>
  <div class="row" id="student_manage_group">
    <div class="col-xs-12 col-sm-12 col-md-12 col-lg-12">
      <%= render "students_'_groups_manager", student: @student %>
    </div>
  </div>
  <% end %>
<% end %>
