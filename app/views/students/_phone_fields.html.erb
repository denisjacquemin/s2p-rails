<div class="row">
  <div class="col-xs-12 col-sm-12 col-md-12 col-lg-12">
    <div class="form-group">
      <div class="input-group">
        <input type="tel" class="intlphonenumber form-control">
        <%= f.hidden_field :number, class: 'form-control' %>
        <div class="input-group-btn">
          <a class="btn btn-default remove_fields">
            <i class="fa fa-trash" aria-hidden="true"></i>
          </a>
          <%= f.hidden_field '_destroy' %>
        </div>
      </div>
      <span id="helpBlock" class="help-block">Numéro de téléphone auquel sera envoyé les messages SMS.</span>
    </div>
  </div>
</div>
