<h1>Import CSV</h1>
<hr />
<div class="row">
    <div class="col-xs-12 col-sm-8 col-md-8 col-lg-8">
      <%= form_tag({action: :csv_upload}, multipart: true) do %>
        <%= file_field_tag 'csv' %>
        <%= submit_tag 'Envoyer' %>
      <% end %>
    </div>
    <div class="col-xs-12 col-sm-4 col-md-4 col-lg-4">
      help
    </div>
</div>
