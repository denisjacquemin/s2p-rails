<h1>Import CSV</h1>
<hr />
<div class="row">
    <div class="col-xs-12 col-sm-8 col-md-8 col-lg-7">
      <ul class="nav nav-tabs" role="tablist">
       <li role="presentation" class="active"><a href="#upload" aria-controls="upload" role="tab" data-toggle="tab">Nouveau fichier</a></li>
       <li role="presentation"><a href="#errors" aria-controls="errors" role="tab" data-toggle="tab">Erreur de creations</a></li>
      </ul>

      <!-- Tab panes -->
      <div class="tab-content">
       <div role="tabpanel" class="tab-pane active" id="upload">
         <br/>
          <% unless error_message.empty? %>
            <h3>Un problème est survenu avec votre fichier</h3>
            <p>Message d'erreur: <%= error_message %></p>
          <% end %>
          <% if error_message.empty? %>
            <h3><%= message %></h3>
            <p>La création des élèves peut prendre du temps</p>
          <% end %>
          <%= link_to 'importer un nouveau fichier CSV', new_import_csv_path %>
        </div>
        <div role="tabpanel" class="tab-pane" id="errors">
          <%= render 'csv_errors' %>
        </div>
      </div>
    </div>
    <div class="col-xs-12 col-sm-4 col-md-4 col-lg-5">
      <%= render 'help_csv' %>
    </div>
</div>
