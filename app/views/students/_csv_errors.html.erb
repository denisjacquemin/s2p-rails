<script>
  var config = {
    apiKey: '<%= Rails.application.secrets.firebase_secret_key %>',
    databaseURL: '<%= Rails.application.secrets.firebase_base_uri %>'
  };
  firebase.initializeApp(config);
  var errorsRef = firebase.database().ref('csv/' + <%= current_school.id %> + '/' +  <%= current_user.id %>);
  errorsRef.on('child_added', function(data) {
    addLine(JSON.stringify(data.val().data), JSON.stringify(data.val().errors), data.val().created_at);
  });

  addLine = function(data, errors, created_at) {


    var line = "<tr>";
    line += "<td>" + data + "</td>"
    line += "<td>" + errors + "</td>"
    line += "<td>" + created_at + "</td>"
    line += "</tr>"
    $('#errors_list').prepend($(line));
  }
</script>
<p>Ci-dessous la liste des erreurs rencontrées lors de la creation des élèves depuis un fichier .CSV</p>
<table class="table">
  <thead>
    <tr>
      <th>Donnees</th>
      <th>Erreur(s)</th>
      <th>Date/heure</th>
    </tr>
  </thead>
  <tbody id="errors_list"></tbody>
</table>
