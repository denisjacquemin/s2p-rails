    <section id="download" class="download bg-primary text-center">
        <div class="container">
            <div class="row">
                <div class="col-md-10 col-md-offset-1">
                    <h2 class="section-heading">Découvrez la démo maintenant !</h2>
                    <p>Téléchargez l'app sur <u>votre mobile</u>, et entrez le code <span class="highlighted-grey">&nbsp;sdemo&nbsp;</span>!</p>
                    <div class="badges">
                        <a class="badge-link" href="https://play.google.com/store/apps/details?id=com.dsjn.s2p"><img width="200px" src="img/google-play-badge.svg" alt=""></a>
                        <a class="badge-link" href="https://itunes.apple.com/be/app/konecto-app/id1141643283?mt=8"><img width="200px" src="img/app-store-badge.svg" alt=""></a>
                        <br/>ou<br/> cherchez <span class="highlighted-grey">Konecto app</span> sur les stores
                        <br/>Pour une démo de l'interface Web de gestion des messages, <u><a class="page-scroll" href="#contact" style="color:white;">contactez-nous</a></u>.
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section id="contact" class="cta">
        <div class="cta-content">
          <div id="contactthanks" class="container" style="display:none;margin-top:70px;margin-bottom:70px;">
            <div class="row">
                <div class="col-lg-12 text-center">
                    <h2 class="section-heading"><i class="icon-paper-plane text-primary" style="color:white"></i> Merci</h2>
                </div>
            </div>
            <div class="row">
                <div class="col-lg-12">
                  <p style="color:white;text-align:center">Votre message a bien été transmis, et sera traité dans les meilleurs délais.</p>
                </div>
              </div>
          </div>
          <div id="contactform" class="container">
              <div class="row">
                  <div class="col-lg-12 text-center">
                      <h2 class="section-heading">Contactez-nous</h2>
                  </div>
              </div>
              <div class="row">
                  <div class="col-lg-12">
                      <%= form_tag('/contactme', method: "post", remote: true) do %>
                        <%= hidden_field_tag :authenticity_token, form_authenticity_token %>
                          <div class="row">
                              <div class="col-md-6">
                                  <div class="form-group">
                                    <%= label_tag 'Votre nom *' %>
                                    <%= text_field_tag 'name', '', class: 'form-control', required: 'required' %>
                                    <p class="help-block text-danger"></p>
                                  </div>
                                  <div class="form-group">
                                    <%= label_tag 'Votre Email *' %>
                                    <%= text_field_tag 'email', '', class: 'form-control', required: 'required' %>
                                    <p class="help-block text-danger"></p>
                                  </div>
                                  <div class="form-group">
                                    <%= label_tag 'Votre téléphone *' %>
                                    <%= text_field_tag 'tel', '', class: 'form-control', required: 'required' %>
                                    <p class="help-block text-danger"></p>
                                  </div>
                              </div>
                              <div class="col-md-6">
                                  <div class="form-group">
                                    <%= label_tag 'Votre message *' %>
                                    <%= text_area_tag 'message', '', class: 'form-control', required: 'required'%>
                                    <p class="help-block text-danger"></p>
                                  </div>
                                  <div class="form-group">
                                    <%= label_tag 'Captcha *' %>
                                    <%= recaptcha_tags %>
                                    <p class="help-block text-danger recaptcha"></p>
                                  </div>
                              </div>
                              <div class="clearfix"></div>
                              <div class="col-lg-12 text-center">
                                  <div id="success"></div>
                                  <%= button_tag 'Envoyer', class: "btn btn-xl", data: { disable_with: "<i class='fa fa-circle-o-notch fa-spin'></i> En cours d'envoi...".html_safe } %>
                              </div>
                          </div>
                      <% end %>
                  </div>
              </div>
            </div>
        </div>
        <div class="overlay"></div>
    </section>


