                  <div class="container-fluid">
                      <div class="row">

                          <div class="col-xs-12 col-sm-6 col-md-6">
                              <div class="feature-item">
                                  <i class="icon-graduation text-primary"></i>
                                  <h3>Utile pour la vie au quotidien de l'école</h3>
