<% @current_school = current_school if user_signed_in?%>
<nav class="navbar navbar-default navbar-fixed-top bg-dark">
  <div class="container-fluid">
    <div class="navbar-header">
      <button type="button" class="navbar-toggle collapsed" data-toggle="collapse" data-target="#bs-example-navbar-collapse-1" aria-expanded="false">
        <span class="sr-only">Toggle navigation</span>
        <span class="icon-bar"></span>
        <span class="icon-bar"></span>
        <span class="icon-bar"></span>
      </button>
      <a class="navbar-brand hidden-md" href="/"><%= image_tag asset_path("konecto_logo.png") %></a>
    </div>

    <div class="collapse navbar-collapse" id="bs-example-navbar-collapse-1">
     <%= form_tag '/schools/change_school', id: "change_school_form" do  %>
     <%= hidden_field_tag 'selected_school_id'%>
     <ul class="nav navbar-nav navbar-right">
       <% if user_signed_in? %>
          <%
            role = "<span class=\"label label-primary\">Rédacteur</span>" if current_user.user?
            role = "<span class=\"label label-warning\">Admin</span>" if current_user.admin?
            role = "<span class=\"label label-danger\">SuperAdmin</span>" if current_user.superadmin?
          %>
          <li class="hidden-xs nav navbar-text">Bienvenue <%= current_user.firstname %> <%= role.html_safe %></li>
         <% unless @current_school.nil? %>
             <% if current_user.schools.uniq.compact.size > 1 or current_user.superadmin? %>
               <li class="dropdown">
                 <a href="#" class="dropdown-toggle" data-toggle="dropdown" role="button" aria-haspopup="true" aria-expanded="false"><%= @current_school.name %> <span class="caret"></span></a>
                   <ul class="dropdown-menu" id="change_school">
                     <% if current_user.superadmin? %>
                       <% School.all.each do |s| %>
                        <li><a class="this_school" data-school-id="<%= s.id %>" href="#"><%= s.name %></a></li>
                       <% end %>
                     <% else %>
                       <% current_user.schools_obj.each do |s| %>
                        <li><a class="this_school" data-school-id="<%= s.id %>" href="#"><%= s.name %></a></li>
                       <% end %>
                     <% end %>
                   </ul>
               </li>
             <% end %>
         <% end %>
         <li>
             <%= link_to content_tag(:i, nil, class: "fa fa-envelope", aria_hidden: true) + ' Messages', messages_path %>
         </li>
         <% if policy(School).index? %>
           <li>
               <%= link_to 'Ecoles', schools_path %>
           </li>
         <% end %>
         <% if policy(Student).index? %>
           <li>
               <%= link_to content_tag(:i, nil, class: "fa fa-user", aria_hidden: true) + ' Elèves', students_path %>
           </li>
         <% end %>
         <% if policy(Group).index? %>
           <li>
               <%= link_to content_tag(:i, nil, class: "fa fa-users", aria_hidden: true) + ' Groupes', groups_path %>
           </li>
         <% end %>
         <% if policy(User).index? %>
           <li>
               <%= link_to 'Rédacteurs', users_path %>
           </li>
         <% end %>
         <li class="dropdown">
           <a href="#" class="dropdown-toggle" data-toggle="dropdown" role="button" aria-haspopup="true" aria-expanded="false"><%= content_tag(:i, nil, class: "fa fa-cog", aria_hidden: true) %> <span class="caret"></span></a>
             <ul class="dropdown-menu">
               <% if current_user.admin? %>
                <li><%= link_to 'Modèles Formulaires', form_templates_path %></li>
               <% end %>
               <li><%= link_to current_user.fullname, edit_user_path(current_user) %></li>
               <li><%= link_to 'Compte', edit_user_registration_path %></li>
               <% if current_user.admin? %>
                <li><%= link_to @current_school.name, edit_current_school_path %></li>
               <% end %>
             </ul>
         </li>
         <li id="new_announcements_menu_item">
           <input type="hidden" id="current_user_new_announcement_counter" value="<%= current_user.new_announcement_counter %>"/>
           <a href="#" id="whatsnew"><%= content_tag(:i, nil, class: "fa fa-bell", aria_hidden: true, id: 'new_announcement_menu_icon') %></a></li>
         <li class="dropdown">
           <a href="#" class="dropdown-toggle" data-toggle="dropdown" role="button" aria-haspopup="true" aria-expanded="false"><%= content_tag(:i, nil, class: "fa fa-question-circle", aria_hidden: true) %><span class="hidden-md"> Aide</span> <span class="caret"></span></a>
             <ul class="dropdown-menu">
               <li><a href="/help"><i class="fa fa-question-circle" aria_hidden="true"></i> Guide utilisateur</a></li>
               <li><a href="/help/comment_demarrer"><i class="fa fa-rocket" aria_hidden="true"></i> Guide de démarrage</a></li>
               <li class="divider"></li>
               <li><a href="/contact_support"><i class="fa fa-envelope" aria_hidden="true"></i> Contacter le support</a></li>
             </ul>
         </li>
         <li><%= link_to content_tag(:i, nil, class: "fa fa-power-off", aria_hidden: true), destroy_user_session_path, :method=>'delete' %></li>
       <% end %>
     </ul>
     <% end %>
    </div>
  </div>
</nav>
