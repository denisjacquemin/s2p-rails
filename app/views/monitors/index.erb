<h1>Monitoring</h1>
<hr />
<div class="row">
    <div class="col-xs-12 col-sm-12 col-md-12 col-lg-12">
      <h2>Last 15 connections</h2>
      <table class="table table-striped table-hover">
        <thead>
          <tr>
            <th>Name</th>
            <th>Role</th>
            <th>School</th>
            <th>Last sign in at</th>
          </tr>
        </thead>

        <tbody id="schools">
          <% @latest_logged_users.each do |user| %>
            <tr>
              <td><%= user.firstname %> <%= user.lastname %></td>
              <td><%= user.role %></td>
              <td></td>
              <td><%= user.last_sign_in_at %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
</div>
