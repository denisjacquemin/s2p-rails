<h1>Monitoring</h1>
<hr />
<div class="row">
    <div class="col-xs-12 col-sm-12 col-md-12 col-lg-12">
      <h2>Last 15 connections</h2>
      <table class="table table-striped table-hover">
        <thead>
          <tr>
            <th>Name</th>
            <th>Role</th>
            <th>School</th>
            <th>Last sign in at</th>
          </tr>
        </thead>

        <tbody>
          <% @latest_logged_users.each do |user| %>
            <tr>
              <td><%= user.firstname %> <%= user.lastname %></td>
              <td><%= user.role %></td>
              <td></td>
              <td><%= user.last_sign_in_at %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
<div class="row">
    <div class="col-xs-12 col-sm-12 col-md-12 col-lg-12">
      <h2>Last 15 connections</h2>
      <table class="table table-striped table-hover">
        <thead>
          <tr>
            <th>Title</th>
            <th>School</th>
            <th>Author</th>
            <th>Creation time</th>
          </tr>
        </thead>

        <tbody>
          <% @latest_messages.each do |message| %>
            <tr>
              <td><%= message.title %> <%= user.lastname %></td>
              <td><%= message.school.name %></td>
              <td><%= message.author.fullname %></td>
              <td><%= message.created_at %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
</div>
