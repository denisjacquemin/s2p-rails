<h1><%= t('views.groups.show.member_list') %> (<%= @group.name %>)</h1>
<hr />
<div class="row">
  <div class="col-xs-12 col-sm-12 col-md-8 col-lg-8 table-responsive">
    <% students = @group.students %>
    <% if students.any? %>
      <h3><%= t('views.groups.show.student_list') %></h3>
      <table class="table table-striped">
        <tr>
          <th><%= t('activerecord.attributes.student.lastname') %></th>
          <th><%= t('activerecord.attributes.student.firstname') %></th>
          <th>Code</th>
          <th></th>
        </tr>
        <% students.each do |s| %>
          <tr>
            <td><%= s.lastname %></td>
            <td><%= s.firstname %></td>
            <td class="code"><%= s.code %></td>
            <td>
              <% if s.followers > 0 %><span class="glyphicon glyphicon-phone" aria-hidden="true"></span><% if s.followers > 1 %><sup><%= s.followers %></sup><% end %><% end %>
              <% if s.sent_message_by_email %><i class="fa fa-envelope"></i><% end %>
            </td>
          </tr>
        <% end %>
      </table>
    <% end %>

    <% writers = @group.writers.active_and_invitation_accepted %>
    <% if writers.any? %>
      <h3><%= t('views.groups.show.writers_list') %></h3>
      <table class="table table-striped">
        <tr>
          <th><%= t('activerecord.attributes.student.lastname') %></th>
          <th><%= t('activerecord.attributes.student.firstname') %></th>
        </tr>
        <% writers.each do |w| %>
          <tr>
            <td><%= w.lastname %></td>
            <td><%= w.firstname %></td>
          </tr>
        <% end %>
      </table>
    <% end %>
    <% if students.empty? and writers.empty? %>
        <%= t('views.groups.show.no_members') %>
    <% end %>
  </div>
  <div class="col-xs-12 col-sm-12 col-md-4 col-lg-4">
    <% if current_user.admin? %>
      <h3><%= t('views.groups.show.not_editable_group_title') %></h3>
      <p><%= t('views.groups.show.not_editable_group_help') %></p>
    <% end %>
  </div>
</div>
