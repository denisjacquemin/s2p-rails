<h1><%= t('views.groups.edit.title') %></h1>
<hr />
<div class="row">
  <div class="col-xs-12 col-sm-12 col-md-12 col-lg-12">
    <% if @group.updatable %>
      <%= render 'form', group: @group %>
    <% elsif %>
      <%= render 'form_readonly', group: @group %>
    <% end %>
  </div>
</div>
<div class="row" id="group_manage_students">
  <div class="col-xs-12 col-sm-12 col-md-12 col-lg-12">
    <%= render 'group_s_students_manager', group: @group %>
  </div>
</div>
