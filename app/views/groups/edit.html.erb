<h1 id="group-page"><%= t('views.groups.edit.title') %></h1>
<hr />
<%= form_for(@group) do |f| %>

<% if @group.updatable %>
<div class="row">
    <div class="col-xs-12 col-sm-12 col-md-12 col-lg-12">
        <%= render 'layouts/errors', object: @group %>
    </div>
</div>

<%
    submit_label = t('views.groups.new.submit')
    submit_label = t('views.groups.edit.submit') unless @group.new_record?
%>

<div class="row">
    <div class="col-xs-12 col-sm-12 col-md-12 col-lg-12">
        <span class="pull-right">
            <%= f.submit submit_label, class: 'btn btn-primary' %>
            <% unless @group.new_record? %>
            <%= link_to t('views.global.destroy'), @group, method: :delete, data: { confirm: t('views.global.areyousure') }, class: 'btn btn-danger' %>
            <% end %>
        </span>
    </div>
</div>
<div class="row">
    <div class="col-xs-12 col-sm-12 col-md-12 col-lg-12">
        <div class="form-group">
            <%= f.label :name %>
            <%= f.text_field :name, class: 'form-control' %>
        </div>
    </div>
</div>
<% elsif %>
  <%= render 'form_readonly', group: @group %>
<% end %>

<div class="row groups" id="groups-manager">
    <div class="col-xs-12 col-sm-12 col-md-5 col-lg-5">
        <div class="panel panel-default">
            <div class="panel-heading"><%= t('views.groups.listofstudents') %></div>
            <div class="panel-body table-responsive" id="student_list">
                <table id="users-datatable" class="table table-hover" data-source="<%= students_recipients_path(format: :json) %>">
                    <tbody>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    <div class="col-xs-12 col-sm-12 col-md-2 col-lg-2 buttons ">
        <%= button_tag(type: 'button', class: 'btn btn-primary', id: 'add') do
            concat 'Ajouter'
            concat content_tag(:span, nil, class: 'glyphicon glyphicon-chevron-right')
          end %>
        <%= button_tag(type: 'button', class: 'btn btn-primary', id: 'remove') do
            concat content_tag(:span, nil, class: 'glyphicon glyphicon-chevron-left')
            concat 'Enlever'
          end %>
    </div>
    <div class="col-xs-12 col-sm-12 col-md-5 col-lg-5">
        <div class="panel panel-default">
            <div class="panel-heading">Elèves du groupe</div>
            <div class="panel-body table-filter" id="in_groups_list">
            <input type="text" class="filter" data-table="#destinataires" placeholder="Rechercher">
            <div class="scroll-area">
              <table class="table table-hover table-condensed" id="in_group">
                <tbody class="list" id="destinataires">
                    <% @group.students.each do |s| %>
                        <tr>
                            <%= fields_for s do |s_form| %>
                                <%= s_form.hidden_field :id, multiple: true %>
                                <td class="nowrap"><input type="checkbox" id="student[<%= s.id %>]" /></td>
                                <td><%= s_form.label :id, "#{s.lastname} #{s.firstname}" %></td>
                                <td><%= "#{s.level} #{s.classroom}" %></td>
                            <% end %>
                        </tr>
                    <% end %>
                </tbody>
              </table>
            </div>
        </div>
    </div>
</div>
<% end %>