<div class="row groups">
  <%= form_for(group, url: {action: "update_students"}) do |g_form| %>
  <div class="col-xs-12 col-sm-12 col-md-5 col-lg-5">
    <div class="panel panel-default">
      <div class="panel-heading"><%= t('views.groups.listofstudents') %></div>
      <div class="panel-body table-responsive">
          <table class="table table-hover table-condensed" id="student_list">
            <thead>
              <th><input type="checkbox" /></th>
              <th>Nom - prenom</th>
              <th>Année - titulaire </th>
            </thead>
            <tbody>
              <% Student.default_order.by_school(@group.school_id).each do |s| %>
                <tr>
                  <td><input type="checkbox" value="<%= s.id %>"/></td>
                  <td><label class="fullname"><%= "#{s.lastname} #{s.firstname}" %></label></td>
                  <td><label class="classroom"><%= "#{s.level} - #{s.classroom}" %></label></td>
                </tr>
              <% end %>
            </tbody>
          </table>
      </div>
    </div>
  </div>
  <div class="col-xs-12 col-sm-12 col-md-2 col-lg-2 buttons">
    <div class="row">
        <div class="col-xs-12 col-sm-12 col-md-12 col-lg-12">
          <button type="button" class="btn" id="add" aria-label="Left Align">
            Ajouter
            <span class="glyphicon glyphicon-chevron-right" aria-hidden="true"></span>
          </button>
        </div>
        <div class="col-xs-12 col-sm-12 col-md-12 col-lg-12">
          <button type="button" class="btn" id="remove" aria-label="Left Align">
            <span class="glyphicon glyphicon-chevron-left" aria-hidden="true"></span>
            Enlever
          </button>
        </div>
      </div>
    <%= g_form.submit 'Enregistrer', class: 'btn btn-primary'%>
  </div>
  <div class="col-xs-12 col-sm-12 col-md-5 col-lg-5">

      <div class="panel panel-default">
        <div class="panel-heading">Elèves du groupe</div>
        <div class="panel-body table-responsive">
          <table class="table table-hover table-condensed" id="in_group">
            <thead>
              <th><input type="checkbox" /></th>
              <th>Nom - prenom</th>
              <th>Année - titulaire</th>
            </thead>
            <tbody>
              <% group.students.each do |s| %>
                <tr>
                  <%= fields_for s do |s_form| %>
                    <%= s_form.hidden_field :id, multiple: true%>
                    <td><input type="checkbox" id="student[<%= s.id %>]"/></td>
                    <td><%= s_form.label :id, "#{s.lastname} #{s.firstname}" %></td>
                    <td><%= "#{s.level} - #{s.classroom}" %></td>
                  <% end %>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>
  </div>
  <% end %>
</div>
