<h1>Groupes de diffusion
  <% if policy(:group).new? %>
    <div class="pull-right">
      <%= link_to t('views.groups.index.new'), new_group_path, class: 'btn btn-primary' %>
    </div>
  <% end %>
</h1>
<hr />
<div class="row">
    <div class="col-xs-12 col-sm-12 col-md-12 col-lg-12">
      <% if @groups.any? %>
        <table class="table table-striped table-hover">
          <thead>
            <tr>
              <th>Name</th>
              <th>Code</th>
              <% if current_user.superadmin? %>
                <th>Ecole</th>
              <% end %>
              <th># membres</th>
            </tr>
          </thead>

          <tbody>
            <% @groups.each do |group| %>
              <tr>
                <% if group.updatable %>
                  <td><%= link_to group.name , edit_group_path(group) %></td>
                <% else %>
                  <td><%= link_to group.name , group_path(group) %></td>
                <% end %>
                <td><%= group.code %></td>
                <% if current_user.superadmin? %>
                  <td><% if group.school.present? %><%= group.school.name %><% end %></td>
                <% end %>
                <td><%= group.students.size %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      <% else %>
        <% if current_user.admin? %>
          <p>Aucun groupe
            <% if policy(:group).new? %>
            , <%= link_to 'créer un groupe maintenant', new_group_path %>
            <% end %>
          </p>
        <% else %>
          <p><%= I18n.t('views.messages.groups_no_rights', admins: current_school.admins.map {|u| u.fullname}.join(', ')) %></p>
        <% end %>
      <% end %>
    </div>
</div>
