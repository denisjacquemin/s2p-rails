<div class="col-sm-12">
    <p>
            <div class="form-group form-check">
                <% checked_group = has_access_to_group(user, group_selected_id) %>

                <%= form_with(model: user, url: group_rights_for_report_path(user.id), local: false) do |f| %>
                    <%= f.hidden_field :group_id, value: group_selected_id %>
                    <div class="form-group">
                        <%= f.check_box 'allow_access', class: 'grouprightsforreport', checked: checked_group %>
                        <%= f.label 'allow_access', "Authoriser l'accès à cette classe" %>
                    </div>
                <% end %>
            </div>
        </p>

    <table class="table-striped table table-hover">
        <thead>	
            <tr>
                <th colspan="2">Accès aux matières? <a href="#">Tous / Aucun</a></th>
            </tr>	
        </thead>
        <tbody>
            <% 

                # checked = true if user.groups.pluck(:id).include?(group_selected_id.to_i)
            %>
            <% competencies.each do |competency| %>
                <% checked_competency = has_access_to_competency(user, group_selected_id, competency.id) %>
                <tr>
                    <td width="35px">
                        <%= form_with(model: user, url: competency_rights_for_report_path(user.id), local: false) do |f| %>
                            <%= f.hidden_field :competency_id, value: competency.id %>
                            <div class="form-group">
                                <%= f.check_box 'allow_access', class: 'competencyrightsforreport', checked: checked_competency %>
                            </div>
                        <% end %>
                    </td>
                    <td class="firstname level<%= competency.level %>"><%= competency.name %></td>
                </tr>
            <% end %>
        </tbody>
    </table>
    
</div>