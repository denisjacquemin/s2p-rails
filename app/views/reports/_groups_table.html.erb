<div class="col-sm-12">
    <div class="panel-group" id="accordion" role="tablist" aria-multiselectable="false">

        

        <% @groups.each do |group| %>
            <div class="panel panel-default">
                <div class="panel-heading" role="tab" id="headingOne">
                    <h4 class="panel-title">
                        <a class="truncate" style="width:70%" role="button" data-toggle="collapse" data-parent="#accordion" href="#<%= group.id %>" aria-expanded="true" aria-controls="collapseOne">
                            <strong><%=group.name%></strong>
                        </a>
                        <% if has_access_to_group(user, group.id) %>
                            <span class="pull-right">
                                <div class="form-group form-check">
                                    <i class="fas fa-check"></i>
                                </div>
                            </span>
                        <% end %>
                    </h4>
                </div>

                <div id="<%= group.id %>" class="panel-collapse collapse group-panel" role="tabpanel" aria-labelledby="<%= group.name %>">
                    <div class="panel-body">
                    </div>
                </div>

            </div>
        <% end %>
    </div>

</div>