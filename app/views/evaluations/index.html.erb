<div id="evaluations_screen">
  <div class="row">
    <div class="col-md-12">
      <h1>Encodage des cotes</h1>
      <hr />
    </div>
  </div>

  <div class="row">
    <div class="col-sm-12 col-md-4">
      <div class="form-group">
          <label>Classes</label>
          <%= select_tag "selected_group", options_from_collection_for_select(@groups, "id", "name"), class: 'form-control', include_blank: "Sélectionnez une classe" %>
      </div>
    </div>
    <div class="col-sm-12 col-md-4">
      <div class="form-group" >
        <div>
          <label>Périodes</label>
          <%= select_tag "selected_period", nil, prompt: 'Sélectionnez une classe', class: 'form-control' %>
        </div>
      </div>
    </div>
    <div class="col-sm-12 col-md-4">
      <div class="form-group">
          <label>Matières</label>
          <%= select_tag "selected_competency", nil, prompt: 'Sélectionnez une classe', class: 'form-control' %>
      </div>
    </div>
  </div>
  <hr />
  <div id="evaluations">
    <%= render 'choose_evaluations_filters' %>
  </div>
</div>

<%= render '/application/right_modal' %>
