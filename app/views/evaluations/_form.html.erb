<%= form_with(model: evaluation, local: false) do |form| %>
  <%= form.hidden_field 'period_id', value: @period_id %>
  <%= form.hidden_field 'competency_id', value: @competency_id %>
  <% if evaluation.errors.any? %>
    <div class="row">
      <div class="col-xs-12" id="error_explanation">
        <ul>
          <% evaluation.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    </div>
  <% end %>
  <div class="row">
      <div class="col-xs-12" >
        <div class="form-group">
          <%= form.label :description %>
          <%= form.text_field :description, class: 'form-control' %>
        </div>

        <div class="form-group">
          <%= form.label :weight, 'Pondération' %>
          <%= form.text_field :weight, class: 'form-control' %>
        </div>


        <div class="actions">
          <%= form.submit %>
        </div>
      </div>
<% end %>
