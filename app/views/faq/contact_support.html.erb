<div class="row help">
  <div class="col-xs-12 col-sm-12 col-md-2 col-lg-2">
    <%= render 'nav', active: 'creation_des_eleves' %>
  </div>
  <div class="col-xs-12 col-sm-12 col-md-10 col-lg-offset-1 col-lg-9">
        <h2 id="contacttitle">Contacter le support</h2>
        <%= form_tag('/submit_support', method: "post", remote: true) do %>
          <%= hidden_field_tag :authenticity_token, form_authenticity_token %>
            <div class="row">
                <div class="col-md-6">
                    <div class="form-group">
                      <%= label_tag 'Votre nom *' %>
                      <%= text_field_tag 'name', current_user.fullname, class: 'form-control', required: 'required' %>
                      <p class="help-block text-danger"></p>
                    </div>
                    <div class="form-group">
                      <%= label_tag 'Votre Email *' %>
                      <%= text_field_tag 'email', current_user.email, class: 'form-control', required: 'required' %>
                      <p class="help-block text-danger"></p>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                      <%= label_tag 'Votre message *' %>
                      <%= text_area_tag 'message', '', rows: 10, class: 'form-control', required: 'required', placeholder: 'Envoyez-nous vos suggestions, commentaires, commande de packs SMS ou questions'%>
                      <p class="help-block text-danger"></p>
                    </div>
                </div>
                <div class="clearfix"></div>
                <div class="col-lg-12 text-center">
                    <div id="success"></div>
                    <%= button_tag 'Envoyer', class: "btn btn-primary btn-lg", data: { disable_with: "<i class='fa fa-circle-o-notch fa-spin'></i> En cours d'envoi...".html_safe } %>
                </div>
            </div>
        <% end %>
    </div>
</div>
