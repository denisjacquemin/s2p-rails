<%= form_for(@user) do |f| %>
  <h1>
    <% if @user.id == current_user.id %>
      Mes infos personnelles
    <% else %>
      Rédacteurs
    <% end %>
    <div class="pull-right"><%= f.submit "Enregistrer", class: 'btn btn-primary' %></div>
  </h1>
  <hr />
  <div class="row user-edit">
      <div class="col-xs-12 col-sm-12 col-md-12 col-lg-12">

        <%= render 'layouts/errors', object: @user %>

          <div class="row">
            <div class="col-xs-12 col-sm-12 col-md-6 col-lg-6">
              <div class="form-group">
                <%= f.label :lastname %>
                <%= f.text_field :lastname, class: "form-control" %>
              </div>

            </div>
            <div class="col-xs-12 col-sm-12 col-md-6 col-lg-6">
              <div class="form-group">
                <%= f.label :firstname %>
                <%= f.text_field :firstname, class: "form-control" %>
              </div>
            </div>
          </div>
          <div class="row">
            <div class="col-xs-12 col-sm-12 col-md-6 col-lg-6">
              <div class="form-group">
                <%= f.label :email_reply_to, 'Email signature et répondre à' %>
                <%= f.text_field :email_reply_to, class: "form-control", value: @user.reply_to %>
                <%= f.check_box :display_email_address %> Afficher cette adresse email aux <%= current_school.iscity ? "citoyens" : "parents" %>
                <p class="help-block">Apparaît dans la signature des messages et comme adresse "répondre à" des emails.</p>
              </div>
            </div>
            <div class="col-xs-12 col-sm-12 col-md-6 col-lg-6">
              <div class="form-group">
                <%= f.label :phone, 'Téléphone (SMS)' %><br/>
                <input id="intlphonenumber" type="tel" class="form-control">
                <%= f.hidden_field :phone %>
                <p class="help-block">Utilisé pour envoyer une notification lorsqu'une demande d'approbation d'un message est envoyée, acceptée ou refusée.</p>
              </div>
            </div>
          </div>

          <div class="row">
            <% unless current_user.user? %>
            <div class="col-xs-12 col-sm-12 col-md-6 col-lg-6">
              <div class="form-group">
                <%= f.label :function, 'Fonction' %>
                <%= f.text_field :function, class: "form-control" %>
                <p class="help-block">Apparaît dans la signature des messages.</p>
              </div>
            </div>
            <% end %>
            <div class="col-xs-12 col-sm-12 col-md-6 col-lg-6">
              <div class="checkbox">
                <%= f.label :send_email_to_author do %>
                  <%= f.check_box :send_email_to_author %> M'envoyer un email lorsque je suis l'auteur du message.
                <% end %>
              </div>
              <% unless current_user.user? %>
              <div class="checkbox">
                <%= f.label :send_email_to_admin do %>
                  <%= f.check_box :send_email_to_admin %> En tant qu'administrateur, m'envoyer un email pour chaque message.
                <% end %>
              </div>
              <div class="checkbox">
                <%= f.label :send_notification_by_email do %>
                  <%= f.check_box :send_notification_by_email %> En tant qu'administrateur, m'envoyer un email lorsqu'un rédacteur demande une approbation.
                <% end %>
              </div>
              <% end %>
            </div>
          </div>



          <% unless current_user.user? %>
            <div class="row groups">
              <% if @user.user? %>
                <div class="col-xs-12 col-sm-12 col-md-6 col-lg-6 ">
                  <div class="panel panel-default">
                    <div class="panel-heading">
                      <h3>Droit d'accès aux groupes</h3>
                      <p>Le rédacteur peut envoyer un message uniquement aux élèves des groupes sélectionnés ci-dessous.</p>
                    </div>
                    <div class="panel-body">
                      <div class="tab-content">
                        <div role="tabpanel" class="tab-pane fade in active table-filter" id="groups">
                          <input type="text" class="filter" data-table="#user_group_list" placeholder="Rechercher">
                          Sélectionner <a href="#" id="select_all" data-target="user_group_list">Tout</a> - <a href="#" id="unselect_all" data-target="user_group_list">Aucun</a>
                          <div class="scroll-area">
                            <table class="table table-hover table-condensed">
                              <tbody id="user_group_list" class="list">
                              <%= hidden_field_tag "user[group_ids][]", nil %>
                              <%
                                @user.groups.each do |g|
                                  if g.school_id != current_school.id %>
                                      <%= hidden_field_tag "user[group_ids][]", g.id %>
                              <%
                                  end
                                end
                              %>

                              <%
                                  groups = Group.by_school(current_school)
                                  groups.each do |g| %>
                                  <tr>
                                    <td class="nowrap">
                                      <%= check_box_tag "user[group_ids][#{g.id}]",
                                         g.id,
                                         @user.groups.include?(g),
                                         name: 'user[group_ids][]' %>
                                    </td>
                                    <td class="fullwidth"><%= g.name %></td>
                                  </tr>
                                <% end %>
                              </tbody>
                            </table>
                          </div>
                        </div>
<% if false %>

                        <div role="tabpanel" class="tab-pane fade in table-filter" id="students">
                          <input type="text" class="filter" data-table="#user_student_list" placeholder="Rechercher">
                          <table class="table">
                            <tbody id="user_student_list">
                            <%= hidden_field_tag "user[student_ids][]", nil %>
                            <%
                                students = Student.default_order.by_school(current_school)
                                students.each do |s| %>
                                <tr>
                                  <td class="nowrap">
                                    <%= check_box_tag "user[student_ids][#{s.id}]",
                                     s.id,
                                     @user.students.include?(s),
                                     name: 'user[student_ids][]' %>
                                  </td>
                                  <td class="nowrap"><%= s.fullname %></td>
                                  <td class="fullwidth"><%= [s.level,s.classroom].join(' - ') %></td>
                                </tr>
                              <% end %>
                            </tbody>
                          </table>
                        </div>
<% end %>
                      </div>
                    </div>
                  </div>
                </div>
              <% end %>
                <div class="col-xs-12 col-sm-12 col-md-6 col-lg-6">
                  <% if (current_user.admin? or current_user.superadmin?) and current_user.schools.size > 1 %>
                    <div class="form-group">
                      <%= f.label :school, 'Implantation(s)' %>
                      <%= f.collection_check_boxes(:schools, current_user.schools_obj, :id, :name , {class: "form-control"})  do |b| %>
                        </br>
                        <%= b.check_box %>
                        <%= b.text %>
                      <% end %>
                    </div>
                  <% end %>
                  <% if current_user.admin? and current_user.schools.size === 1 %>
                    <div class="form-group">
                    <%= f.label :school, 'Implantation(s)' %>
                    Vous avez accès à une seule implantation.
                    </div>
                  <% end %>

                  <% roles = User.roles.keys %>
                  <% roles.delete "superadmin" if current_user.admin? %>
                  <div class="form-group">
                    <%= f.label :role %>
                    <%= f.select(:role, roles.map {|role| role === 'user'? ['Rédacteur', role] : [role.titleize,role]}, {}, {class: "form-control"})  %>
                  </div>
                </div>
              </div>
            <% end %>
      </div>
  </div>
<% end %>

<% if current_user.superadmin? %>
  <div class="form-group">
    <%= render "user_'_schools_manager", user: @user %>
  </div>
<% end %>
