<%= form_for(@user) do |f| %>
  <h1>Rédacteurs
    <div class="pull-right"><%= f.submit "Enregistrer", class: 'btn btn-primary' %></div>
  </h1>
  <hr />
  <div class="row user-edit">
      <div class="col-xs-12 col-sm-12 col-md-12 col-lg-12">

        <%= render 'layouts/errors', object: @user %>

          <div class="row">
            <div class="col-xs-12 col-sm-12 col-md-6 col-lg-6">
              <div class="form-group">
                <%= f.label :lastname %>
                <%= f.text_field :lastname, class: "form-control" %>
              </div>

            </div>
            <div class="col-xs-12 col-sm-12 col-md-6 col-lg-6">
              <div class="form-group">
                <%= f.label :firstname %>
                <%= f.text_field :firstname, class: "form-control" %>
              </div>
            </div>
          </div>
          <div class="row">
            <div class="col-xs-12 col-sm-12 col-md-6 col-lg-6">
              <div class="form-group">
                <%= f.label :email %>
                <%= f.text_field :email, class: "form-control" %>
                <p class="help-block">Apparaît dans la signature des messages et est l'adresse "répondre à" des emails.</p>
              </div>
            </div>
            <div class="col-xs-12 col-sm-12 col-md-6 col-lg-6">
              <div class="form-group">
                <%= f.label :function, 'Fonction' %>
                <%= f.text_field :function, class: "form-control" %>
                <p class="help-block">Apparaît dans la signature des messages.</p>
              </div>
            </div>
          </div>
          <div class="row">
            <div class="col-xs-12 col-sm-12 col-md-6 col-lg-6">
              <div class="form-group">
                <%= f.label :phone, 'Téléphone (SMS)' %><br/>
                <input id="intlphonenumber" type="tel" class="form-control">
                <%= f.hidden_field :phone %>
                <p class="help-block">Utilisé pour envoyer une notification lorsqu'une demande d'approbation d'un message est envoyée.</p>
              </div>
            </div>
          </div>
          <% unless @user.admin? %>
            <div class="row groups">
                <div class="col-xs-12 col-sm-12 col-md-6 col-lg-6 ">
                  <div class="panel panel-default">
                    <div class="panel-heading">
                      <h3>Droit d'accès aux groupes d'élèves</h3>
                      <p>Le rédacteur peut envoyer un message uniquement aux groupes d'élèves sélectionnés ci-dessous.</p>
                    </div>
<% if false %>
                    <div class="panel-heading">
                      <ul class="nav nav-pills">
                        <li role="presentation" class="active"><a data-toggle="pill" href="#groups"><i class="fa fa-users"></i> Groupes</a></li>
                        <li role="presentation"><a data-toggle="pill" href="#students"><i class="fa fa-user"></i> Elèves</a></li>
                      </ul>
                    </div>
<% end %>
                    <div class="panel-body">
                      <div class="tab-content">
                        <div role="tabpanel" class="tab-pane fade in active table-filter" id="groups">
                          <input type="text" class="filter" data-table="#user_group_list" placeholder="Rechercher">
                          <table class="table table-hover table-condensed">
                            <tbody id="user_group_list" class="list">
                            <%= hidden_field_tag "user[group_ids][]", nil %>
                            <%
                                groups = Group.by_school(current_school)
                                groups.each do |g| %>
                                <tr>
                                  <td class="nowrap">
                                    <%= check_box_tag "user[group_ids][#{g.id}]",
                                       g.id,
                                       @user.groups.include?(g),
                                       name: 'user[group_ids][]' %>
                                  </td>
                                  <td class="fullwidth"><%= g.name %></td>
                                </tr>
                              <% end %>
                            </tbody>
                          </table>
                        </div>
<% if false %>

                        <div role="tabpanel" class="tab-pane fade in table-filter" id="students">
                          <input type="text" class="filter" data-table="#user_student_list" placeholder="Rechercher">
                          <table class="table">
                            <tbody id="user_student_list">
                            <%= hidden_field_tag "user[student_ids][]", nil %>
                            <%
                                students = Student.by_school(current_school)
                                students.each do |s| %>
                                <tr>
                                  <td class="nowrap">
                                    <%= check_box_tag "user[student_ids][#{s.id}]",
                                     s.id,
                                     @user.students.include?(s),
                                     name: 'user[student_ids][]' %>
                                  </td>
                                  <td class="nowrap"><%= s.fullname %></td>
                                  <td class="fullwidth"><%= [s.level,s.classroom].join(' - ') %></td>
                                </tr>
                              <% end %>
                            </tbody>
                          </table>
                        </div>
<% end %>
                      </div>
                    </div>
                  </div>
                </div>
                <div class="col-xs-12 col-sm-12 col-md-6 col-lg-6">
                  <% if current_user.admin? and current_user.schools.size > 1 %>
                    <div class="form-group">
                      <%= f.label :school, 'Implantation(s)' %>
                      <%= f.collection_check_boxes(:schools, current_user.schools_obj, :id, :name , {class: "form-control"})  do |b| %>
                        </br>
                        <%= b.check_box %>
                        <%= b.text %>
                      <% end %>
                    </div>
                  <% end %>
                  <% if current_user.admin? and current_user.schools.size === 1 %>
                    <div class="form-group">
                    <%= f.label :school, 'Implantation(s)' %>
                    Vous avez accès à une seule implantation.
                    </div>
                  <% end %>

                  <% roles = User.roles.keys %>
                  <% roles.delete "superadmin" if current_user.admin? %>
                  <div class="form-group">
                    <%= f.label :role %>
                    <%= f.select(:role, roles.map {|role| role === 'user'? ['Rédacteur', role] : [role.titleize,role]}, {}, {class: "form-control"})  %>
                  </div>
                </div>
              </div>
            <% end %>
      </div>
  </div>
<% end %>

<% if current_user.superadmin? %>
  <div class="form-group">
    <%= render "user_'_schools_manager", user: @user %>
  </div>
<% end %>
