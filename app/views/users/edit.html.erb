<h1>Utilisateurs</h1>
<hr />
<div class="row">
    <div class="col-xs-12 col-sm-12 col-md-12 col-lg-12">
      <%= form_for(@user) do |f| %>
      <%= render 'layouts/errors', object: @user %>
        <div class="form-group">
          <%= f.label :lastname %>
          <%= f.text_field :lastname, class: "form-control" %>
        </div>
        <div class="form-group">
          <%= f.label :firstname %>
          <%= f.text_field :firstname, class: "form-control" %>
        </div>
        <div class="form-group">
          <%= f.label :email %>
          <%= f.text_field :email, class: "form-control" %>
        </div>
        <% if current_user.admin? and current_user.schools.size > 1 %>
          <div class="form-group">
            <%= f.label :school, 'Implentation(s)' %>
            <%= f.collection_check_boxes(:schools, current_user.schools_obj, :id, :name , {class: "form-control"})  do |b| %>
              </br>
              <%= b.check_box %>
              <%= b.text %>
            <% end %>
          </div>
        <% end %>
        <% roles = User.roles.keys %>
        <% roles.delete "superadmin" if current_user.admin? %>
        <div class="form-group">
          <%= f.label :role %>
          <%= f.select(:role, roles.map {|role| role === 'user'? ['Rédacteur', role] : [role.titleize,role]}, {}, {class: "form-control"})  %>
        </div>

        <div class="form-group">
          <%= f.label :function, 'Fonction' %>
          <%= f.text_field :function, class: "form-control" %>
        </div>

        <%= f.submit "Sauver", class: 'btn btn-primary' %>
      <% end %>
      <% if current_user.superadmin? %>
        <div class="form-group">
          <%= render "user_'_schools_manager", user: @user %>
        </div>
      <% end %>
    </div>
</div>
