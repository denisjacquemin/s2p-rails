<h1>Rédacteurs
  <div class="pull-right">
    <%= link_to 'Nouvelle invitation', new_user_invitation_path, class: 'btn btn-primary' %>
  </div>
</h1>
<hr />
<div class="row">
    <div class="col-xs-12 col-sm-12 col-md-12 col-lg-12">
      <table class="table table-striped table-hover">
        <thead>
          <tr>
            <th>Nom - Prénom</th>
            <th>Email</th>
            <th>Ecole(s)</th>
            <th>Code</th>
            <th>Statut Invitation</th>
            <th colspan="3"></th>
          </tr>
        </thead>

        <tbody>
          <% @users.each do |user| %>
            <tr>
              <td><%= link_to "#{user.lastname} #{user.firstname}", edit_user_path(user) %></td>
              <td><%= link_to user.email, edit_user_path(user) %></td>
              <td><% if user.schools.any? %><%= School.find(user.schools).pluck(:name).join(', ') %><% end %></td>
              <td><%= user.code %></td>
              <td><%= user.invitation_status %></td>
              <% if user.active? && user.invitation_status === "En attente" %>
                <td><%= link_to "Renvoyer l'invitation", resend_invite_path(user), class: 'btn btn-default btn-xs' %>
              <% else %>
                <td colspan="2"><% unless user.active? %>Inactif<% end %></td>
              <% end %>
              <td>
                <% if policy(user).destroy? %>
                  <%= link_to t('views.global.destroy'), user, method: :delete, data: { confirm: t('views.global.areyousure') },  class: 'btn btn-default btn-xs' %></td>
                <% end %>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
</div>
<br>
