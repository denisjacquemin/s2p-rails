<h1>Utilisateurs
  <div class="pull-right">
    <%= link_to 'Nouvelle invitation', new_user_invitation_path, class: 'btn btn-primary' %>
  </div>
</h1>
<hr />
<div class="row">
    <div class="col-xs-12 col-sm-12 col-md-12 col-lg-12">
      <table class="table table-striped table-hover">
        <thead>
          <tr>
            <th>Name</th>
            <th>Email</th>
            <th>Ecole(s)</th>
            <th>Statut Invitation</th>
            <th colspan="3"></th>
          </tr>
        </thead>

        <tbody>
          <% @users.each do |user| %>
            <tr>
              <td><%= link_to "#{user.firstname} #{user.lastname}", edit_user_path(user) %></td>
              <td><%= link_to user.email, edit_user_path(user) %></td>
              <td><% if user.schools.any? %><%= School.find(user.schools).pluck(:name).join(', ') %><% end %></td>
              <td><%= user.invitation_status %></td>
              <td><%= link_to "Renvoyer l'invitation", resend_invite_path(user), class: 'btn btn-default btn-xs' %>
              <td><%= link_to t('views.global.destroy'), user, method: :delete, data: { confirm: t('views.global.areyousure') },  class: 'btn btn-default btn-xs' %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
</div>
<br>
