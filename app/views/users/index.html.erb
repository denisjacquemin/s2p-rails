<h1>Utilisateurs</h1>
<hr />
<div class="row">
    <div class="col-xs-12 col-sm-12 col-md-12 col-lg-12">
      <table class="table table-striped table-hover">
        <thead>
          <tr>
            <th>Name</th>
            <th>Email</th>
            <% if current_user.superadmin? %>
              <th>Ecole</th>
            <% end %>
            <th>Statut Invitation</th>
            <th colspan="3"></th>
          </tr>
        </thead>

        <tbody>
          <% @users.each do |user| %>
            <tr>
              <td><%= user.firstname %> <%= user.lastname %></td>
              <td><%= user.email %></td>
              <% if current_user.superadmin? %>
              <td><% if user.school.present? %><%= user.school.name %><% end %></td>
              <% end %>
              <td><%= user.invitation_status %></td>
              <td><%= link_to 'Edit', edit_user_path(user) %></td>
              <td><%= link_to 'Destroy', user, method: :delete, data: { confirm: 'Are you sure?' } %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
</div>
<br>

<%= link_to 'Nouvelle invitation', new_user_invitation_path, class: 'btn btn-primary' %>
