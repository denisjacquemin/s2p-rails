<div class="link-back"><%= link_to content_tag(:span, nil, class: "glyphicon glyphicon-chevron-left", aria_hidden: true) + 'Retour à la liste des messages', messages_path %></div>
<h1 class="hidden-xs" style="position:relative" id="message-page">
  Edition message
  <small><%= render 'status', message: @message %>
    <span class="hidden-xs pull-right" style="text-align:right;position:absolute;bottom:0;right:0;font-size:70%">
      Auteur: <%= @message.author.fullname %>
      <br/>Dernière mise à jour <%= I18n.l(@message.updated_at, format: :short)%>
    </span>
  </small></h1>
<hr class="hidden-xs" />
<%= render 'form', {message: @message } %>
<div class="modal fade" id="schedule_sending" tabindex="-1" role="dialog">
  <div class="modal-dialog" role="document">
    <div class="modal-content">
      <div class="modal-header">
        <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
        <h4 class="modal-title">Planifier l'envoi du message</h4>
      </div>
      <div class="modal-body" >
        <div style="overflow:hidden;">
          <div class="form-group">
              <div class="row">
                  <div class="col-md-12">
                    <div>
                      <div id="datetimepicker12">
                        <input type='hidden' id="theDate" />
                      </div>
                    </div>
                  </div>
              </div>
          </div>
          <script type="text/javascript">
              $(function () {
                  $('#datetimepicker12').datetimepicker({
                      inline: true,
                      sideBySide: true,
                      stepping: 10,
                      minDate: moment(),
                      showTodayButton: true,
                      locale: 'fr',
                      format: 'YYYY-MM-DD HH:mm',
                      <% unless @message.scheduled_publish.blank? %>
                      defaultDate: '<%= @message.scheduled_publish.strftime('%Y/%m/%d %H:%M') %>'
                      <% end %>
                  });
              });
          </script>
      </div>
      </div>
      <div class="modal-footer">
        <input type="button" class="btn btn-default" data-dismiss="modal" value="Annuler">
        <input type="button" class="btn btn-primary" id="save_scheduled_date" data-disable-with="Enregistrement..." value="Enregistrer">
      </div>
    </div><!-- /.modal-content -->
  </div><!-- /.modal-dialog -->
</div><!-- /.modal -->