<%= link_to content_tag(:span, nil, class: "glyphicon glyphicon-send", aria_hidden: true) + 'Réenvoyer', "", 'data-status': 'republished', class: "submit_with_status icon", data: {'before-submit-confirm': true,message: "Ce message va être réenvoyé, êtes vous sûr?", title: 'Réenvoie du message'} %>
<% if current_school.id == 10 %>
    <%= link_to content_tag(:span, nil, class: "glyphicon glyphicon-hourglass", aria_hidden: true) + "Planifier l'envoi", "", 'data-status': 'published', class: "schedule_sending icon", data: {'before-submit-confirm': true,message: "Ce message va être envoyé, êtes vous sûr?", title: 'Publication du message'} %>
<% end %>