<% 
    message = "Ce message va être envoyé, êtes vous sûr?"
    show_nbr_recipients = false
    if current_school.new_recipients_selection? and ![3592, 2471, 3088].include?(current_user.id) 
        message = "Ce message va être envoyé à <strong class='highlight'>#</strong> élève(s), êtes vous sûr?"
        show_nbr_recipients = true
    end
%>
<%= link_to content_tag(:span, nil, class: "glyphicon glyphicon-send", aria_hidden: true) + 'Publier', "", 'data-status': 'published', class: "submit_with_status icon %s" % ('show_nbr_recipients' if show_nbr_recipients), data: {'before-submit-confirm': true, message: message, title: 'Publication du message'} %>

<% if current_school.message_scheduling_enable and @message.mtype == "message" %>
    <%= link_to content_tag(:span, nil, class: "glyphicon glyphicon-hourglass", aria_hidden: true) + "Planifier l'envoi", "", 'data-status': 'scheduled', class: "schedule_sending icon", title: 'Publication du message' %>
<% end %>
