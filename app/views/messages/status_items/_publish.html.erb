<%= link_to content_tag(:span, nil, class: "glyphicon glyphicon-send", aria_hidden: true) + 'Publier', "", 'data-status': 'published', class: "submit_with_status icon", data: {'before-submit-confirm': true, message: "Ce message va être envoyé, êtes vous sûr?", title: 'Publication du message'} %>
<% if current_school.message_scheduling_enable and @message.mtype == "message" %>
    <%= link_to content_tag(:span, nil, class: "glyphicon glyphicon-hourglass", aria_hidden: true) + "Planifier l'envoi", "", 'data-status': 'scheduled', class: "schedule_sending icon", title: 'Publication du message' %>
<% end %>
