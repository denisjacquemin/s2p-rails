<div class="row">
  <div class="col-xs-8">
    <div class="row files">
      <div class="col-xs-12">
        <h2>Images</h2>
      </div>
      <%= hidden_field_tag 'message_id', message.id %>
      <% if message.mfiles.any? %>
        <% message.mfiles.each do |mfile| %>
          <%= render 'file', mfile: mfile %>
        <% end %>
      <% else %>
        <div class="col-xs-12">
          <div class="alert alert-info" role="alert">
            Pas encore d'image associé a ce message<br>
            Ajoutez une image maintenant
          </div>
        </div>
      <% end %>
    </div>
  </div>
  <div class="col-xs-4">
    <%= form_for(mfile, html: { class: "directUpload", data: { 'form-data' => (@s3_direct_post.fields), 'url' => @s3_direct_post.url, 'host' => URI.parse(@s3_direct_post.url).host } }) do |f| %>
      <% if mfile.errors.any? %>
        <div id="error_explanation">
          <h2><%= pluralize(mfile.errors.count, "error") %> prohibited this mfile from being saved:</h2>

          <ul>
          <% mfile.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
          </ul>
        </div>
      <% end %>
      <h2>Nouvelles images</h2>
      <div class="field">
        <%= f.file_field :file_url, multiple: true %>
      </div>
    <% end %>
  </div>
</div>
