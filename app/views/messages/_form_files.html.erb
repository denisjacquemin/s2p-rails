<div class="row">
  <div class="col-xs-12 col-sm-8 col-md-8 col-lg-8">
    <%= form_for(mfile, html: { class: "directUpload", data: { 'form-data' => (@s3_direct_post.fields), 'url' => @s3_direct_post.url, 'host' => URI.parse(@s3_direct_post.url).host } }) do |f| %>
      <% if mfile.errors.any? %>
        <div id="error_explanation">
          <h2><%= pluralize(mfile.errors.count, "erreur") %> empêche l'enregistrement de ce message:</h2>

          <ul>
          <% mfile.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
          </ul>
        </div>
      <% end %>
      <div class="field">
        <%= f.file_field :file_url, multiple: true %>
      </div>
    <% end %>
    <%= hidden_field_tag 'message_id', message.id %>
    <% if message.mfiles.any? %>
      <br/>
      <% message.mfiles.each do |mfile| %>
        <%= render '/mfiles/file', mfile: mfile %>
      <% end %>
    <% else %>
      <p>Pas encore d'image associé à ce message</p>
    <% end %>
  </div>
  <div class="col-xs-12 col-sm-4 col-md-4 col-lg-4">
    <h3>Importer des images</h3>
    <p>Il est possible d'attacher des images à un message. Elles sont visibles uniquement via l'application mobile, elles ne sont pas transmises par email.</p>

  </div>
</div>
