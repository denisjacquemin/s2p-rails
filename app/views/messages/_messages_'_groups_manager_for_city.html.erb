<div class="alert alert-info" style="color: #31708f;background-color: #d9edf7;border-color:#bce8f1;" role="alert">
  La liste des destinataires n'est plus modifiable une fois le message passé en statut <em>Publié</em>.
</div>
<div class="row groups" id="messages-groups-manager">
    <div class="col-xs-12 col-sm-12 col-md-5 col-lg-5">
      <div class="panel panel-default">
        <div class="panel-heading">
          <ul class="nav nav-pills">
            <li role="presentation" class="active"><a data-toggle="pill" href="#city"><i class="fa fa-users"></i> Villes</a></li>
            <li role="presentation"><a data-toggle="pill" href="#street"><i class="fa fa-user"></i> Rues</a></li>
            <li role="presentation"><a data-toggle="pill" href="#students"><i class="fa fa-user"></i> Citoyens</a></li>
          </ul>
        </div>
        <div class="panel-body ">
          <div class="tab-content">
            <div role="tabpanel" class="tab-pane fade in active table-filter" id="city">

              <% groups = current_user.groups_by_school(current_school.id).only_level.pluck(:id, :name) %>
              <% if groups.present? %>
                <input type="text" class="filter" data-table="#city_list" placeholder="Rechercher">
                <div class="scroll-area">
                  <table class="table table-hover table-condensed" id="city_list">
                    <% groups.each do |group| %>
                      <tr>
                        <td class="nowrap">
                          <%= check_box_tag "gr_#{group[0]}", group[0], nil, disabled: (message.published? ? true : nil) %>
                        </td>
                        <td class="groupname fullwidth"><label for="<%= "gr_#{group[0]}" %>"><%= group[1] %></label></td>
                      </tr>
                    <% end %>
                  </table>
                </div>
              <% end %>
              <% if groups.empty? %>
                <p><%= I18n.t('views.messages.groups_no_rights', admins: current_school.admins.map {|u| u.fullname}.join(', ')) %></p>
              <% end %>
            </div>
            <div role="tabpanel" class="tab-pane fade in table-filter" id="street">

              <% groups = current_user.groups_by_school(current_school.id).only_classroom.pluck(:id, :name) %>
              <% if groups.present? %>
                <input type="text" class="filter" data-table="#classroom_list" placeholder="Rechercher">
                <div class="scroll-area">
                  <table class="table table-hover table-condensed" id="classroom_list">
                    <% groups.each do |group| %>
                      <tr>
                        <td class="nowrap">
                          <%= check_box_tag "gr_#{group[0]}", group[0], nil, disabled: (message.published? ? true : nil) %>
                        </td>
                        <td class="groupname fullwidth"><label for="<%= "gr_#{group[0]}" %>"><%= group[1] %></label></td>
                      </tr>
                    <% end %>
                  </table>
                </div>
              <% end %>
              <% if groups.empty? %>
                <p><%= I18n.t('views.messages.groups_no_rights', admins: current_school.admins.map {|u| u.fullname}.join(', ')) %></p>
              <% end %>
            </div>
            <div role="tabpanel" class="tab-pane fade in table-filter" id="students">
              <% students = current_user.students_by_school(current_school.id).pluck(:id, :firstname, :lastname, :level, :classroom) %>
              <% if students.present? %>
                <input type="text" class="filter" data-table="#student_list" placeholder="Rechercher">
                <div class="scroll-area">
                  <table class="table table-hover table-condensed" >
                    <tbody id="student_list" class="list">
                      <% students.each do |student| %>
                        <tr>
                          <td class="nowrap">
                            <%= check_box_tag "cb_#{student[0]}", student[0], nil, disabled: (message.published? ? true : nil) %>
                          </td>
                          <td class="ctb studentfullname nowrap"><label for="cb_<%= student[0]%>"><%= student[1] %> <%= student[2] %></label></td>
                          <td class="ctb studentfulllevel nowrap"><label for="cb_<%= student[0]%>"><%= student[3] %></label></td>
                          <td class="ctb studentclassroom fullwidth"><label for="cb_<%= student[0]%>"><%= student[4] %></label></td>
                        </tr>
                      <% end %>
                    </tbody>
                  </table>
                </div>
              <% end %>
              <% if students.empty? %>
                <p><%= I18n.t('views.messages.students_no_rights', admins: current_school.admins.map {|u| u.fullname}.join(', ')) %></p>
              <% end %>
            </div>
          </div>
        </div>
      </div>
    </div>
    <div class="col-xs-12 col-sm-12 col-md-2 col-lg-2 buttons">
      <div class="row groups">
            <div class="col-xs-12 col-sm-12 col-md-12 col-lg-12">
              <%= button_tag(type: 'button', class: 'btn btn-primary', id: 'add', disabled: (message.published? ? true : nil)) do
                concat 'Ajouter'
                concat content_tag(:span, nil, class: 'glyphicon glyphicon-chevron-right')
              end %>
            </div>
            <div class="col-xs-12 col-sm-12 col-md-12 col-lg-12">
              <%= button_tag(type: 'button', class: 'btn btn-primary', id: 'remove', disabled: (message.published? ? true : nil)) do
                concat content_tag(:span, nil, class: 'glyphicon glyphicon-chevron-left')
                concat 'Enlever'
              end %>
            </div>
        </div>
    </div>
    <div class="col-xs-12 col-sm-12 col-md-5 col-lg-5">
        <div class="panel panel-default">
          <div class="panel-heading">
            <h4>Destinataires sélectionnés</h4>
          </div>
          <div class="panel-body table-filter" id="in_groups_list">
            <input type="text" class="filter" data-table="#destinataires" placeholder="Rechercher">
            <div class="scroll-area">
              <table class="table table-hover table-condensed" id="in_groups">
                <tbody class="list" id="destinataires">
                  <% message.groups_obj.each do |g| %>
                    <tr>
                      <%= fields_for g do |g_form| %>
                        <%= g_form.hidden_field :id, multiple: true%>
                        <td class="nowrap">
                          <%= check_box_tag "group_#{g.id}", "group[#{g.id}]", nil, disabled: (message.published? ? true : nil) %>
                        </td>
                        <td class="targetname fullwidth" colspan="3"><i class="fa fa-users" style="margin-right: 5px;"></i><label for="<%= "group_#{g.id}" %>"><%= g.name %></label></td>
                      <% end %>
                    </tr>
                  <% end %>
                  <% message.students_obj.each do |s| %>
                    <tr>
                      <%= fields_for s do |s_form| %>
                        <%= s_form.hidden_field :id, multiple: true%>

                        <td class="nowrap">
                          <%= check_box_tag "student_#{s.id}", "student[#{s.id}]", nil, disabled: (message.published? ? true : nil) %>
                        </td>
                        <td class="studentfullname nowrap"><i class="fa fa-user" style="margin-right: 5px;"></i> <label for="<%= "student_#{s.id}" %>"><%= s.fullname %></label></td>
                        <td class="studentfulllevel nowrap"><label for="<%= "student_#{s.id}" %>"><%= s.level %></label></td>
                        <td class="studentclassroom fullwidth"><label for="<%= "student_#{s.id}" %>"><%= s.classroom %></label></td>
                      <% end %>
                    </tr>
                  <% end %>
                </tbody>
              </table>
            </div>
          </div>
        </div>
    </div>
</div>
