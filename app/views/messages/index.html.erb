<%= hidden_field_tag 'algolia_search_api_key', @algolia_search_api_key %>
<%= hidden_field_tag 'current_school_id', @current_school_id %>
<%= hidden_field_tag 'worflow_active', @workflow_active %>
<%= hidden_field_tag 'role', @current_user_role %>

<div class="row algolia_js algolia algolia_messages">
  <div class="col-xs-12 col-sm-12 col-md-12 col-lg-12">
    <div class="row">
      <div class="col-xs-12 col-sm-7 col-md-7 col-lg-7">
        <h1>Messages</h1>
      </div>
      <div class="col-xs-12 col-sm-5 col-md-5 col-lg-5">
        <%= link_to 'Nouveau message', new_message_path, class: 'btn btn-primary fab visible-xs' %>
        <div class="pull-right hidden-xs">
          <%= link_to 'Nouveau message', new_message_path, class: 'btn btn-primary' %>
        </div>
      </div>
      <div class="col-xs-12">
        <hr />
      </div>
    </div>
  </div>
  <div class="col-xs-12 col-sm-12 col-md-12 col-lg-12">
    <div class="row">
      <div class="col-xs-12 col-sm-12 col-md-12 col-lg-12">
        <div id="search-input"></div>
        <div id="search-input-icon"></div>
      </div>
      <div class="col-xs-12 col-sm-12 col-md-12 col-lg-12">
        <main>
          <div id="hits" class="hits" style='display:none;'>
            <div class="spinner">
              <div class="bounce1"></div>
              <div class="bounce2"></div>
              <div class="bounce3"></div>
            </div>
          </div>
          <div id="latest_messages" class="hits">
            <% @latest_messages.each do |message| %>
            <div class="ais-hits--item">
              <div class="hit row">
                <div class="col-xs-12 col-sm-12 col-md-12 col-lg-12">
                  <div class="hit-content" data-message-id="<%= message.id %>">
                    <div class="row">
                      <div class="title-and-content col-xs-12 col-sm-8 col-md-8 col-lg-10" data-message-id="<%= message.id %>">
                          <div class="row">
                            <div class="col-xs-12"><div><span class="title"><%= message.title %> <% if message.has_form %><i class="material-icons" rel="tooltip" data-toggle="tooltip" data-placement="top" title="Contient un formulaire">rate_review</i><% end %></span></div></div>
                            <div class="visible-xs col-xs-4 col-xs-offset-8"><span title="" class="pull-right label {{{status}}}"> </span></div>
                            <% if message.content.present? %>
                            <div class="col-xs-12"><div class="content"><%= strip_tags(message.content.truncate(200)) %></div></div>
                            <% end %>
                            <div class="col-xs-12">
                              <div class="meta">
                                <i class="fa fa-user-o"></i> <span class="author"><%= message.author.fullname %></span>
                                - <i class="fa fa-clock-o"></i> <%= message.last_update_meta %>
                              </div>
                            </div>
                          </div>
                      </div>
                      <div class="label-container hidden-xs col-sm-4 col-md-4 col-lg-2">
                        <span title="" class="label <%= message.status %>">&nbsp;</span>
                        <div class="btn-group" rel="tooltip" data-toggle="tooltip" data-placement="top" title="Actions">
                          <a href="#" class="btn btn-sm dropdown-toggle" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false" data-status="<%= message.status %>" data-message-id="<%= message.id %>">
                            <i class="material-icons">more_vert</i>
                          </a>
                          <ul class="dropdown-menu pull-right">
                          </ul>
                        </div>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
            <% end %>
          </div>
          <div id="pagination"></div>
        </main>
        <script type="text/html" id="hit-template">
          <div class="hit row">
            <div class="col-xs-12 col-sm-12 col-md-12 col-lg-12">
              <div class="hit-content" data-message-id="{{{objectID}}}">
                <div class="row">
                  <div class="title-and-content col-xs-12 col-sm-8 col-md-8 col-lg-10" data-message-id="{{{objectID}}}">
                      <div class="row">
                        <div class="col-xs-12"><div><span class="title">{{{_highlightResult.title.value}}} {{#has_form}}<i class="material-icons" rel="tooltip" data-toggle="tooltip" data-placement="top" title="Contient un formulaire">rate_review</i>{{/has_form}}</span></div></div>
                        <div class="visible-xs col-xs-4 col-xs-offset-8"><span title="" class="pull-right label {{{status}}}"> </span></div>
                        {{#content}}
                        <div class="col-xs-12"><div class="content">{{{_snippetResult.content.value}}}...</div></div>
                        {{/content}}
                        <div class="col-xs-12">
                          <div class="meta">
                            <i class="fa fa-user-o"></i> <span class="author">{{{_highlightResult.author_fullname.value}}}</span>
                            - <i class="fa fa-clock-o"></i> {{last_update_meta}}
                          </div>
                        </div>
                      </div>
                  </div>
                  <div class="label-container hidden-xs col-sm-4 col-md-4 col-lg-2">
                    <span title="" class="label {{{status}}}">&nbsp;</span>
                    <div class="btn-group" rel="tooltip" data-toggle="tooltip" data-placement="top" title="Actions">
                      <a href="#" class="btn btn-sm dropdown-toggle" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false" data-status={{status}} data-message-id="{{{objectID}}}">
                        <i class="material-icons">more_vert</i>
                      </a>
                      <ul class="dropdown-menu pull-right">
                      </ul>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </script>
        <script type="text/html" id="message_status-template">
          if('published' =={{status}}) {
            console.log 'published'
          }
        </script>
        <script type="text/html" id="stats-template">
            <div data-reactroot="" class="ais-root ais-stats">
              <div class="ais-body ais-stats--body">
                <div>
                  {{nbHits}} messages trouvés
                </div>
              </div>
            </div>
        </script>
        <script type="text/html" id="no-results-template">
          <div id="no-results-message">
            <p>Aucun message correspondant <em>"{{query}}"</em>.</p>
          </div>
        </script>
      </div>
    </div>
  </div>
</div>
