<h1>Messages
  <div class="pull-right">
    <%= link_to 'Nouveau message', new_message_path, class: 'btn btn-primary' %>
  </div>
</h1>
<hr />
<div class="row">
    <div class="col-xs-12 col-sm-12 col-md-12 col-lg-12">
      <%= hidden_field_tag 's', @school_id %>
      <% if @messages.any? %>

        <table class="table table-striped table-hover">
          <thead>
            <tr>
              <th>Titre</th>
              <th>Contenu</th>
              <% if current_user.superadmin? %>
                <th>Ecole</th>
              <% end %>
              <th>#vue</th>
              <th>Auteur</th>
              <th>Statut</th>
              <th></th>
            </tr>
          </thead>

          <tbody>
            <% @messages.each do |message| %>
              <tr>
                <td><%= link_to truncate(message.title, :length => 200), edit_message_path(message) %></td>
                <% if message.mtype == 'rappel' %>
                  <td><%= link_to message.when, edit_message_path(message) %></td>
                <% else %>
                  <td><%= link_to truncate(strip_tags(message.content), :length => 200), edit_message_path(message) %></td>
                <% end %>
                <% if current_user.superadmin? %>
                  <td><% if message.school.present? %><%= message.school.name %><% end %></td>
                <% end %>
                <td class="counter" id="nbr<%= message.id %>">-</td>
                <td><%= message.author_fullname %></td>
                <td><%= render 'status', message: message %></td>
                <td>
                  <div class="btn-group">
                    <button class="btn btn-xs dropdown-toggle" type="button" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                      Actions <span class="caret"></span>
                    </button>
                    <ul class="dropdown-menu">
                      <li><%= render 'change_status_link', message: message %></li>
                    </ul>
                  </div>
              </tr>
            <% end %>
          </tbody>
        </table>
      <% else %>
        <p>Aucun message, <%= link_to 'créer un message maintenant', new_message_path %></p>
      <% end %>
    </div>
</div>
