<h1>Messages</h1>
<hr />
<div class="row">
    <div class="col-xs-12 col-sm-12 col-md-12 col-lg-12">
      <table class="table table-striped table-hover">
        <thead>
          <tr>
            <th>Title</th>
            <th>Content</th>
            <% if current_user.superadmin? %>
              <th>School</th>
            <% end %>
            <th colspan="3"></th>
          </tr>
        </thead>

        <tbody>
          <% @messages.each do |message| %>
            <tr>
              <td><%= message.title %></td>
              <td><%= truncate(message.content, :length => 200) %></td>
              <% if current_user.superadmin? %>
                <td><% if message.school.present? %><%= message.school.name %><% end %></td>
              <% end %>
              <td><%= link_to 'Publier', publish_message_path(message), :method=> :patch, class: 'btn btn-primary btn-sm' %></td>
              <td><%= link_to 'Edit', edit_message_path(message) %></td>
              <td><%= link_to 'Destroy', message, method: :delete, data: { confirm: 'Are you sure?' } %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
</div>

<%= link_to 'New Message', new_message_path, class: 'btn btn-primary' %>
