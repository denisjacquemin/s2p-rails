<%= hidden_field_tag 'algolia_search_api_key', @algolia_search_api_key %>
<%= hidden_field_tag 'current_school_id', @current_school_id %>
<div class="row algolia_js algolia">
  <div class="col-xs-12 col-sm-12 col-md-12 col-lg-12">
    <div class="row">
      <div class="col-xs-12 col-sm-7 col-md-7 col-lg-7">
        <h1>Messages</h1>
      </div>
      <div class="col-xs-12 col-sm-5 col-md-5 col-lg-5">
        <%= link_to 'Nouveau message', new_message_path, class: 'btn btn-primary fab visible-xs' %>
        <div class="pull-right hidden-xs">
          <%= link_to 'Nouveau message', new_message_path, class: 'btn btn-primary' %>
        </div>
      </div>
      <div class="col-xs-12">
        <hr />
      </div>
    </div>
  </div>
  <div class="col-xs-12 col-sm-12 col-md-12 col-lg-12">

    <div class="row">
      <div class="col-xs-12 col-sm-12 col-md-12 col-lg-12">
        <div id="search-input"></div>
        <div id="search-input-icon"></div>
      </div>
      <div class="col-xs-12 col-sm-12 col-md-12 col-lg-12">
        <main>
          <div id="hits"></div>
          <div id="pagination"></div>
        </main>
        <script type="text/html" id="hit-template">
          <div class="hit row">
            <div class="col-xs-12 col-sm-12 col-md-12 col-lg-12">
              <div class="hit-content">
                <div class="row">
                  <div class="title-and-content col-xs-12 col-sm-8 col-md-8 col-lg-10">
                    <a href="/messages/{{{objectID}}}/edit">
                      <div class="row">
                        <div class="col-xs-12"><div><span class="title">{{{_highlightResult.title.value}}}</span></div></div>
                        <div class="visible-xs col-xs-4 col-xs-offset-8"><span title="" class="pull-right label {{{status}}}"> </span></div>
                        <div class="col-xs-12"><div class="content">{{{_snippetResult.content.value}}}...</div></div>
                        <div class="col-xs-12"><div class="meta"><span class="field-label">Auteur:</span> <span class="author">{{{_highlightResult.author_fullname.value}}}</span> - {{last_update_meta}}</div></div>
                      </div>
                    </a>
                  </div>
                  <div class="label-container hidden-xs col-sm-4 col-md-4 col-lg-2">
                    <span title="" class="label {{{status}}}"> </span>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </script>
        <script type="text/html" id="message_status-template">
          if('published' =={{status}}) {
            console.log 'published'
          }
        </script>
        <script type="text/html" id="stats-template">
            <div data-reactroot="" class="ais-root ais-stats">
              <div class="ais-body ais-stats--body">
                <div>
                  {{nbHits}} messages trouvés
                </div>
              </div>
            </div>
        </script>
        <script type="text/html" id="no-results-template">
          <div id="no-results-message">
            <p>Aucun message correspondant <em>"{{query}}"</em>.</p>
          </div>
        </script>
      </div>
    </div>
  </div>
</div>
