<%= form_for(@message, url: update_amount_to_pay_url(@message)) do |f| %>
<div class="row">
  <div class="col-xs-12 col-sm-12 col-md-12 col-lg-12">
    <%= render 'layouts/errors', object: @message %>
  </div>
</div>
<div class="row">
  <div class="col-lg-12 col-md-12 col-xs-12" style="text-align:right">
    <%= f.submit 'Enregistrer', class: 'btn btn-primary', data: { disable_with: "Enregistrement..." } %>
  </div>
</div>
<div class="row">
  <div class="col-xs-12 col-sm-12 col-md-3 col-lg-3">
    <div class="form-group">
      <%= f.label :amount_to_pay, 'Montant à payer (EUR)' %></br>
      <%= f.text_field :amount_to_pay, class: 'form-control' %>
    </div>
  </div>
  <div class="col-xs-12 col-sm-12 col-md-9 col-lg-9">
    <div class="form-group">
      <% @communication =  @message.billing_description || @message.title %>
      <%= f.label :billing_description, 'Communication' %></br>
      <%= f.text_field :billing_description, value: @communication, class: 'form-control' %>
      <span class="help-block">Communication structurée ou libre qui sera visible dans les extraits de compte.</span>
    </div>
  </div>
</div>
<% payments = Payment.where(message_id: @message.id, pq_status: 'SUCCEEDED').order('updated_at DESC') %>
<div class="row">
  <div class="col-xs-12 col-sm-12 col-md-12 col-lg-12">
    <% if payments.blank? %>
      <div class="alert alert-info" style="color: #31708f;background-color: #d9edf7;border-color:#bce8f1;" role="alert">
        Apparaîtra à cette endroit la liste des paiement reçus.
      </div>
    <% else %>
      <div class="alert alert-info" style="color: #31708f;background-color: #d9edf7;border-color:#bce8f1;" role="alert">
        Ci-dessous la liste des paiements effectués, l'argent est disponible sur le compte en banque 1 ou 2 jours après le paiement effectif.
      </div>
      <table class="table table-striped table-bordered">
        <thead>
        <tr>
          <th>Horodateur</th>
          <th>Eleves</th>
          <th>Montant (EUR)</th>
          <th>Communication</th>
          <th>Ref Payconiq</th>
          <th>Statut</th>
        </tr>
      </thead>
      <tbody>
      <% payments.each do |payment| %>
        <tr>
          <td><%= I18n.l(payment.updated_at.to_datetime().in_time_zone, format: :short) %></td>
          <td><%= payment.students_names %></td>
          <td><%= payment.price_cents %></td>
          <td><%= payment.communication %></td>
          <td><%= payment.pq_transaction_id %></td>
          <td><%= payment.pq_status %></td>
        </tr>
      <% end %>
      </tbody>
      </table>
    <% end %>
  </div>
</div>
<% end %>
