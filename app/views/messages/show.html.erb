<div class="row">
    <div class="col-lg-12">
        <h1 class="page-header"><%= @message.title %></h1>
    </div>
</div>

<div class="row">
    <div class="col-md-6 col-lg-7">
        <%= @message.content.html_safe %>
            <table>
              <tbody>
                <tr>
                  <td></td>
                  <td>
                    <% unless @message.author.fullname.nil? %><%= @message.author.fullname %><br><% end %>
                    <% unless @message.school.name.nil? %><%= @message.school.name %><br><% end %>
                    <% unless @message.author.function.nil? %><%= @message.author.function %><br><% end %>
                    <% unless @message.school.address.nil? %><%= @message.school.address %><br><% end %>
                    <% unless @message.school.phone.nil? %><%= @message.school.phone %><br><% end %>
                    <% unless @message.author.email.nil? %><a href="mailto:<%= @message.author.email %>"><%= @message.author.email %></a><br><% end %>
                    <% unless @message.school.url.nil? %><a href="<%= @message.school.url %>" target="_blank"><%= @message.school.url %></a><br><% end %>
                  </td>
                </tr>
              </tbody>
            </table>
    </div>
    <div class="col-md-6 col-lg-5" id="formsection">
      <% if @message.formdata.present? and @message.formdata != "[]"%>
          <%= hidden_field_tag :formdata, @message.formdata %>
          <%= form_tag '/m/save_form', id: 'message_form' do %>
            <%= hidden_field_tag 'muuid', @message.muuid %>
            <%= hidden_field_tag 'message_form_formdata' %>
            <div id="formrender-wrap"></div>
            <%= submit_tag 'Envoyer', class: 'btn btn-primary', data: { disable_with: "En cours d'envoi..." } %>
          <% end %>
      <% end %>

      <% if @message.photos.any? %>
        <hr>
        <div class="photos">
          <% @message.photos.each do |photo| %>
            <span style="padding: 10px">
              <%
                overlay_file_format = 'image'
                overlay_file_format = 'pdf' if photo.format == 'pdf'
              %>
              <a href="<%= cloudinary_url(photo.path, crop: :limit, width: 1024) %>" target="_blank">
                <%= cl_image_tag(photo.path.gsub(/pdf$/, 'png'), :transformation=>[
                      {:width => 150, :height => 150, :crop => :fill},
                      {:overlay=>"black_bar", :width=>1.0, :height=>0.17, :flags=>"relative", :gravity=>"south", :opacity=>50},
                      {:overlay=>overlay_file_format, :gravity=>"south_west", :x=>10, :y=>5},
                      {:overlay=>"text:Arial_10O:#{photo.public_id}", :gravity=>"south_west", :y=>7, :x=>32, :color=>"#eee", :flags => 'no_overflow'}
                      ]) %>
              </a>
          </span>
          <% end %>
        </div>
      <% end %>

      <% if @message.amount_to_pay > 0 %>
      <hr>
      <div class="row pq" id="paysection">
          <%= hidden_field_tag 'muuid', @message.muuid %>
          <%= hidden_field_tag 'email', @email %>
          <div class="col-xs-12 pq-banner">
            <%= image_tag asset_path("logo_payconiq.png") %>
            <br/>
            <span class="hidden-xs">Scannez le QR Code avec l'appli payconiq.</span>
            <span class="visible-xs-block">Cliquez sur le bouton pour payer avec l'app payconiq.</span>
          </div>
          <div class="col-xs-12">
            Montant: <%= @message.amount_to_pay %> EUR
            <span class="pq-button">
              <%= render 'pq_button', transactionId: @transactionId %>
            </span>
            <div class="qr pq-qr hidden-xs">
              <%= render 'qr', transactionId: @transactionId %>
            </div>
          </div>
          <div class="col-xs-12">
            <p><a href="https://www.payconiq.com">Payconiq</a> est une app gratuite : elle vous permet d'effectuer des paiements via votre smartphone, facilement et en toute sécurité. Téléchargez l'app sur <a href="https://play.google.com/store/apps/details?id=com.payconiq.customers&hl=fr">Android Google Play</a> ou <a href="https://itunes.apple.com/be/app/payconiq/id966172246?l=fr">Apple App Store</a></p>
            <div class="embed-responsive embed-responsive-16by9">
              <iframe class="hidden-xs" src="https://player.vimeo.com/video/213843344" width="640" height="360" frameborder="0" webkitallowfullscreen mozallowfullscreen allowfullscreen></iframe>
              <iframe class="hidden-sm hidden-md hidden-lg" src="https://player.vimeo.com/video/213843274" width="640" height="360" frameborder="0" webkitallowfullscreen mozallowfullscreen allowfullscreen></iframe>
            </div>
          </div>
      </div>
      <% end %>
    </div>
</div>
