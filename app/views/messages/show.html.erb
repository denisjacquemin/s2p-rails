<% if @message.nil? %>
  <br/><br/><br/>
  <p>Le message que vous tentez de visualiser n'existe pas, ou a été supprimé. Contactez le support si nécessaire <a href="mailto:support@konectoapp.com">support@konectoapp.com</a></p>
<% else %>
  <% if @message.school.allow_translation %>
    <div class="row" style="background-color: #f8f8f8; padding:20px 0">
        <div class="col-lg-12">
          <%= form_for @message, method: :get, url: message_form_url(@message.muuid), html: { class: 'form-inline'} do |f|  %>
            <%= select_tag "translate[code]", options_from_collection_for_select(@languages, :code, :name, @translation_code), prompt: 'Sélectionnez une langue', include_blank: false, class: 'form-control', style: "display:inline-block;width:auto;" %> 
            <button type="submit" class="btn btn-default" style="display:inline-block;">Traduire</button>
          <% end %>
        </div>
    </div>
  <% end %>

  <div class="row">
      <div class="col-lg-12">
          <h1 class="page-header"><%= @title %></h1>
      </div>
  </div>

  <div class="row">
      <div class="col-md-6 col-lg-7">
          <%= @content.to_s.html_safe %>
              <table>
                <tbody>
                  <tr>
                    <td></td>
                    <td>
                      <% unless @message.author.fullname.nil? %><%= @message.author.fullname %><br><% end %>
                      <% unless @message.school.name.nil? %><%= @message.school.name %><br><% end %>
                      <% unless @message.author.function.nil? %><%= @message.author.function %><br><% end %>
                      <% unless @message.school.address.nil? %><%= @message.school.address %><br><% end %>
                      <% unless @message.school.phone.nil? %><%= @message.school.phone %><br><% end %>
                      <% if @message.author.display_email_address and not @message.author.email_reply_to.nil? %><a href="mailto:<%= @message.author.email_reply_to %>"><%= @message.author.email_reply_to %></a><br><% end %>
                      <% unless @message.school.url.nil? %><a href="<%= @message.school.url %>" target="_blank"><%= @message.school.url %></a><br><% end %>
                    </td>
                  </tr>
                </tbody>
              </table>
      </div>
      <div class="col-md-6 col-lg-5" id="formsection">
        <% if @message.formdata.present? and @message.formdata != "[]"%>
          <% if @message.form_due_date.nil? || @message.form_due_date >= Date.today %>
            <%= hidden_field_tag :formdata, @message.formdata %>
            <div id="notification"></div>
            <%= form_tag '/m/save_form', id: 'message_form' do %>
              <%= hidden_field_tag 's' %>
              <%= hidden_field_tag 'muuid', @message.muuid %>
              <%= hidden_field_tag 'message_form_formdata' %>
              <div id="formrender-wrap"></div>
              <%= submit_tag 'Envoyer', class: 'btn btn-primary', data: { disable_with: "En cours d'envoi..." } %>
            <% end %>
          <% else %>
            <p style="background:yellow; color:red;">La date limite pour remplir le formulaire est dépassée.</p>
          <% end %>
        <% end %>

        <% if (@message.formdata.present? and @message.formdata != "[]") and @message.photos.any? %>
          <hr>
        <% end %>

        <% if @message.photos.any? %>
          <div class="photos">
            <% @message.photos.each do |photo| %>
              <span style="padding: 10px">
                <%
                  overlay_file_format = 'image'
                  overlay_file_format = 'pdf' if photo.format == 'pdf'
                %>
                <a href="<%= cloudinary_url(photo.path, crop: :limit, width: 1024) %>" target="_blank">
                  <%= cl_image_tag(photo.path.gsub(/pdf$/, 'png'), :transformation=>[
                        {:width => 150, :height => 150, :crop => :fill}
                        # {:overlay=>"black_bar", :width=>1.0, :height=>0.17, :flags=>"relative", :gravity=>"south", :opacity=>50},
                        # {:overlay=>overlay_file_format, :gravity=>"south_west", :x=>10, :y=>5},
                        # {:overlay=>"text:Arial_10O:#{photo.public_id}", :gravity=>"south_west", :y=>7, :x=>32, :color=>"#eee", :flags => 'no_overflow'}
                        ]) %>
                </a>
            </span>
            <% end %>
          </div>
        <% end %>
        <% if ((@message.formdata.present? and @message.formdata != "[]") or @message.photos.any?) and @message.include_payment %>
          <hr>
        <% end %>
      </div>
  </div>
<% end %>
