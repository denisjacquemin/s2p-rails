<%= form_for(message) do |f| %>
  <%= render 'layouts/errors', object: message %>

<% if message.new_record? %>
  <div class="form-group">
    <%= f.label :mtype %>
    <%= f.select(:mtype, {message: 'message', rappel: 'rappel'}, {}, {id: 'mtype', class: "form-control"})  %>
  </div>
<% end %>
  <div class="form-group">
    <%= f.label :title %>
    <%= f.text_field :title, class: 'form-control' %>
  </div>

  <div class="form-group alert_mtype" style=<%= "#{'display:none' if message.mtype == 'message'}" %>>
    <%= f.label :when %>
    <%= f.text_field :when, class: 'form-control' %>
  </div>

  <div class="form-group message_mtype" style=<%= "#{'display:none' if message.mtype == 'rappel'}" %>>
    <%= f.label :content %>
    <%= f.text_area :content, class: 'form-control', id: 'wysiwyg',  rows: 5 %>
    <script>
      $(function() {
          $('#wysiwyg').froalaEditor({
            language: 'fr',
            heightMin: 300,
            toolbarButtons: ['undo', 'redo',  '|', 'bold', 'italic', 'underline', 'strikeThrough', 'subscript', 'superscript',  '|', 'formatOL', 'formatUL', 'outdent', 'indent', 'insertHR', 'insertLink', 'insertTable', 'clearFormatting', 'selectAll']
          })
      });
    </script>
  </div>

  <div class="form-group">
   <%= f.label :send_by_email%>
   <%= f.check_box :send_by_email %>
  </div>
  <div class="form-group">
   <%= f.label :send_to_app %>
   <%= f.check_box :send_to_app %>
  </div>

  <% if current_user.superadmin? %>
    <div class="form-group">
      <%= f.label :school %>
      <%= f.select(:school_id, School.all.map {|s| [s.name,s.id]}, {}, {class: "form-control"})  %>
    </div>
  <% end %>

  <%
    submit_label = t('views.messages.new.submit')
    submit_label = t('views.messages.edit.submit') unless @message.new_record?
  %>

  <%= f.submit submit_label, class: 'btn btn-primary' %>


<% end %>
