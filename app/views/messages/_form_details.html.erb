<div class="row">
  <div class="col-xs-12 col-sm-12 col-md-12 col-lg-12">
    <% if message.new_record? %>
      <div class="form-group">
        <%= f.label :mtype %>
        <%= f.select(:mtype, [['Message', 'message'], ['Message court', 'rappel']], {}, {id: 'mtype', class: "form-control"})  %>
      </div>
    <% end %>

    <% unless message.new_record? %>
      <%= hidden_field_tag 'message_status' %>
    <% end %>

    <div class="form-group">
      <%= f.label :title %>
      <%= f.text_field :title, id: "message_title", class: 'form-control counter-input', maxlength: 160, "data-target" => ".message-title-counter" %>
      <span class="help-block">Maximum 160 caractères, reste <span class="message-title-counter"></span>.</span>
    </div>

  <!--
    <div class="form-group alert_mtype" style=<%= "#{'display:none' if message.mtype == 'message'}" %>>
      <%= f.label :when %>
      <%= f.text_field :when, class: 'form-control' %>
    </div>
  -->

    <div class="form-group message_mtype" style=<%= "#{'display:none' if message.mtype == 'rappel'}" %>>
      <%= f.label :content %>
      <%= f.text_area :content, class: 'form-control', id: 'wysiwyg',  rows: 5 %>
    </div>
    <% unless current_user.user? %>
      <div class="form-group">
        <%= f.check_box :send_by_email %>
        <%= f.label :send_by_email%>
      </div>
      <div class="form-group">
        <%= f.check_box :send_to_app %>
        <%= f.label :send_to_app %>
      </div>
      <div class="form-group send_by_sms_container" style=<%= "#{'display:none' if message.mtype != 'rappel'}" %>>
        <%= f.check_box :send_by_sms %>
        <%= f.label :send_by_sms %>
      </div>
      <div class="form-group">
        <%= f.check_box :skip_send_by_email %>
        <%= f.label :skip_send_by_email %>
      </div>
    <% end %>

  </div>
</div>
