<script src="https://www.gstatic.com/firebasejs/3.3.0/firebase.js"></script>
<script>
  var config = {
    apiKey: '<%= Rails.application.secrets.firebase_secret_key %>',
    databaseURL: '<%= Rails.application.secrets.firebase_base_uri %>'
  };
  firebase.initializeApp(config);
  var messagesRef = firebase.database().ref('messages/' + <%= message.school_id %> + '/' +  <%= message.id %>);

  addLine = function(event, reason, source, created_at) {
    var line = "<tr>";
    line += "<td>" + geticon(event) + "</td>"
    line += "<td>" + source + "</td>"
    line += "<td>" + getcomment(reason, event) + "</td>"
    line += "<td>" + created_at + "</td>"
    line += "</tr>"
    $('#analytics_list').append(line);
  }

  getcomment = function(reason, event) {
    var comment = ''
    if (reason != undefined) {
      comment = reason
    } else {
      switch(event) {
        case 'open':
            comment = 'Email ouvert'
            break;
        case 'bounce':
            comment = 'Email incorrect'
            break;
        case 'dropped':
            comment = 'Email incorrect'
            break;
        case 'delivered':
            comment = 'Email envoyé'
            break;
        }
    }
    return comment;
  }

  geticon = function(id) {
    switch(id) {
      case 'open':
          icon = '<i class="material-icons">drafts</i>'
          break;
      case 'bounce':
          icon = '<i class="material-icons">error_outline</i>'
          break;
      case 'dropped':
          icon = '<i class="material-icons">error_outline</i>'
          break;
      case 'delivered':
          icon = '<i class="material-icons">mail</i>'
          break;
      default:
          icon = ''
      }
      return icon;
  }

  messagesRef.orderByKey().on('child_added', function(data) {
    addLine(data.val().event, data.val().reason, data.val().source, data.val().created_at);
  });
</script>
<div class="row">
  <div class="col-xs-12 col-sm-12 col-md-12 col-lg-12">
    <table class="table">
      <thead>
        <tr>
          <th></th>
          <th>Source</th>
          <th>Commentaire</th>
          <th>Date/heure</th>
        </tr>
      </thead>
      <tbody id="analytics_list"></tbody>
    </table>
  </div>
</div>
