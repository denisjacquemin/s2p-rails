<script>
  var config = {
    apiKey: '<%= Rails.application.secrets.firebase_secret_key %>',
    databaseURL: '<%= Rails.application.secrets.firebase_base_uri %>'
  };
  firebase.initializeApp(config);
  var messagesRef = firebase.database().ref('messages/' + <%= message.school_id %> + '/' +  <%= message.id %>);

  addLine = function(event, reason, source, created_at) {
    var line = "<tr>";
    line += "<td>" + geticon(event) + "</td>"
    line += "<td>" + source + "</td>"
    line += "<td>" + getcomment(reason, event) + "</td>"
    line += "<td>" + created_at + "</td>"
    line += "</tr>"
    $('#analytics_list').prepend($(line).addClass("animated fadeInDown"));
  }

  getcomment = function(reason, event) {
    var comment = ''
    if (reason != undefined) {
      comment = reason
    } else {
      switch(event) {
        case 'open':
            comment = 'Email ouvert'
            break;
        case 'open_by_mobile':
            comment = 'Vu sur mobile'
            break;
        case 'bounce':
            comment = 'Email non envoyé'
            break;
        case 'dropped':
            comment = 'Email non envoyé'
            break;
        case 'delivered':
            comment = 'Email envoyé'
            break;
        }
    }
    return comment;
  }

  geticon = function(id) {
    switch(id) {
      case 'open':
          icon = '<i class="material-icons">drafts</i>'
          break;
      case 'open_by_mobile':
          icon = '<i class="glyphicon glyphicon-phone">mobile</i>'
          break;
      case 'bounce':
          icon = '<i class="material-icons">error_outline</i>'
          break;
      case 'dropped':
          icon = '<i class="material-icons">error_outline</i>'
          break;
      case 'delivered':
          icon = '<i class="material-icons">mail</i>'
          break;
      default:
          icon = ''
      }
      return icon;
  }

  messagesRef.on('child_added', function(data) {
    addLine(data.val().event, data.val().reason, data.val().source, data.val().created_at);
  });
</script>
<div class="row">
  <div class="col-xs-12 col-sm-12 col-md-8 col-lg-8">
    <table class="table">
      <thead>
        <tr>
          <th></th>
          <th>Source</th>
          <th>Commentaire</th>
          <th>Date/heure</th>
        </tr>
      </thead>
      <tbody id="analytics_list"></tbody>
    </table>
  </div>
  <div class="col-xs-12 col-sm-12 col-md-4 col-lg-4">
    <h3>Statistiques</h3>
    <p>La page <em>Statistiques</em> vous permet d'afficher un aperçu de l'activité liée à un message <em>publié</em>.</p>
    <p>Vous êtes en mesure de voir les données sur les types d'événements suivants:</p>
    <dl>
      <dt><i class="material-icons">mail</i> Email envoyé</dt>
      <dd>Un email a été envoyé à un destinataire.</dd>
      <dt><i class="material-icons">drafts</i> Email ouvert</dt>
      <dd>Chaque fois qu'un email est ouvert par un destinataire. Le système ne peut pas détecter l'ouverture d'un email si celui-ci est ouvert par le destinataire en mode non connecté.</dd>
      <dt><i class="material-icons">error_outline</i> Email non envoyé</dt>
      <dd>L'email n'a pu être envoyé, la colonne <em>commentaire</em> contient la raison de l'échec de l'envoi.</dd>
    </dl>
  </div>
</div>
