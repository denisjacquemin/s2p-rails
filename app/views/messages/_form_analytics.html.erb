<script>
  var messagesRef = firebase.database().ref('messages/' + <%= message.school_id %> + '/' +  <%= message.id %>);

  addLine = function(target, event, reason, source = '', created_at) {


    var line = '<tr class="' + target + '">';
    line += "<td>" + geticon(event) + "</td>"
    line += "<td>" + source + "</td>"
    line += "<td>" + getcomment(reason, event) + "</td>"
    line += "<td>" + created_at + "</td>"
    line += "</tr>"
    $('#' + target + '_rows').prepend($(line).addClass("animated bounceIn"));
  }

  getcomment = function(reason, event) {
    var comment = ''
    switch(event) {
      case 'open':
          comment = 'Email ouvert'
          break;
      case 'open_by_mobile':
          comment = 'Vu sur mobile'
          break;
      case 'bounce':
          comment = 'Email non envoyé'
          break;
      case 'dropped':
          comment = 'Email non envoyé'
          break;
      case 'delivered':
          comment = 'Email envoyé'
          break;
      }

    if (reason != undefined) {
       comment = '<span data-toggle="tooltip" data-placement="top" title="' + reason + '">' + comment + '</span>'
    }
    return comment;
  }

  geticon = function(id) {
    switch(id) {
      case 'open':
          icon = '<i class="material-icons">drafts</i>'
          break;
      case 'open_by_mobile':
          icon = '<i class="fa fa-mobile-phone fa-2x"></i>'
          break;
      case 'bounce':
          icon = '<i class="fa fa-warning"></i>'
          break;
      case 'dropped':
          icon = '<i class="fa fa-warning">'
          break;
      case 'delivered':
          icon = '<i class="material-icons">mail</i>'
          break;
      default:
          icon = ''
      }
      return icon;
  }

  messagesRef.child('delivered').on('child_added', function(data) {
    addLine('delivered', data.val().event, data.val().reason, data.val().source, data.val().created_at);
    $('#counter_delivered').text($('.delivered').length);
    $('#total_counter').text($('.open, .mobile').length);
  });

  messagesRef.child('open').on('child_added', function(data) {
    addLine('open', data.val().event, data.val().reason, data.val().source, data.val().created_at);
    $('#counter_open').text($('.open').length);
    $('#total_counter').text($('.open, .mobile').length);
  });

  messagesRef.child('view').on('child_added', function(data) {
    addLine('mobile', data.val().event, data.val().reason, data.val().source, data.val().created_at);
    $('#counter_mobile').text($('.mobile').length);
    $('#total_counter').text($('.open, .mobile').length);
  });

  messagesRef.child('dropped').on('child_added', function(data) {
    addLine('dropped', data.val().event, data.val().reason, data.val().source, data.val().created_at);
    $('#counter_dropped').text($('.dropped').length);
    $('#total_counter').text($('.open, .mobile').length);
  });

</script>
<div class="row">
  <div class="col-xs-12 col-sm-7 col-sm-offset-5 col-md-4 col-md-offset-8 col-lg-4 col-lg-offset-8">
    <div class="jumbotron" style="text-align:right">
      <h1 id="total_counter">0</h1>
      <p>Vues total</p>
      <% unless message.publish_date.nil? %>
        <p>Depuis le <%= I18n.l(message.publish_date, format: :short)%></p>
      <% end %>
      <br/>
    </div>
  </div>
</div>

