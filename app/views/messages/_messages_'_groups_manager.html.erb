<div class="row groups" id="messages-groups-manager">
    <div class="col-xs-12 col-sm-12 col-md-4 col-lg-4">
      <div class="panel panel-default">
        <div class="panel-heading">
          <ul class="nav nav-pills">
            <li role="presentation" class="active"><a data-toggle="pill" href="#groups"><i class="fa fa-users"></i> Groupes d'élèves</a></li>
            <li role="presentation"><a data-toggle="pill" href="#students"><i class="fa fa-user"></i> Elèves</a></li>
          </ul>
        </div>
        <div class="panel-body ">
          <div class="tab-content">
            <div role="tabpanel" class="tab-pane fade in active table-filter" id="groups">

              <% groups = current_user.groups_by_school(current_school.id) %>
              <% if groups.present? %>
                <input type="text" class="filter" data-table="#group_list" placeholder="Rechercher">
                <table class="table table-hover table-condensed" >
                  <tbody id="group_list" class="list">
                    <% groups.each do |group| %>
                      <tr>
                        <td class="nowrap"><input type="checkbox" value="<%= group.id %>"/></td>
                        <td class="groupname fullwidth"><label><%= group.name %></label></td>
                      </tr>
                    <% end %>
                  </tbody>
                </table>
              <% end %>
              <% if groups.empty? %>
                <p><%= I18n.t('views.messages.groups_no_rights', admins: current_school.admins.map {|u| u.fullname}.join(', ')) %></p>
              <% end %>
            </div>
            <div role="tabpanel" class="tab-pane fade in table-filter" id="students">
              <% students = current_user.students_by_school(current_school.id) %>
              <% if students.present? %>
                <input type="text" class="filter" data-table="#student_list" placeholder="Rechercher">
                <table class="table table-hover table-condensed" >
                  <tbody id="student_list" class="list">
                    <% students.each do |student| %>
                      <tr>
                        <td class="nowrap"><input type="checkbox" value="<%= student.id %>"/></td>
                        <td class="studentfullname nowrap"><label><%= student.fullname %></label></td>
                        <td class="studentfulllevel nowrap"><%= student.level %></td>
                        <td class="studentclassroom fullwidth"><%= student.classroom %></td>
                      </tr>
                    <% end %>
                  </tbody>
                </table>
              <% end %>
              <% if students.empty? %>
                <p><%= I18n.t('views.messages.students_no_rights', admins: current_school.admins.map {|u| u.fullname}.join(', ')) %></p>
              <% end %>
            </div>
          </div>
        </div>
      </div>
    </div>
    <div class="col-xs-12 col-sm-12 col-md-2 col-lg-2 buttons">
      <div class="row groups">
          <div class="col-xs-12 col-sm-12 col-md-12 col-lg-12">
            <button type="button" class="btn " id="add" aria-label="Left Align">
              Ajouter
              <span class="glyphicon glyphicon-chevron-right" aria-hidden="true"></span>
            </button>
          </div>
          <div class="col-xs-12 col-sm-12 col-md-12 col-lg-12">
            <button type="button" class="btn" id="remove" aria-label="Left Align">
              <span class="glyphicon glyphicon-chevron-left" aria-hidden="true"></span>
              Enlever
            </button>
          </div>
        </div>
    </div>
    <div class="col-xs-12 col-sm-12 col-md-4 col-lg-4">
        <div class="panel panel-default">
          <div class="panel-heading">
            <h4>Destinataires sélectionnés</h4>
          </div>
          <div class="panel-body table-filter" id="in_groups_list">
            <input type="text" class="filter" data-table="#destinataires" placeholder="Rechercher">
            <table class="table table-hover table-condensed" id="in_groups">
              <tbody class="list" id="destinataires">
                <% message.groups_obj.each do |g| %>
                  <tr>
                    <%= fields_for g do |g_form| %>
                      <%= g_form.hidden_field :id, multiple: true%>
                      <td class="nowrap"><input type="checkbox" id="group[<%= g.id %>]"/></td>
                      <td class="targetname fullwidth"><i class="fa fa-users" style="margin-right: 5px;"></i><%= g_form.label :id, g.name %></td>
                    <% end %>
                  </tr>
                <% end %>
                <% message.students_obj.each do |s| %>
                  <tr>
                    <%= fields_for s do |s_form| %>
                      <%= s_form.hidden_field :id, multiple: true%>
                      <td class="nowrap"><input type="checkbox" id="student[<%= s.id %>]"/></td>
                      <td class="targetname fullwidth"><i class="fa fa-user" style="margin-right: 5px;"></i> <%= s_form.label :id, s.fullname %></td>
                    <% end %>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        </div>
    </div>
    <div class="col-xs-12 col-sm-12 col-md-2 col-lg-2">
      <p>Les emails et notifications aux apps mobiles sont envoyés à la liste des groupes d'élèves ou élèves repris ci-contre lorsque le message passe au statut <em>Publié</em>.</p>
      <p><i class="fa fa-warning"></i> Modifier cette liste lorsqu'un message est en statut <em>publié</em> a un impact sur la visibilité du message dans les apps mobiles.</p>
    </div>
</div>
