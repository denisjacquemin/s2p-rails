<div class="row">
  <div class="col-xs-12 col-sm-12 col-md-12 col-lg-12">
    <ul class="nav nav-tabs" role="tablist" id="message_tabs">
      <li role="presentation" class="active">
        <a class="tab-link" href="#details" aria-controls="home" role="tab" data-toggle="tab">Titre et contenu</a>
      </li>
      <% #if not message.new_record? and @message.mtype == 'message' and current_user.superadmin? %>
      <% #<li role="presentation"> %>
      <% #  <a href="#files" aria-controls="profile" role="tab" data-toggle="tab">Images</a> %>
      <% #</li> %>
      <% #end %>
      <% if not message.new_record? and @message.mtype == 'message' %>
      <li role="presentation">
        <a class="tab-link"  href="#cloudinary" aria-controls="profile" role="tab" data-toggle="tab">Images</a>
      </li>
      <% end %>
      <% if not message.new_record? and @message.mtype == 'message' %>
      <li role="presentation">
        <a class="tab-link" href="#formbuilder" aria-controls="profile" role="tab" data-toggle="tab">Formulaire</a>
      </li>
      <% end %>
      <% if not message.publish_date.nil? and (current_user.superadmin? or current_user.admin?) %>
        <li role="presentation">
          <a class="tab-link" href="#analytics" aria-controls="profile" role="tab" data-toggle="tab">Statistiques (<span class="total_counter">0</span>)</a>
        </li>
      <% end %>
      <% unless message.new_record? %>
        <div class="pull-right"><%= render 'submit_with_status_dropdown', message: @message, size: 'btn-sm' %></div>
      <% end %>
    </ul>
  </div>
</div>
<div class="row">
  <div class="col-xs-12 col-sm-12 col-md-12 col-lg-12">
    <div class="tab-content">

      <div role="tabpanel" class="tab-pane fade in active" id="details">
        <%= form_for(@message) do |f| %>
          <div class="row">
            <div class="col-xs-12 col-sm-12 col-md-12 col-lg-12">
              <%= render 'layouts/errors', object: @message %>
            </div>
          </div>
          <%
            submit_label = t('views.messages.new.submit')
            submit_label = t('views.messages.edit.submit') unless @message.new_record?
          %>
          <div class="row">
            <div class="col-xs-12 col-sm-12 col-md-12 col-lg-12">
              <%= f.submit submit_label, class: 'btn btn-primary fab visible-xs', data: { disable_with: "Enregistrement..." } %>
              <div class="pull-right hidden-xs"><%= f.submit submit_label, class: 'btn btn-primary', data: { disable_with: "Enregistrement..." } %></div>
            </div>
          </div>
          <%= render 'form_details', f: f, message: @message %>
          <%= render 'form_groups', f: f, message: @message %>
        <% end %>
      </div>
      <% # if not message.new_record? and @message.mtype == 'message' and current_user.superadmin? %>
      <% #  <div role="tabpanel" class="tab-pane fade in" id="files"> %>
      <% #    <%= render 'form_files', {message: @message, mfile: mfile} %>
      <% #  </div %>
      <% # end %>

      <% if not message.new_record? and @message.mtype == 'message' %>
        <div role="tabpanel" class="tab-pane fade in" id="cloudinary">
          <%= render 'form_cloudinary', {message: @message} %>
        </div>
      <% end %>

      <% if not message.new_record? and @message.mtype == 'message' %>
        <div role="tabpanel" class="tab-pane fade in" id="formbuilder">
          <%= render 'form_formbuilder', {message: @message} %>
        </div>
      <% end %>

      <% if not message.publish_date.nil? and (current_user.superadmin? or current_user.admin?) %>
        <div role="tabpanel" class="tab-pane fade in" id="analytics">
          <%= render 'form_analytics', message: @message %>
        </div>
      <% end %>
    </div>
  </div>
</div>

