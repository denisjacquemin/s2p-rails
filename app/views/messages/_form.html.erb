<% if !message.new_record? %>
  <%= form_for(@message, method: 'post', url: { action: "copy"}, html: {class: 'copy_message'} ) do |f| %>
    <%= hidden_field_tag 'id', @message.id %>
  <% end %>
<% end %>

<% unless @message.scheduled_publish.blank? %>
  <div class="row">
    <div class="col-xs-12">
      <div class="alert alert-warning" role="alert">
        <p>
          <i class="glyphicon glyphicon-hourglass"></i> Ce message sera envoyé le <strong><%= @message.scheduled_publish.strftime("%d/%m/%Y %H:%M") %></strong> - <a href="#" class="schedule_sending" style="color:#fff;text-decoration:underline">Modifier</a> - <a href="#" class="cancel_schedule_sending" style="color:#fff;text-decoration:underline">Annuler</a>
        </p>
      </div>
    </div>
  </div>
<% end %>
<div class="row">
  <div class="col-xs-12">
    <ul class="nav nav-tabs drop-on-responsive" role="tablist" id="message_tabs">
      <li role="presentation" class="active">
        <a class="tab-link" data-target="#details-tab" aria-controls="home" role="tab" data-toggle="tab">Titre et contenu</a>
      </li>
      <% #if not message.new_record? and @message.mtype == 'message' and current_user.superadmin? %>
      <% #<li role="presentation"> %>
      <% #  <a href="#files" aria-controls="profile" role="tab" data-toggle="tab">Images</a> %>
      <% #</li> %>
      <% #end %>

      <% save_form_with_tab = message.new_record? and @message.mtype == 'message' %>
      <% if @message.mtype == 'message' %>
        <li role="presentation">
          <a class="tab-link <%= 'save-form' if save_form_with_tab %>"  data-target="#cloudinary-tab" aria-controls="profile" role="tab" data-toggle="tab">Images / PDF (<%= message.photos.count %>)</a>
        </li>
      <% end %>
      <% if @message.mtype == 'message' %>
        <li role="presentation">
          <a class="tab-link <%= 'save-form' if save_form_with_tab %>" data-target="#formbuilder-tab" aria-controls="profile" role="tab" data-toggle="tab">Formulaire</a>
        </li>
      <% end %>
      <% if @message.mtype == 'message' and current_school.billing_enable? %>
        <li role="presentation">
          <a class="tab-link <%= 'save-form' if save_form_with_tab %>" data-target="#billing-tab" aria-controls="profile" role="tab" data-toggle="tab">Facturation</a>
        </li>
      <% end %>
      <% if not message.publish_date.nil? %>
        <li role="presentation">
          <a class="tab-link" data-target="#analytics-tab" aria-controls="profile" role="tab" data-toggle="tab">Statistiques (<% if @showStatsFromEmailRecipients %><%= @total_views %><% else %><span class="total_counter">0</span><% end %>)</a>
        </li>
      <% end %>
    </ul>
    <% unless message.new_record? %>
        <div class="pull-right"><%= render 'submit_with_status_dropdown', message: @message, size: 'btn-sm' %></div>
      <% end %>
  </div>
</div>
<div class="row">
  <div class="col-xs-12 col-sm-12 col-md-12 col-lg-12">
    <div class="tab-content">

      <div role="tabpanel" class="tab-pane fade in active" id="details-tab">
        <%= form_for(@message) do |f| %>
          <div class="row">
            <div class="col-xs-12 col-sm-12 col-md-12 col-lg-12">
              <%= render 'layouts/errors', object: @message %>
            </div>
          </div>
          <%
            submit_label = t('views.messages.new.submit')
            submit_label = t('views.messages.edit.submit') unless @message.new_record?
          %>
          <div class="row">
            <div class="col-xs-12 col-sm-12 col-md-12 col-lg-12 submit-btn">
              <%= f.submit submit_label, class: 'btn btn-primary fab visible-xs', data: { disable_with: "Enregistrement..." } %>
              <div class="pull-right hidden-xs"><%= f.submit submit_label, class: 'btn btn-primary', data: { disable_with: "Enregistrement..." } %></div>
            </div>
          </div>
          <%= hidden_field_tag 'scheduled_datetime', @message.scheduled_publish %>
          <%= render 'form_details', f: f, message: @message %>
          <% if current_school.new_recipients_selection %>
            <%= render 'recipients_selection', f: f, message: @message %>
          <% else %>
            <%= render 'form_groups', f: f, message: @message %>
          <% end %>        
        <% end %>
      </div>
      <% # if not message.new_record? and @message.mtype == 'message' and current_user.superadmin? %>
      <% #  <div role="tabpanel" class="tab-pane fade in" id="files"> %>
      <% #    <%= render 'form_files', {message: @message, mfile: mfile} %>
      <% #  </div %>
      <% # end %>

      <% if not message.new_record? and @message.mtype == 'message' %>
        <div role="tabpanel" class="tab-pane fade in" id="cloudinary-tab">
          <%= render 'form_cloudinary', {message: @message} %>
        </div>
      <% end %>

      <% if not message.new_record? and @message.mtype == 'message' %>
        <div role="tabpanel" class="tab-pane fade in" id="formbuilder-tab">
          <%= render 'form_formbuilder', {message: @message} %>
        </div>
      <% end %>

      <% if not message.publish_date.nil? %>
        <div role="tabpanel" class="tab-pane fade in" id="analytics-tab">
          <%= render 'form_analytics', message: @message %>
        </div>
      <% end %>
      <% if not message.new_record? and @message.mtype == 'message' and message.school.billing_enable?  %>
        <div role="tabpanel" class="tab-pane fade in" id="billing-tab">
          <%= render 'form_billing', message: @message %>
        </div>
      <% end %>
    </div>
  </div>
</div>

