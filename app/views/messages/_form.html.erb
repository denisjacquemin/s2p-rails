<ul class="nav nav-tabs" role="tablist" id="message_tabs">
  <li role="presentation" class="active">
    <a href="#details" aria-controls="home" role="tab" data-toggle="tab">Titre et contenu</a>
  </li>
  <li role="presentation">
    <a href="#files" aria-controls="profile" role="tab" data-toggle="tab">Images</a>
  </li>
  <li role="presentation">
    <a href="#groups" aria-controls="profile" role="tab" data-toggle="tab">Groupes de diffusions</a>
  </li>
  <div class="pull-right"><%= render 'status', message: @message %></small></div>
</ul>

<!-- Tab panes -->
<div class="tab-content">
  <div role="tabpanel" class="tab-pane active" id="details">
    <%= render 'form_details', message: message %>
  </div>
  <div role="tabpanel" class="tab-pane" id="files">
    <%= render 'form_files', {message: message, mfile: mfile} %>
  </div>
  <div role="tabpanel" class="tab-pane" id="groups">
    <%= render 'form_groups', {message: message, mfile: mfile} %>
  </div>
</div>

<script>
$('#message_tabs a').click(function (e) {
  e.preventDefault()
  $(this).tab('show')
})

var t = getParameterByName('t')
if (t == '') {
  t = 'details'
}
var selector = '.nav-tabs a[href="#' + t + '"]'
$(selector).tab('show')
</script>
