<div class="row">
  <div class="col-lg-12 col-md-12 col-xs-12">
    <%= form_for(message, url: messages_update_form_path(message.id), method: :patch, html: { id: 'message_update_form'}) do |f| %>
      <%= f.hidden_field :formdata %>
    <% end %>
    <div class="pull-right"><%= link_to 'Enregistrer le formulaire', nil, id: 'frmb-0-save', class: 'btn btn-primary form-builder-save' %></div>
  </div>
</div>
<div class="row">
  <div class="col-lg-12 col-md-12 col-xs-12">
    <label>Formulaire</label>
    <div id="formbuilder-wrap"></div>
  </div>
</div>
