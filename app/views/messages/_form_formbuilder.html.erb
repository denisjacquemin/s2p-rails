<div class="row" id="formbuilder_page">
  <div class="col-xs-12 col-sm-12 col-md-12 col-lg-12">
    <ul class="nav nav-pills" id="formbuilder_pills">
      <li role="presentation" <%= 'class=active' if @message.status != "published" %>><a class="tab-link" href="#questions" aria-controls="questions" role="tab" data-toggle="tab">Questions</a></li>
      <li role="presentation" <%= 'class=active' if @message.status == "published" %>><a class="tab-link" href="#answers" aria-controls="answers" role="tab" data-toggle="tab">Réponses</a></li>
    </ul>
    <div class="tab-content">
      <div role="tabpanel" class="tab-pane <%= 'active' if @message.status != "published" %>" id="questions">
        <div class="row">
          <div class="col-lg-12 col-md-12 col-xs-12">
            <%= form_for(message, url: messages_update_form_path(message.id), method: :patch, html: { id: 'message_update_form'}) do |f| %>
              <%= f.hidden_field :formdata, id: 'formdata' %>
              <%= hidden_field_tag 'formduedate' %>
              <%= hidden_field_tag 'setformdata' %>
              <div class="pull-right"><%= f.submit 'Enregistrer le formulaire', class: 'btn btn-primary', data: { disable_with: "Enregistrement..." } %></div>
            <% end %>
          </div>
        </div>
        <div class="row">
          <div class="col-lg-12 col-md-12 col-xs-12">
            <label>Formulaire</label>
            <% @form_templates = FormTemplate.where(school_id: message.school.id).pluck(:id, :name) %>
            <% if @form_templates.any? %>
              &nbsp;|&nbsp;
              Modèle:
              <%= form_tag('/form_templates/loadformtemplate',  {id: 'load_form_template'}) do %>
                <%= select_tag 'form_template_id', options_for_select(@form_templates.collect{ |ft| [ft[1], ft[0]] }), include_blank: true %>
              <% end %>
            <% end %>
            <%= hidden_field_tag 'levels', @levels.to_json %>
            (<a href="/help/formulaire" target="_blank">Guide d'utilisation</a>)
            <div id="formbuilder-wrap"></div>
          </div>
        </div>
        <div class="row">
          <div class="col-lg-9 col-md-9 col-xs-12">
            <div class="alert alert-info" style="color: #31708f;background-color: #d9edf7;border-color:#bce8f1;" role="alert">
              <b>Quelques conseils pour un formulaire efficace:</b>
              <ul>
               <li>Pensez à une question permettant d'identifier l'auteur de la réponse, ex: "Nom et prénom de l'élève".</li>
               <li>Pour trier les réponses par classe, demandez la "Classe" en utilisant une question de type "Sélection".</li>
               <li>Une question est obligatoire, n'utilisez pas "texte sans question" pour poser une question. </li>
               <li>Il ne peut y avoir 2 questions identiques</li>
              </ul>
            </div>
          </div>
          <div class="col-lg-3 col-md-3 col-xs-12">
            <%= label_tag "Date limite" %>
            <div class='input-group date' id='datetimepickerformduedate'>
                <%= text_field_tag 'form_due_date', @message.form_due_date.try(:strftime,"%d/%m/%y"), class: 'form-control' %>
                <span class="input-group-addon">
                    <span class="glyphicon glyphicon-calendar"></span>
                </span>
            </div>
            <span class="help-block">Dernier jour pour lequel le formulaire peut être rempli. Pas de date signifie qu'il n'y a aucune limite.</span>
          </div>
        </div>
      </div>
      <div role="tabpanel" class="tab-pane <%= 'active' if @message.status == "published" %>" id="answers">
        <div class="row">
          <div class="col-lg-12 col-md-12 col-xs-12">
            <% formdata = Form.by_muuid(@message.muuid).latest_first.pluck(:formdata) %>
            <% if formdata.any? %>
              <%= hidden_field_tag :tabledata, '[' + formdata.join(',') + ']' %>
              <div class="pull-right"> <i class="fa fa-file-excel-o"></i> <%= link_to "Export Excel", export_formdata_path(id: @message.id , format: "csv") %></div>
              <br/>
              <div id="jsGrid"></div>
              <script>
                var headers = new Array();
                var rows = new Array();

                $.each( JSON.parse($('#tabledata').val()), function( key, value ) { // for each form
                  var row = {};
                  $.each( value, function(value_key, data) { // for each value get headers and data
                    var label = "Pas de titre"
                    if (data['label'] != undefined && data['label'].trim() != "" ) {
                     label = data['label'].trim()
                     var indexOfAsterix = label.indexOf(" *")
                     if (indexOfAsterix !== -1) {
                       label = label.substring(0, indexOfAsterix)
                     }
                    }
                    label = label.trim()
                    label = label.replace(/\.*/g,"")
                    label = label.trim()
                    headers.push(label);
                    if (row[label] == undefined) {
                      var value = data['value'];
                      if (value === 'on') {
                        value = '&#10003;'
                      }
                      row[label] = value;
                    } else {
                      row[label] = [row[label], data['value']].join(", ")
                    }
                  });
                  rows.push(row);
                });

                var uniqueHeaders = [];
                $.each(headers, function(i, el){
                    if($.inArray(el, uniqueHeaders) === -1) uniqueHeaders.push(el);
                });

                jsGridHeaders = []
                $.each(uniqueHeaders, function(i, el){
                    jsGridHeaders.push({'name':el});
                });

                var formsdata =

                $("#jsGrid").jsGrid({
                    width: "100%",
                    //height: "100%",
                    inserting: false,
                    editing: false,
                    sorting: true,
                    paging: true,
                    pageSize: 25,
                    pageButtonCount: 5,

                    data: rows,
                    fields: jsGridHeaders
                    // fields: [
                    //     { name: "Name", width: 150, validate: "required" },
                    //     { name: "Age", type: "number", width: 50 },
                    //     { name: "Address", type: "text", width: 200 },
                    //     { name: "Country", type: "select", items: countries, valueField: "Id", textField: "Name" },
                    //     { name: "Married", type: "checkbox", title: "Is Married", sorting: false },
                    //     { type: "control" }
                    // ]
                });
                </script>
            <% else %>
              <br/>
              <p>Aucune réponse pour l'instant.</p>
            <% end %>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
