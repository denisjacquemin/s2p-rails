<%= form_for(message, url: messages_add_photo_path(message.id), method: :patch, html: { id: 'message_add_photo', multipart: true }) do |f| %>
  <div class="row">
    <div class="col-lg-12 col-md-12 col-xs-12">
      <div style="visibility:hidden;" class="progress progress-striped active" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0">
        <div class="progress-bar progress-bar-success" style="width: 0;"></div>
      </div>
    </div>
  </div>
  <div class="row pull-right">
    <div class="col-lg-12 col-md-12 col-xs-12">
      <%= f.submit "Enregistrer les images", class: 'btn btn-primary', data: { disable_with: "Enregistrement..." } %>
    </div>
  </div>
  <div class="row">
    <div class="col-lg-12 col-md-12 col-xs-12">
      <div class="dropzone">
        <div class="middle">
          <div class="inner">
            <br/>
            <p>Glisser déposer images ou PDF ici</p>
            <p>ou</p>
            <p><%= f.attachinary_file_field :photos %></p>
          </div>
        </div>
      </div>
    </div>
  </div>
<% end %>
<% content_for :cloudinary_init do %>
  <%= cloudinary_js_config %>
<% end %>
