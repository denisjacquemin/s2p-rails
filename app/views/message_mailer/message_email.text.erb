<% if @message.message? %>
  <%= @message.title %>
  ===============================================
  <%= strip_tags @message.content %>
<% elsif @message.rappel? %>
  <%= @message.title %>
<% end %>

<% if @message.formdata.present? and @message.formdata != "[]"%>
  Suivez le lien ci-dessous pour remplir le formulaire
  <%= message_form_url(@message.muuid) %>
<% end %>

<% if @message.photos.any? %>
++++++++

  <% @message.photos.each do |photo| %>
    <%= cloudinary_url(photo.path, crop: :limit, width: 1024) %>
  <% end %>
<% end %>

<% if @message.author.display_email_address and @message.author.reply_to %>
  PS: Pour répondre à cet E-mail utilisez l'adresse <%= @message.author.reply_to %>.
<% else %>
  PS: Ne répondez pas à cet E-mail, votre réponse n'aboutirait nulle part.
<% end %>
--
<% unless @message.author.fullname.nil? %><%= strip_tags @message.author.fullname %><% end %>
<% unless @message.school.name.nil? %><%= strip_tags @message.school.name %><% end %>
<% unless @message.author.function.nil? %><%= strip_tags @message.author.function %><% end %>
<% unless @message.school.address.nil? %><%= strip_tags @message.school.address %><% end %>
<% unless @message.school.phone.nil? %><%= strip_tags @message.school.phone %><% end %>
<% if @message.author.display_email_address %>
<% unless @message.author.reply_to.nil? %><%= strip_tags @message.author.reply_to %><% end %>
<% end %>
<% unless @message.school.url.nil? %><%= strip_tags @message.school.url %><% end %>
