<style>
.btn {
  color: #FFFFFF;
  background-color: #337AB7;
  border-color: #2E6DA4;
}

.btn:hover,
.btn:focus,
.btn:active,
.btn.active,
.open .dropdown-toggle.btn {
  color: #FFFFFF;
  background-color: #337AB7;
  border-color: #2E6DA4;
}

.btn:active,
.btn.active,
.open .dropdown-toggle.btn {
  background-image: none;
}

.btn-lg {
    padding: 10px 16px;
    font-size: 18px;
    line-height: 1.33;
    border-radius: 6px;
}
.btn.disabled,
.btn[disabled],
fieldset[disabled] .btn,
.btn.disabled:hover,
.btn[disabled]:hover,
fieldset[disabled] .btn:hover,
.btn.disabled:focus,
.btn[disabled]:focus,
fieldset[disabled] .btn:focus,
.btn.disabled:active,
.btn[disabled]:active,
fieldset[disabled] .btn:active,
.btn.disabled.active,
.btn[disabled].active,
fieldset[disabled] .btn.active {
  background-color: #337AB7;
  border-color: #2E6DA4;
}

.btn .badge {
  color: #337AB7;
  background-color: #FFFFFF;
}

  .photos a {
    border: none;
    text-decoration: none;
    margin: 5px;
  }
  .photos  a:hover {
    text-decoration: none;
  }

  .photos img:hover {
    border: solid 1px blue;
  }

  .photos img {
    border: solid 1px #ccc;
  }
</style>

<% if @message.message? %>
  <h2><%= @message.title %></h2>
  <%= @message.content.html_safe %>
<% elsif @message.rappel? %>
  <p><%= @message.title %></p>
<% end %>
<br>

<% if @message.formdata.present? and @message.formdata != "[]"%>
  <table style="background-color: #337ab7; color: #fff; max-width: 400px; padding: 20px 5px; border: 1px solid #2e6da4; width: 100%;">
    <tbody>
      <tr>
        <td style="text-align:center">
          <%= link_to "Remplir le formulaire", message_form_url(@message.muuid), class: 'btn btn-lg' %>
        </td>
      </tr>
    </tbody>
  </table>
<% end %>
<% if @message.include_payment? %>
  <table cellpadding="0" cellspacing="0" border="0" align="left" style="border-collapse:separate;border:1px solid #1791c8;width:100%">
    <tbody>
      <tr>
        <td height="15" colspan="3"> </td>
      </tr>
      <tr>
        <td width="30"> </td>
        <td>
          <% account_number = @message.account.account_number unless @message.account.nil? or @message.account.account_number.blank? %>
          <p style="margin-bottom:0px;text-align:left;margin:0px;padding:0px;color:#000;font-family:Verdana,Geneva,sans-serif;font-size:14px;line-height:22px">
            Le montant de <strong style="color:#1d92c4"><%=  humanized_money @message.amount_to_pay %> EUR</strong> est à payer
            <% unless @message.billing_due_date.blank? %>
              avant le <strong style="color:#1d92c4"> <%= @message.billing_due_date %></strong>
            <% end %>
            <% unless account_number.blank? %>
              <br>sur le compte <strong style="color:#1d92c4"><%= account_number %></strong>
            <% end %>
            <% unless @message.billing_description.blank? %>
              <br>avec la communication <strong style="color:#1d92c4"><%= @message.billing_description %></strong>.
            <% end %>
            <% unless @message.billing_comment.blank? %>
              <br><br>
              <%= @message.billing_comment %>
            <% end %>
          </p>
        </td>
        <td width="30"> </td>
      </tr>
      <tr>
        <td height="15" colspan="3"></td>
      </tr>
    </tbody>
  </table>
  <% if @message.school.payconiq_enable? %>
    <table>
      <tbody>
        <tr>
          <td height="15"></td>
        </tr>
      </tbody>
    </table>
    <% unless @message.account.payconiq_access_token.blank? %>
    <table style="background-color: #ff4785; color: #fff; max-width: 400px; padding: 20px 5px; border: 1px solid #ff4785; width: 100%;">
      <tbody>
        <tr>
          <td style="text-align:center">
            <%= link_to "Payer avec payconiq", message_pay_url(@message.muuid, e: '-email_encrypt-'), class: 'btn btn-lg', style: 'background-color: #ff4785' %>
          </td>
        </tr>
      </tbody>
    </table>
    <% end %>
  <% end %>
<% end %>

<br>
<br>
<div class="photos">
  <% if @message.photos.any? %>
    <% @message.photos.each do |photo| %>
      <%
        overlay_file_format = 'image'
        overlay_file_format = 'pdf' if photo.format == 'pdf'
      %>
      <a href="<%= cloudinary_url(photo.path, crop: :limit, width: 1024) %>" target="_blank">
        <%= cl_image_tag(photo.path.gsub(/pdf$/, 'png'), :alt => photo.public_id, :transformation=>[
            {:width => 150, :height => 150, :crop => :fill},
            {:overlay=>"black_bar", :width=>1.0, :height=>0.17, :flags=>"relative", :gravity=>"south", :opacity=>50},
            {:overlay=>overlay_file_format, :gravity=>"south_west", :x=>10, :y=>5},
            {:overlay=>"text:Arial_10O:#{photo.public_id}", :gravity=>"south_west", :y=>7, :x=>32, :color=>"#eee", :flags => 'no_overflow'}
              ]) %>
      </a>
    <% end %>
  <% end %>
</div>

<br>
<br>
<% if @message.author.display_email_address and @message.author.reply_to %>
  <p>PS: Pour répondre à cet E-mail utilisez l'adresse <a href="mailto:<%= @message.author.reply_to %>?subject=Re: <%= @message.title %>"><%= @message.author.reply_to %></a>.</p>
<% else %>
  <p>PS: Ne répondez pas à cet E-mail, votre réponse n'aboutirait nulle part.</p>
<% end %>

<hr>
<table>
  <tbody>
    <tr>
      <td></td>
      <td>
        <% unless @message.author.fullname.blank? %><%= @message.author.fullname %><br><% end %>
        <% unless @message.school.name.blank? %><%= @message.school.name %><br><% end %>
        <% unless @message.author.function.blank? %><%= @message.author.function %><br><% end %>
        <% unless @message.school.address.blank? %><%= @message.school.address %><br><% end %>
        <% unless @message.school.phone.blank? %><%= @message.school.phone %><br><% end %>
        <% if @message.author.display_email_address %>
          <% unless @message.author.reply_to.nil? %><a href="mailto:<%= @message.author.reply_to %>"><%= @message.author.reply_to %></a><br><% end %>
        <% end %>
        <% unless @message.school.url.blank? %><a href="<%= @message.school.url %>" target="_blank"><%= @message.school.url %></a><br><% end %>
      </td>
    </tr>
  </tbody>
</table>

<table cellpadding="0" cellspacing="0" border="0" style="border-collapse:collapse;color:#999;padding-top:16px;text-align:center;width:100%" align="center" width="100%">
  <tbody>
    <tr>
      <td style="border-collapse:collapse">
        <div style="padding:25px 20px"><div>
        <span style="color:#999;display:block;padding-bottom:8px">
          Consultez ce message sur votre smartphone grâce à l'application Konecto App.
          <br>Disponible sur l'<a href="https://itunes.apple.com/be/app/konecto-app/id1141643283?mt=8" target="_blank">App Store d'Apple</a> et sur <a href="https://play.google.com/store/apps/details?id=com.dsjn.s2p" target="_blank">Google Play pour Android</a>.
          <br><br>[code]
        </span>
      </td>
    </tr>
  </tbody>
</table>
