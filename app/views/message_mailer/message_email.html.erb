<% if @message.message? %>
  <h2><%= @message.title %></h2>
  <%= @message.content.html_safe %>
<% elsif @message.rappel? %>
  <p><%= @message.title %></p>
<% end %>
<br>

<% if @message.photos.any? %>
  <% @message.photos.each do |photo| %>
    <span style="padding: 10px">
      <a href="<%= cloudinary_url(photo.path) %>" target="_blank">
        <%= cl_image_tag(photo.path, :width => 150, :height => 150, :crop => :fill) %>
      </a>
  </span>
  <% end %>
<% end %>

