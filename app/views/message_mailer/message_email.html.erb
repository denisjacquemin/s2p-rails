<style>
.btn {
  color: #FFFFFF;
  background-color: #337AB7;
  border-color: #2E6DA4;
}

.btn:hover,
.btn:focus,
.btn:active,
.btn.active,
.open .dropdown-toggle.btn {
  color: #FFFFFF;
  background-color: #337AB7;
  border-color: #2E6DA4;
}

.btn:active,
.btn.active,
.open .dropdown-toggle.btn {
  background-image: none;
}

.btn-lg {
    padding: 10px 16px;
    font-size: 18px;
    line-height: 1.33;
    border-radius: 6px;
}
.btn.disabled,
.btn[disabled],
fieldset[disabled] .btn,
.btn.disabled:hover,
.btn[disabled]:hover,
fieldset[disabled] .btn:hover,
.btn.disabled:focus,
.btn[disabled]:focus,
fieldset[disabled] .btn:focus,
.btn.disabled:active,
.btn[disabled]:active,
fieldset[disabled] .btn:active,
.btn.disabled.active,
.btn[disabled].active,
fieldset[disabled] .btn.active {
  background-color: #337AB7;
  border-color: #2E6DA4;
}

.btn .badge {
  color: #337AB7;
  background-color: #FFFFFF;
}
</style>

<% if @message.message? %>
  <h2><%= @message.title %></h2>
  <%= @message.content.html_safe %>
<% elsif @message.rappel? %>
  <p><%= @message.title %></p>
<% end %>
<br>

<% if @message.formdata.present? and @message.formdata != "[]"%>
  <table style="background-color: #337ab7; color: #fff; max-width: 400px; padding: 20px 5px; border: 1px solid #2e6da4; width: 100%;">
    <tbody>
      <tr>
        <td style="text-align:center">
          <%= link_to "Remplir le formulaire", message_form_url(@message.muuid, Base64.strict_encode64()), class: 'btn btn-lg' %>
        </td>
      </tr>
    </tbody>
  </table>
<% end %>

<br>
<br>

<% if @message.photos.any? %>
  <% @message.photos.each do |photo| %>
    <span style="padding: 10px">
      <a href="<%= cloudinary_url(photo.path, crop: :limit, width: 1024) %>" target="_blank">
        <%= cl_image_tag(photo.path, :width => 150, :height => 150, :crop => :fill) %>
      </a>
  </span>
  <% end %>
<% end %>

<br>
<br>
<hr>
<table>
  <tbody>
    <tr>
      <td></td>
      <td>
        <% unless @message.author.fullname.nil? %><%= @message.author.fullname %><br><% end %>
        <% unless @message.school.name.nil? %><%= @message.school.name %><br><% end %>
        <% unless @message.author.function.nil? %><%= @message.author.function %><br><% end %>
        <% unless @message.school.address.nil? %><%= @message.school.address %><br><% end %>
        <% unless @message.school.phone.nil? %><%= @message.school.phone %><br><% end %>
        <% unless @message.author.email.nil? %><a href="mailto:<%= @message.author.email %>"><%= @message.author.email %></a><br><% end %>
        <% unless @message.school.url.nil? %><a href="<%= @message.school.url %>" target="_blank"><%= @message.school.url %></a><br><% end %>
      </td>
    </tr>
  </tbody>
</table>
