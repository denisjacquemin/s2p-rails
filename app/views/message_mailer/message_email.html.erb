<style>
.btn {
  color: #FFFFFF;
  background-color: #337AB7;
  border-color: #2E6DA4;
}

.btn:hover,
.btn:focus,
.btn:active,
.btn.active,
.open .dropdown-toggle.btn {
  color: #FFFFFF;
  background-color: #337AB7;
  border-color: #2E6DA4;
}

.btn:active,
.btn.active,
.open .dropdown-toggle.btn {
  background-image: none;
}

.btn-lg {
    padding: 10px 16px;
    font-size: 18px;
    line-height: 1.33;
    border-radius: 6px;
}
.btn.disabled,
.btn[disabled],
fieldset[disabled] .btn,
.btn.disabled:hover,
.btn[disabled]:hover,
fieldset[disabled] .btn:hover,
.btn.disabled:focus,
.btn[disabled]:focus,
fieldset[disabled] .btn:focus,
.btn.disabled:active,
.btn[disabled]:active,
fieldset[disabled] .btn:active,
.btn.disabled.active,
.btn[disabled].active,
fieldset[disabled] .btn.active {
  background-color: #337AB7;
  border-color: #2E6DA4;
}

.btn .badge {
  color: #337AB7;
  background-color: #FFFFFF;
}

  .photos a {
    border: none;
    text-decoration: none;
    margin: 5px;
  }
  .photos  a:hover {
    text-decoration: none;
  }

  .photos img:hover {
    border: solid 1px blue;
  }

  .photos img {
    border: solid 1px #ccc;
  }
</style>

<% if @message.message? %>
  <h2><%= @message.title %></h2>
  <%= @message.content.html_safe %>
<% elsif @message.rappel? %>
  <p><%= @message.title %></p>
<% end %>
<br>

<% if @message.formdata.present? and @message.formdata != "[]"%>
  <table style="background-color: #337ab7; color: #fff; max-width: 400px; padding: 20px 5px; border: 1px solid #2e6da4; width: 100%;">
    <tbody>
      <tr>
        <td style="text-align:center">
          <%= link_to "Remplir le formulaire", message_form_url(@message.muuid), class: 'btn btn-lg' %>
        </td>
      </tr>
    </tbody>
  </table>
<% end %>

<br>
<br>
<div class="photos">
  <% if @message.photos.any? %>
    <% @message.photos.each do |photo| %>
      <%
        overlay_file_format = 'image'
        overlay_file_format = 'pdf' if photo.format == 'pdf'
      %>
      <a href="<%= cloudinary_url(photo.path, crop: :limit, width: 1024) %>" target="_blank">
        <%= cl_image_tag(photo.path.gsub(/pdf$/, 'png'), :transformation=>[
            {:width => 150, :height => 150, :crop => :fill},
            {:overlay=>"black_bar", :width=>1.0, :height=>0.17, :flags=>"relative", :gravity=>"south", :opacity=>50},
            {:overlay=>overlay_file_format, :gravity=>"south_west", :x=>10, :y=>5},
            {:overlay=>"text:Arial_10O:#{photo.public_id}", :gravity=>"south_west", :y=>7, :x=>32, :color=>"#eee", :flags => 'no_overflow'}
              ]) %>
      </a>
    <% end %>
  <% end %>
</div>

<br>
<br>
<hr>
<table>
  <tbody>
    <tr>
      <td></td>
      <td>
        <% unless @message.author.fullname.nil? %><%= @message.author.fullname %><br><% end %>
        <% unless @message.school.name.nil? %><%= @message.school.name %><br><% end %>
        <% unless @message.author.function.nil? %><%= @message.author.function %><br><% end %>
        <% unless @message.school.address.nil? %><%= @message.school.address %><br><% end %>
        <% unless @message.school.phone.nil? %><%= @message.school.phone %><br><% end %>
        <% unless @message.author.email_reply_to.nil? %><a href="mailto:<%= @message.author.email_reply_to %>"><%= @message.author.email_reply_to %></a><br><% end %>
        <% unless @message.school.url.nil? %><a href="<%= @message.school.url %>" target="_blank"><%= @message.school.url %></a><br><% end %>
      </td>
    </tr>
  </tbody>
</table>
