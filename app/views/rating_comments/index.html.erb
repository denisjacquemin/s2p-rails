<h1>Rating Comments</h1>

<table class="responsive nowrap table table-hover" id="dttb-rating_comments" data-sort="true" data-source="<%= url_for(format: :json)%>">
  <thead>
    <tr>
      <th data-data="title">Title</th>
      <th data-data="comment">Comment</th>
      <th data-data="school_id">School</th>
      <th data-data="order">Order</th>
      <th data-data="url" data-orderable="false" data-class-name="all" data-searchable="false" class="skip-export" width="100px"></th>
    </tr>
  </thead>

</table>

<br>

<%= link_to 'New Rating Comment', new_rating_comment_path %>