<h1>Rating Years</h1>

<table class="responsive nowrap table table-hover" id="dttb-rating_years" data-sort="true" data-source="<%= url_for(format: :json)%>">
  <thead>
    <tr>
      <th data-data="name">Name</th>
      <th data-data="order">Order</th>
      <th data-data="active">Active</th>
      <th data-data="url" data-orderable="false" data-class-name="all" data-searchable="false" class="skip-export" width="100px"></th>
    </tr>
  </thead>

</table>

<br>

<%= link_to 'New Rating Year', new_rating_year_path %>