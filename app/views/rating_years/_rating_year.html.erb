<tr data-id="<%= rating_year.id %>">
    <td><i class="fa fa-arrows-alt handle"></i></td>
    <td><%= link_to rating_year.name, edit_rating_year_path(rating_year), remote: true %></td>
    <td align="right">
        <%= link_to 'Edit', edit_rating_year_path(rating_year), class: 'btn btn-default btn-xs', remote: true %>
        &nbsp;
        <%= link_to 'Supprimer',  rating_year, method: :delete, data: { confirm: 'Etes vous sûr' }, class: 'btn btn-danger btn-xs', remote: true %>
    </td>
</tr>