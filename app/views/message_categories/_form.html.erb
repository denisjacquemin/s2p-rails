<%= form_for(message_category) do |f| %>
  <% if message_category.errors.any? %>
    <div id="error_explanation">
      <h2><%= pluralize(message_category.errors.count, "error") %> prohibited this message_category from being saved:</h2>

      <ul>
      <% message_category.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
      </ul>
    </div>
  <% end %>

  <div class="row">
    <div class="col-xs-12 col-sm-12 col-md-12 col-lg-12">
      <div class="pull-right"><%= f.submit 'Enregistrer', class: 'btn btn-primary', data: { disable_with: "Enregistrement..." } %></div>
    </div>
  </div>
  <div class="row">
    <div class="col-xs-12 col-sm-12 col-md-12 col-lg-12">
      <div class="form-group">
        <%= f.label :name, 'Nom de la catégorie' %>
        <%= f.text_field :name, class: "form-control" %>
      </div>
    </div>
  </div>
<% end %>
