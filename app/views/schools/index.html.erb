<h1>Ecoles
  <div class="pull-right">
    <%= link_to 'New School', new_school_path, class: 'btn btn-primary' %>
  </div>
</h1>
<hr />
<div class="row">
    <div class="col-xs-12 col-sm-12 col-md-12 col-lg-12">
      <table class="table table-striped table-hover">
        <thead>
          <tr>
            <th>Name</th>
            <th>Phone</th>
            <th>Email</th>
            <th colspan="3"></th>
          </tr>
        </thead>

        <tbody>
          <% @schools.each do |school| %>
            <tr>
              <td><%= school.name %></td>
              <td><%= school.phone %></td>
              <td><%= school.email %></td>
              <td><%= link_to 'Show', school %></td>
              <td><%= link_to t('views.global.edit'), edit_school_path(school) %></td>
              <td><%= link_to t('views.global.destroy'), school, method: :delete, data: { confirm: t('views.global.areyousure') } %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
</div>
<br>
