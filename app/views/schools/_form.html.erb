

  <div class="panel panel-default" id="settings_tabs">
    <div class="panel-heading">
      <ul class="nav nav-pills">
        <li role="presentation" class="active"><a href="#general">Général</a></li>
        <li role="presentation"><a href="#logo">Logo</a></li>
        <% if school.billing_enable? %>
          <li role="presentation"><a href="#billing">Facturation</a></li>
        <% end %>
      </ul>

      <div class="panel-body ">
        <div class="tab-content">
          <div role="tabpanel" class="tab-pane fade in active" id="general">
            <%= form_for(school) do |f| %>
              <% if school.errors.any? %>
                <div id="error_explanation">
                  <h2><%= pluralize(school.errors.count, "erreur") %> empêche l'enregistrement de cette école:</h2>

                  <ul>
                  <% school.errors.full_messages.each do |message| %>
                    <li><%= message %></li>
                  <% end %>
                  </ul>
                </div>
              <% end %>
              <div class="form-group">
                <%= f.label :name, 'Nom' %>
                <%= f.text_field :name, class: 'form-control' %>
              </div>

              <div class="form-group">
                <%= f.label :address, 'Adresse' %>
                <%= f.text_field :address, class: 'form-control' %>
              </div>

              <div class="form-group">
                <%= f.label :phone, 'Téléphone' %>
                <%= f.text_field :phone, class: 'form-control' %>
              </div>

              <div class="form-group">
                <%= f.label :url, 'Site Internet' %>
                <%= f.text_field :url, class: 'form-control' %>
              </div>

              <div class="form-group">
                <%= f.label :sms_provision, 'Provision SMS' %>
                <p>Votre provision SMS est de <%= current_school.sms_provision %>. <a href="/help/message_sms">Comment réapprovisionner?</a></p>
                <% if current_user.superadmin? %>
                  <%= f.text_field :sms_provision, class: 'form-control' %>
                <% end %>
              </div>

              <% if current_user.superadmin? %>
                <div class="form-group">
                 <%= f.label :activate_message_date_limit, 'Activer message date limit' %>
                 <%= f.check_box :activate_message_date_limit %>
                </div>
                <div class="form-group">

                 <%= f.label :message_day_limit, 'Jour' %>
                 <%= f.text_field :message_day_limit, class: 'form-control' %>
                 <%= f.label :message_month_limit, 'Mois' %>
                 <%= f.text_field :message_month_limit, class: 'form-control' %>
                </div>
                <div class="form-group">
                 <%= f.label :billing_enable, 'Facturation Enable' %>
                 <%= f.check_box :billing_enable %>
                </div>
                <div class="form-group">
                 <%= f.label :payconiq_enable, 'Payconiq Enable' %>
                 <%= f.check_box :payconiq_enable %>
                </div>
                <div class="form-group">
                 <%= f.label :acaweb, 'Acaweb' %>
                 <%= f.check_box :acaweb %>
                </div>
                <div class="form-group">
                 <%= f.label :is_ifapme, 'Is Ifapme' %>
                 <%= f.check_box :is_ifapme %>
                </div>
                <div class="form-group">
                 <%= f.label :delete_students_on_csv_import, "Activer l'option effacer les élèves à l'import CSV" %>
                 <%= f.check_box :delete_students_on_csv_import %>
                </div>
                <div class="form-group">
                 <%= f.label :iscity, 'Est une entité?' %>
                 <%= f.check_box :iscity %>
                </div>
                <div class="form-group">
                 <%= f.label :bulletin_enable, 'Bulletin Enable' %>
                 <%= f.check_box :bulletin_enable %>
                </div>
              <% end %>

              <div class="form-group">
               <%= f.label :validation_workflow_active, 'Validation par l\'administrateur avant envoi' %>
               <%= f.check_box :validation_workflow_active %>
              </div>
              
              <div class="form-group">
               <%= f.label :allow_translation, "Activer l'option de traduction des messages" %>
               <%= f.check_box :allow_translation %>
              </div>

              <div class="form-group">
               <%= f.label :send_code_title_template, "Titre d'email d'envoi des codes" %>
               <%= f.text_field :send_code_title_template, class: 'form-control' %>
              </div>

              <div class="form-group">
               <%= f.label :send_code_template, "Modèle d'email d'envoi des codes" %>
               <%= f.text_area :send_code_template, rows: 10, class: 'form-control' %>
              </div>
              <%= f.submit 'Sauver', class: 'btn btn-primary' %>

            <% end %>
          </div>
          <div role="tabpanel" class="tab-pane fade in" id="logo">
            <%= render 'form_file', school: school, s3_direct_post: @s3_direct_post %>
            <div class="logo">
              <%= render 'logo', school: school %>
            </div>
          </div>
          <% if school.billing_enable? %>
            <div role="tabpanel" class="tab-pane fade in" id="billing">
                <%= form_for(school) do |f| %>
                  <% if school.errors.any? %>
                    <div id="error_explanation">
                      <h2><%= pluralize(school.errors.count, "erreur") %> empêche l'enregistrement de cette école:</h2>

                      <ul>
                      <% school.errors.full_messages.each do |message| %>
                        <li><%= message %></li>
                      <% end %>
                      </ul>
                    </div>
                  <% end %>

                  <%= f.fields_for :accounts do |account_form| %>
                    <%= render 'account_fields', f: account_form %>
                    <br/>
                  <% end %>

                  <%= link_to_add_fields "Ajouter un Numéro de compte", f, :accounts %>
                  <%= f.submit 'Sauver', class: 'btn btn-primary' %>

                <% end %>
            </div>
          <% end %>
        </div>
      </div>

      <script>
      $('#settings_tabs a').click(function (e) {
        e.preventDefault()
        $(this).tab('show')
      })
      </script>
