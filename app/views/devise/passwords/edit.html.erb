<div class="row">
  <div class="col-xs-12 col-sm-12 col-md-12  col-lg-12">
    <h1><%= I18n.t('devise.passwords.edit.change_my_password') %></h1>
    <hr />
    <div class="row">
      <div class="col-xs-12 col-sm-7 col-md-6 col-lg-5">
        <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :put }) do |f| %>
          <%= f.hidden_field :reset_password_token %>

          <div class="form-group"
            <%= f.label :password, I18n.t('devise.passwords.edit.new_password') %><br />
            <% if @minimum_password_length %>
              <em>(<%= @minimum_password_length %> <%= I18n.t('devise.passwords.edit.minimum') %>)</em><br />
            <% end %>
            <%= f.password_field :password, autofocus: true, autocomplete: "off", class: "form-control" %>
          </div>

          <div class="form-group">
            <%= f.label :password_confirmation, I18n.t('devise.passwords.edit.confirm_new_password') %><br />
            <%= f.password_field :password_confirmation, autocomplete: "off", class: "form-control" %>
          </div>

          <div class="actions">
            <%= f.submit I18n.t('devise.passwords.edit.change_my_password'), class: 'btn btn-primary' %>
          </div>
        <% end %>
        <br />
        <%= render "devise/shared/links" %>
      </div>
    </div>
  </div>
</div>
