 
        <table class="table table-hover">
            <thead>	
                <tr>
                    <th class="firstname">Matière</th>	           
                    <% @periods.each do |period| %>	            
                        <th><%= period.name %></th>	            
                    <% end %>	            
                </tr>	
            </thead>

            <tbody>
               <tr>
                    <td class="firstname">Commentaires Période</td>
                    <% @periods.each do |period| %>	            
                        <td class="period-comment">
                            <% unless period.is_weight %>
                                <%
                                    has_a_period_comment = @student_comments.dig(period.id, :content).present? 
                                %>
                                <%= link_to rating_edit_period_comment_path(year_id: @current_rating_year.id, student_id: @student_selected_id, period_id: period.id), remote: true do%>
                                    <i class="fa fa-comment <%= 'has-a-comment' if has_a_period_comment %>"></i>
                                <% end %>
                            <% end %>
                        </td>	            
                    <% end %>
               </tr>

            <% @competencies.each do |competence| %>
                <tr>
                    <%  %>
                    <td class="firstname level<%= competence.level %> <%= 'totals' if competence.is_totals %>" <%= "colspan=#{@periods.count + 1}" if competence.title_only %> ><%= competence.name %></td>
                    <%
                        periodsList = @periods
                        periodsList = competence.periods.ordered unless competence.all_periods
                    %>

                    <% if !competence.title_only %>
                        <% @periods.each do |period| %>
                            <td>
                                <% if ((periodsList.include?(period) and !competence.title_only) or period.is_weight) %>
                                    <% rating_id = "#{competence.id}-#{period.id}"  %>
                                    <%
                                        has_a_comment = @student_ratings.dig(competence.id, period.id, :comment) 
                                    %>

                                    <div class="input-group input-group-sm">
                                        <% value = @student_ratings.dig(competence.id, period.id, :value) %>
                                        <% value = competence.weight if period.is_weight && value.nil? %>
                                        <% 
                                            data = {
                                                "s-id": @student_selected_id, 
                                                "p-id": period.id, 
                                                "c-id": competence.id, 
                                                "ry-id": @current_rating_year.id 
                                            }

                                            if (competence.show_emojis) 
                                                data["emoji-picker"] = true
                                                data[:emojis] = "0x1F44D,0x1F44E,0x1F44F,0x1F534,0x1F7E0,0x1F7E2,0x1F7E3,0x1F535,0x1F7E4"
                                            end
                                        %>
                                        <%= text_field_tag rating_id, value, autocomplete: "off", class: 'rating form-control' , data: data %>
                                            <% unless period.is_weight %>
                                            <div class="input-group-addon comment" data-r-id="<%= rating_id %>">
                                                <%= link_to rating_edit_comment_path(competency_id: competence.id, student_id: @student_selected_id, period_id: period.id), remote: true do%>
                                                    <i class="fa fa-comment <%= 'has-a-comment' if has_a_comment %>"></i>
                                                <% end %>
                                            </div>
                                        <% end %>
                                    </div>
                                <% end %>
                            </td>
                        <% end %>
                    <% end %>
                </tr>
            <% end %>
            </tbody>
        </table>
