<div class="table-responsive" id="ratings_table">
    <table class="table table-hover">
        <thead>
        <tr>
            <th class="firstname">Matière</th>
            <% @periods.each do |period| %>
            <th><%= period.name %></th>
            <% end %>
        </tr>
        </thead>
        <tbody>
            <% @competencies.each do |competence| %>
                <tr>
                    <td class="firstname"><%= competence.name %></td>
                    <% @periods.each do |period| %>
                        <td>
                            <% rating_id = "#{competence.id}-#{period.id}"  %>
                            <%
                                byebug 
                                has_a_comment = @student_ratings.dig(competence.id, period.id, :comment) 
                            %>

                            <div class="input-group input-group-sm">
                                <%= text_field_tag rating_id, @student_ratings.dig(competence.id, period.id, :value), class: 'rating form-control'%>
                                <div class="input-group-addon comment" data-r-id="<%= rating_id %>">
                                    <%= link_to rating_edit_comment_path(competency_id: competence.id, student_id: student_selected_id, period_id: period.id), remote: true do%>
                                        <i class="fa fa-comment <%= 'has-a-comment' if has_a_comment %>"></i>
                                    <% end %>
                                </div>
                            </div>
                        </td>
                    <% end %>
                </tr>
            <% end %>
        </tbody>
    </table>
</div>