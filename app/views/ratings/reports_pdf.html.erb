<!doctype html>
<html>

    <head>
        <meta http-equiv="Content-Type" content="text/html; charset=utf-8">
    </head>
    <body>
        
        <div id="body" class="container">
            
                <% student = @current_student
                   student_ratings = @student_ratings
                   periods = @periods
                   competencies = @competencies
                   period_comment = @period_comment
                %>
                <div class="alwaysbreak">
                    <div class="row">

                        <% i = 0 %>
                        <% while i < competencies.size %>
                            <% competence = competencies[i] %>
                                <% if competence.level == 1 %> 
                                <div id="ratings" class="tbl nobreak">
                                    <div class="thead row">
                                        <div class="cell left competency"></div>
                                        <% periods.each do |period| %>
                                            <% current_period = period.id == @period_selected.id %>
                                            <div class="cell center <%= 'active' if current_period %>"><%= period.name %></div>
                                        <% end %>
                                        <div class="comment cell center">Commentaire</div>
                                    </div>
                                <% end %>

                                <div class="tbody row <%= 'totals' if competence.is_totals %>">
                                    <div class="competency cell level<%= competence.level %>"><%= competence.name %></div>
                                    
                                    <% periods.each_with_index do |period, index| %>
                                        <% current_period = period.id == @period_selected.id %>

                                        <div class="cell center <%= 'active' if current_period %>">
                                            <% unless competence.title_only %>
                                                <% if index <= @period_selected.order %>
                                                    <% rating_id = "#{competence.id}-#{period.id}"  %>
                                                    <%
                                                        has_a_comment = student_ratings.dig(competence.id, period.id, :comment) 
                                                    %>
                                                    <%= student_ratings.dig(competence.id, period.id, :value) %>
                                                <% end %>
                                            <% end %>

                                        </div>
                                    <% end %>
                                    <div class="comment cell left"><% unless competence.title_only %><%= student_ratings.dig(competence.id, @period_selected.id, :comment) %><% end %></div>
                                </div>

                            <% i = i + 1 %>
                            <% if (competencies[i] and competencies[i].level == 1) or i == competencies.size%>
                            </div>
                            <% end %>

                        <% end %>
                    </div>
                    <div class="row">
                        <h1>Commentaires de la période</h1>
                       <%= period_comment&.content %>
                    </div>
                </div>
            
        </div>
    </body>
</html>