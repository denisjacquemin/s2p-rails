<div id="rating_screen">
    <%= hidden_field_tag 'current_school_id', current_school.id %>
    <%= hidden_field_tag 'current_rating_year', @current_rating_year&.id %>

    <div class="row">
        <div class="col-sm-12">
            <h1>Bulletins
            </h1>
            <hr />
        </div>
    </div>
    <%
=begin%>
    <p>But de l'ecran, permettre l'encodage et la visu des ratings pour des eleves par matiere</p>
    <p>Un prof de flamand veut encoder les points pour ses classes, donc il doit choissir la classe</p>
    <p>Un titulaire encode pour sa classe les points de toutes les matieres, donc il doit choisir une matiere</p>
    <p>Un titulaire ou un prof ou un directeur peut choisir un eleve et voir les points pour toutes les matieres</p>
    <p>Montrer les eleves pour une classe et </p>
    <p>Montrer les ratings pour une matiere (via le filtre matiere car un enseignant peut avoir plusieurs matieres)</p>
    <p>Pour chaque eleve montrer les cotes de chaque periode pour la matiere courante + commentaires</p>
    <%
=end%>
    <div class="row">
        <div class="col-sm-12 col-md-4">
            <%= form_tag(writers_access_path, id: 'current_rating_year', method: "get", remote: true, class: '') do %>
            <div class="form-group">
                <label>Année</label>
                <%= render 'years_options', years: @rating_years, current_selected_rating_year_id: @current_selected_rating_year_id %>
            </div>
            <% end %>
        </div>
        <div class="col-sm-12 col-md-4">
            <%= form_tag(writers_access_path, id: 'load_ratings_by_group', method: "get", remote: true, class: '') do %>
            <div class="form-group">
                <label>Classes</label>
                <%= render 'groups_options', groups: @groups, current_groups_id: nil %>
            </div>
            <% end %>
        </div>
        <div class="col-sm-12 col-md-4">
            <%= form_tag(writers_access_path, id: 'load_ratings_by_competency', method: "get", remote: true, class: '') do %>
            <div class="form-group">
                <label>Matières</label>
                <%
=begin%>
                <select name="selected_competency" id="selected_competency" class="form-control">
                    <% @competencies.each do |c| %>
                    <% if c.title_only %>
                    <optgroup label="<%= c.name %>">
                        <% else %>
                        <option value="<%= c.id %>"><%= c.name %></option>
                        <% end %>
                        <% end %>
                </select>
                <%
=end%>
                <%= render('competencies_options', competencies: @competencies, competency_selected_id: @competency_selected_id) %>
            </div>
            <% end %>
        </div>
    </div>
    <div class="row">
        <div class="col-sm-12">
            <div id="ratings_table">
                <%= render 'students' unless @competencies.blank? %>
            </div>
        </div>
    </div>
    <%= render '/application/right_modal' %>
</div>