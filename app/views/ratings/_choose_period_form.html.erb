<%= form_with url: ratings_reports_to_pdf_path, id: 'generate_reports_form' do |form| %>

  <div class="col-xs-12 col-sm-12 col-md-12 col-lg-12">
    <div class="row">
      <div class="form-group">
        <%= form.label :selected_period_id, 'Période'%>
        <%= select_tag "selected_period_id", options_from_collection_for_select(Period.by_school(current_school.id).ordered, "id", "name"), class: 'form-control' %>
      </div>
    </div>
  </div>

<% end %>