$('#modal .modal-body').html("<%= escape_javascript(render 'choose_period_form', competency: @competency) %>");
$('#modal .modal-title').html("Choisir la période");
$('#modal .submit').html("Générer les bulletins");
$('#modal .submit').click( function(e) {
    e.preventDefault
    $('#modal #modal-form').html("<%= escape_javascript(render 'generate_form_reports') %>");

    form = $('#generate_reports');
    $('<input>').attr({
        type: 'hidden',
        name: 'period',
        value: $('#selected_period_id').val()
    }).appendTo(form);
    $('input.scb:checked').appendTo(form);
    form.appendTo();
    form.submit();

});
$("#modal").modal('show');