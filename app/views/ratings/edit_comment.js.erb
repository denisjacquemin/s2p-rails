$('#myModal .modal-body').html("<%= escape_javascript(render 'edit_comment_form', rating: @rating) %>");
$('#myModal .modal-body textarea').trumbowyg({
    lang: 'fr',
    minimalLinks: true,
    semantic: false,
    btns: [
    ['strong', 'em', 'underline'],
    ['superscript', 'subscript'],
    ['removeformat']
    ],
    removeformatPasted: false,
    autogrow: true,
    allowTagsFromPaste: [
        'b',
        'i',
        's',
        'sub',
        'sup',
        'strikethrough',
    ]
});
$('#myModal #modalTitle').html("Mise à jour commentaire");
$("#myModal").modal('show');
