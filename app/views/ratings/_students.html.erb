<% @students.each do |student| %>
    <tr>
        <td><%= student.firstname %></td>
        <td><%= student.lastname %></td>
        <%
            student_ratings = @ratings[student.id] || {}
        %>
        <% @periods.each do |period| %>
            <td>
                <%= text_field_tag period.id, student_ratings[period.id], class: 'rating', data: {"s-id": student.id, "p-id": period.id }, width: '50px' %>
            </td>
        <% end %>
    </tr>
<% end %>
