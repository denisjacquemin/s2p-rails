$('#myModal .modal-body').html("<%= escape_javascript(render 'edit_period_comment_form', period_comment: @period_comment) %>");
$('#myModal #modalTitle').html("Edition commentaire");
$("#myModal").modal('show');
$('#myModal .modal-body textarea').trumbowyg({
    lang: 'fr',
    minimalLinks: true,
    semantic: false,
    btns: [
    ['strong', 'em', 'underline'],
    ['superscript', 'subscript'],
    ['removeformat']
    ],
    removeformatPasted: false,
    autogrow: true,
    allowTagsFromPaste: [
        'b',
        'i',
        's',
        'sub',
        'sup',
        'strikethrough',
    ]
});