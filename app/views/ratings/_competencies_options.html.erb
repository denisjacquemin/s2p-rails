<% if competencies.blank? %>
    <div id="selected_competency">Aucune Matières</div>
<% else %>
    <%= select_tag "selected_competency", 
        options_from_collection_for_select(competencies, "id", "name_with_indent", competency_selected_id), 
        class: 'form-control', 
        include_blank: 'Sélectionnez une matière' %>
<% end %>