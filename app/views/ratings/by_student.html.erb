<div id="by_student">
    <div class="row">
        <div class="col-xs-12 col-sm-7 col-md-7 col-lg-7">
            <h1>Encodage par élèves</h1>
        </div>
    </div>
    <div class="row">
        <div class="col-sm-12 col-md-6">
            <%= form_tag(writers_access_path, id: 'load_ratings_by_group', method: "get", remote: true, class: '') do %>
                <div class="form-group">
                    <label>Classes</label>
                    <%= select_tag "selected_group", options_from_collection_for_select(@groups, "id", "name", @group_selected_id), class: 'form-control' %>
                </div>
            <% end %>
        </div>
        <div class="col-sm-12 col-md-6">
            <%= form_tag(writers_access_path, id: 'load_ratings_by_group', method: "get", remote: true, class: '') do %>
                <div class="form-group">
                    <label>Elèves</label>
                    <%= select_tag "selected_student", options_from_collection_for_select(@students, "id", "fullname", @student_selected_id), class: 'form-control' %>
                </div>
            <% end %>
        </div>
    </div>
    <div class="row">
        <div class="col-sm-12">
            <div class="table-responsive" id="ratings_table">
                <table class="table table-hover">
                    <thead>
                    <tr>
                        <th class="firstname">Matière</th>
                        <% @periods.each do |period| %>
                        <th>
                            <%= form_for Rating, as: :post, url: ratings_report_to_pdf_path(format: :pdf, debuug: true), method: :post, html: { class: "report_to_pdf_form", target: '_blank', style: 'display:inline' } do |f| %>
                                <%= hidden_field_tag 'selected_student_id', {class: 'selected_student_id'} %>
                                <%= hidden_field_tag 'selected_group_id', {class: 'selected_group_id'} %>
                                <%= hidden_field_tag 'selected_period_id', period.id %>
                                <button type="submit" class='btn btn-primary btn-xs' id='codes_to_pdf_submit' rel="tooltip" data-toggle="tooltip" data-placement="bottom" title="Génération du bulletin PDF">
                                    <i class="fa fa-file-pdf" aria-hidden="true"></i>
                                </button>
                            <% end %>
                            <%= period.name %>
                        </th>
                        <% end %>
                    </tr>
                    </thead>
                    <%= render 'ratings_by_student', competencies: @competencies, periods: @periods, student_ratings: @student_ratings, student_selected_id: @student_selected_id %>
                </table>
            </div>
        </div>
    </div>
    <%= render 'edit_comment_modal' %>
</div>