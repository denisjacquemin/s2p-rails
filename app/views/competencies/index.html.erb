<%
=begin%>
  - Gerer la liste des matieres
  - Attribuer une matiere a un redacteur pour une annee
  - Attribuer une matiere a une Annee
<%
=end%>
<div class="row">
  <div class="col-md-12">
    <h1>Gestion Paramètres</h1>
    <hr />
  </div>
</div>

<div class="row" id="reports-param-screen">
  <div class="col-md-12">
    <ul class="nav nav-tabs" role="tablist">
      <li role="presentation" class="active"><a data-target="#home" aria-controls="home" role="tab" data-toggle="tab" >Liste des Matières et périodes</a></li>
      <li role="presentation"><a data-target="#writers_access" aria-controls="writers_access" role="tab" data-toggle="tab" data-url="<%= writers_access_path %>">Accès rédacteurs</a></li>
      <li role="presentation"><a data-target="#parameters" aria-controls="home" role="tab" data-toggle="tab" data-url="<%= reports_parameters_path %>">Paramètres divers</a></li>
    </ul>
    <div class="tab-content">
      <div role="tabpanel" class="tab-pane active" id="home">
        <div class="row">
          <div class="col-xs-12 col-sm-12 col-md-6 col-lg-6 top-buffer">
            <div class="row">
              <div class="col-sm-12">
                <div>
                  <%= link_to 'Nouvelle matière', new_competency_path, class: 'btn btn-primary fab visible-xs', remote: true %>
                </div>
                <div class="pull-right hidden-xs">
                  <% if current_user.superadmin? %>
                    <%= link_to 'Init Matières', init_competencies_path, class: 'btn btn-warning' %>
                  <% end %>
                  <%= link_to 'Nouvelle matière', new_competency_path, class: 'btn btn-primary', remote: true %>
                </div> 
              </div>
            </div>
            <div class="row">
              <div class="col-sm-12">
                <div class="table-responsive">
                  <table class="table-striped table table-hover">
                    <thead id="competencies_header">
                      <tr>
                        <th width="20px">&nbsp;</th>
                        <th data-data="name">Nom de la matière</th>
                        <th style="text-align:right;font-weight:normal" class="form-group-sm"><%= select_tag 'selected_group', options_from_collection_for_select(@groups, "id", "name", @selected_group), class: 'form-control'  %></th>
                      </tr>
                    </thead>
                    <tbody id="competencies">
                      <%= render partial: 'competency', collection: @competencies %>
                    </tbody>
                  </table>
                </div>
              </div>
            </div>   
          </div>
          <div class="col-xs-12 col-sm-12 col-md-6 col-lg-6 periods" >
            <div class="row">
              <div class="col-sm-12">
                <div><%= link_to 'Nouvelle colonne', new_period_path, class: 'btn btn-primary fab visible-xs', remote: true %></div>
                <div class="pull-right hidden-xs">
                  <%= link_to 'Nouvelle colonne', new_period_path, class: 'btn btn-primary', remote: true %>
                </div>
              </div>
            </div>
            <div class="row" id="periods">
              <div class="col-sm-12">
                <div class="table-responsive">
                  <table class="table-striped table table-hover">
                    <thead>
                      <tr>
                        <th width="20px">&nbsp;</th>
                        <th data-data="name">Colonnes (ex périodes)</th>
                        <th></th>
                      </tr>
                    </thead>
                    <tbody id="periods_rows">
                      <%= render partial: '/periods/period', collection: @periods %>
                    </tbody>
                  </table>
                </div>
              </div>
            </div>

            <% if current_user.superadmin? %>
              <div class="row">
                <div class="col-sm-12">
                  <div><%= link_to 'Nouvelle Année', new_rating_year_path, class: 'btn btn-primary fab visible-xs', remote: true %></div>
                  <div class="pull-right hidden-xs">
                    <%= link_to 'Nouvelle Année', new_rating_year_path, class: 'btn btn-primary', remote: true %>
                  </div>
                </div>
              </div>
              
              <div class="row" id="rating_years">
                <div class="col-sm-12">
                  <div class="table-responsive">
                    <table class="table-striped table table-hover">
                      <thead>
                        <tr>
                          <th data-data="name">Nom de l'année</th>
                          <th></th>
                        </tr>
                      </thead>
                      <tbody id="rating_years_rows">
                        <%= render partial: '/rating_years/rating_year', collection: @rating_years %>
                      </tbody>
                    </table>
                  </div>
                </div>
              </div>
            <% end %>
            
            
          </div>
        </div>

      </div>
      <div role="tabpanel" class="tab-pane" id="writers_access">
        <div class="row">
          <div class="col-xs-12 col-sm-12 col-md-6 col-lg-6 top-buffer">
            Chargement
          </div>
        </div>
      </div>
      <div role="tabpanel" class="tab-pane" id="parameters">
        <div class="row" >
          <div class="col-xs-12 col-sm-12 col-md-6 col-lg-6 top-buffer">
            Chargement
          </div>
        </div> 
      </div>
    </div>
  </div>
</div>


<%= render '/application/right_modal' %>

