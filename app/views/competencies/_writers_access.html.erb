<%
=begin%>
 Permettre de choisir pour prof spec le cours de neerlandais pour toutes les classes
 PErmettre pour un titulaire de choisir toutes les matieres pour une classe 
<%
=end%>

<div class="row top-buffer">
    <div class="col-xs-12 col-sm-6 col-md-5 style="">
        <div >
            <%= form_tag(writers_access_path, id: 'load_write_accesses', method: "get", remote: true, class: '') do %>
                <label>Rédacteur:</label>
                <%= select_tag "selected_user", options_from_collection_for_select(@users, "id", "fullname", @user_selected_id), class: 'form-control' %>
            <% end %>
        </div>
    </div>
</div>

<div class="row top-buffer">
    <div class="col-sm-12">
        <div class="table-responsive">
            <table class="table-striped table table-hover">
                <thead>
                    <tr>
                        <th data-data="name">Nom de la matière</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody id="competencies">
                    <%= render partial: 'competency_writer_access', collection: @competencies %>
                </tbody>
            </table>
        </div>
    </div>
</div>
